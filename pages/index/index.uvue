<template>
  <scroll-view class="page" scroll-y="true" show-scrollbar="false">
    <view class="page-content">
    <view class="top-row">
      <view>
        <text class="eyebrow">专注星伴</text>
        <text class="greeting">你好，{{ nickname }}</text>
      </view>
      <view class="avatar" @click="openSettings"><text class="avatar-value tap-content">{{ age }}</text></view>
    </view>

    <view class="hero-card">
      <view class="hero-copy">
        <text class="hero-kicker">今日训练</text>
        <text class="hero-title">{{ heroTitle }}</text>
        <text class="hero-meta">年龄仅用于首次难度 · 约 {{ sessionMinutes }} 分钟</text>
        <button class="tap-target start-button" @click="startTraining">{{ planButtonLabel }}</button>
      </view>
      <view class="hero-mascot-wrap"><image class="hero-mascot" src="/static/images/runtime/game-objects/kitten-yellow-card-v1.png" mode="aspectFit"></image></view>
    </view>

    <view class="plan-card">
      <view class="plan-head"><text class="plan-title">今日三段训练</text><text class="plan-progress">{{ completedPlanCount }}/3</text></view>
      <view v-for="(item, index) in dailyPlan" :key="item.gameId" class="plan-row" :class="item.completed ? 'plan-done' : ''">
        <view class="plan-index"><text class="plan-index-value">{{ item.completed ? '✓' : (index + 1).toString() }}</text></view>
        <view class="plan-copy"><text class="plan-role">{{ item.role }} · 难度 {{ item.difficultyLevel }}/10</text><text class="plan-game">{{ item.name }}</text></view>
        <text class="plan-state">{{ item.completed ? '已完成' : (index == nextPlanIndex ? '下一项' : '待完成') }}</text>
      </view>
    </view>

    <view class="section-header">
      <text class="section-title">五维专注力</text>
      <view class="tap-link" @click="openDimensions"><text class="section-link tap-content">查看全部</text></view>
    </view>
    <scroll-view class="dimension-scroll" scroll-x="true" show-scrollbar="false">
      <view class="dimension-row">
        <view v-for="item in dimensions" :key="item.id" class="dimension-card" @click="openDimensions">
          <view class="dimension-dot tap-content" :style="{ backgroundColor: item.color }"></view>
          <text class="dimension-name tap-content">{{ item.shortName }}</text>
          <text class="dimension-desc tap-content">{{ item.description }}</text>
        </view>
      </view>
    </scroll-view>

    <view class="section-header">
      <text class="section-title">本周成长</text>
      <view class="tap-link" @click="openReport"><text class="section-link tap-content">成长报告</text></view>
    </view>
    <view class="stats-card" @click="openReport">
      <view class="stat tap-content">
        <text class="stat-number">{{ weeklySessions }}</text>
        <text class="stat-label">本周训练</text>
      </view>
      <view class="divider tap-content"></view>
      <view class="stat tap-content">
        <text class="stat-number">{{ energy }}</text>
        <text class="stat-label">星星能量</text>
      </view>
      <view class="divider tap-content"></view>
      <view class="stat tap-content">
        <text class="stat-number">{{ streak }}</text>
        <text class="stat-label">连续天数</text>
      </view>
    </view>

    <view class="notice">
      <view class="notice-icon"><text class="notice-icon-value">i</text></view>
      <text class="notice-text">训练用于日常能力练习，不替代专业评估或医疗诊断。</text>
    </view>
    <view class="mascot-message">
      <image class="message-mascot" src="/static/images/runtime/game-objects/bunny-blue-card-v1.png" mode="aspectFit"></image>
      <view class="message-copy"><text class="message-name">蓝蓝的观察提示</text><text class="message-text">慢一点、看清楚，再做选择。稳定专注比追求速度更重要。</text></view>
    </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { DIMENSIONS, getAgeBand, getGameRoute } from '../../utils/catalog.uts'
import { getProfile, getRecords, getWeeklyRecords, calculateStreak } from '../../utils/storage.uts'
import { DailyPlanItem, buildDailyPlan, nextPendingPlanItem } from '../../utils/training-plan.uts'

const dimensions = DIMENSIONS
const nickname = ref('探索家')
const age = ref(8)
const sessionMinutes = ref(10)
const weeklySessions = ref(0)
const energy = ref(0)
const streak = ref(0)
const dailyPlan = ref([] as DailyPlanItem[])
const completedPlanCount = computed((): number => dailyPlan.value.filter((item: DailyPlanItem): boolean => item.completed).length)
const nextPlanIndex = computed((): number => dailyPlan.value.findIndex((item: DailyPlanItem): boolean => !item.completed))
const heroTitle = computed((): string => completedPlanCount.value == 3 ? '今日计划已完成' : completedPlanCount.value > 0 ? '继续今日的小挑战' : '从一次小挑战开始')
const planButtonLabel = computed((): string => completedPlanCount.value == 3 ? '今日已完成' : completedPlanCount.value > 0 ? '继续训练' : '开始训练')

function refresh() {
  const profile = getProfile()
  if (profile == null) {
    uni.redirectTo({ url: '/pages/profile/profile' })
    return
  }
  nickname.value = profile.nickname
  age.value = profile.age
  const band = getAgeBand(profile.age)
  sessionMinutes.value = band.sessionMinutes
  const records = getRecords()
  dailyPlan.value = buildDailyPlan(profile.age, records, Date.now())
  weeklySessions.value = getWeeklyRecords(records).length
  energy.value = records.reduce((total: number, item): number => total + item.score, 0)
  streak.value = calculateStreak(records)
}

onShow(() => refresh())

function startTraining() {
  const next = nextPendingPlanItem(dailyPlan.value)
  if (next == null) { uni.showToast({ title: '今日计划已完成', icon: 'success' }); return }
  uni.navigateTo({ url: getGameRoute(next.gameId) })
}
function openDimensions() { uni.navigateTo({ url: '/pages/dimensions/dimensions' }) }
function openReport() { uni.navigateTo({ url: '/pages/report/report' }) }
function openSettings() { uni.navigateTo({ url: '/pages/settings/settings' }) }
</script>

<style>
.page { height: 100%; }
.page-content { padding: 50px 20px 32px; }
.top-row { flex-direction: row; justify-content: space-between; align-items: center; }
.eyebrow { color: #5b8def; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
.greeting { margin-top: 5px; color: #1f2a44; font-size: 25px; font-weight: 700; }
.avatar { width: 48px; height: 48px; border-radius: 24px; background-color: #eaf0ff; align-items: center; justify-content: center; }
.avatar-value { color: #5b8def; font-size: 16px; font-weight: 700; }
.hero-card { margin-top: 25px; padding: 24px; min-height: 190px; border-radius: 26px; background-color: #5b8def; flex-direction: row; overflow: hidden; }
.hero-copy { flex: 1; z-index: 2; }
.hero-kicker { color: #dce7ff; font-size: 13px; }
.hero-title { margin-top: 8px; color: #ffffff; font-size: 23px; font-weight: 700; }
.hero-meta { margin-top: 9px; color: #e7eeff; font-size: 13px; }
.start-button { margin: 22px 0 0; width: 132px; height: 48px; line-height: 48px; padding: 0; border-radius: 14px; background-color: #ffffff; color: #416fc7; font-size: 14px; font-weight: 700; }
.hero-mascot-wrap { margin: 13px -18px -20px 8px; width: 126px; height: 160px; border-radius: 63px; background-color: #ffffff; align-items: center; justify-content: center; overflow: hidden; }
.hero-mascot { width: 122px; height: 154px; }
.plan-card { margin-top: 16px; padding: 18px; border-radius: 20px; background-color: #ffffff; }.plan-head { margin-bottom: 7px; flex-direction: row; align-items: center; justify-content: space-between; }.plan-title { color: #28344f; font-size: 16px; font-weight: 700; }.plan-progress { color: #5b8def; font-size: 13px; font-weight: 700; }.plan-row { min-height: 55px; border-top: 1px solid #edf0f5; flex-direction: row; align-items: center; }.plan-index { width: 30px; height: 30px; border-radius: 15px; background-color: #eaf0ff; align-items: center; justify-content: center; }.plan-index-value { color: #5b8def; font-size: 12px; font-weight: 700; }.plan-copy { margin-left: 10px; flex: 1; }.plan-role { color: #8791a5; font-size: 10px; }.plan-game { margin-top: 2px; color: #344059; font-size: 13px; font-weight: 700; }.plan-state { color: #8b94a7; font-size: 11px; }.plan-done { opacity: 0.62; }
.section-header { margin-top: 28px; flex-direction: row; align-items: center; justify-content: space-between; }
.section-title { color: #1f2a44; font-size: 18px; font-weight: 700; }
.section-link { color: #5b8def; font-size: 13px; }
.dimension-scroll { margin-top: 14px; width: 100%; }
.dimension-row { flex-direction: row; width: 700px; }
.dimension-card { margin-right: 12px; width: 124px; min-height: 122px; padding: 15px; border-radius: 18px; background-color: #ffffff; }
.dimension-dot { width: 12px; height: 12px; border-radius: 6px; }
.dimension-name { margin-top: 12px; color: #28344f; font-size: 16px; font-weight: 700; }
.dimension-desc { margin-top: 6px; color: #7a849b; font-size: 11px; line-height: 16px; }
.stats-card { margin-top: 14px; padding: 20px 8px; border-radius: 20px; background-color: #ffffff; flex-direction: row; align-items: center; justify-content: space-around; }
.stat { flex: 1; align-items: center; }
.stat-number { color: #1f2a44; font-size: 24px; font-weight: 700; }
.stat-label { margin-top: 5px; color: #7a849b; font-size: 11px; }
.divider { width: 1px; height: 34px; background-color: #e8ecf3; }
.notice { margin-top: 20px; padding: 13px; border-radius: 14px; background-color: #eef3fb; flex-direction: row; align-items: center; }
.notice-icon { width: 22px; height: 22px; border-radius: 11px; background-color: #dbe6f8; align-items: center; justify-content: center; }
.notice-icon-value { color: #5b8def; font-size: 12px; font-weight: 700; }
.notice-text { margin-left: 9px; flex: 1; color: #6d7890; font-size: 11px; line-height: 16px; }
.mascot-message { margin-top: 16px; padding: 12px 15px 12px 8px; border-radius: 20px; background-color: #ffffff; flex-direction: row; align-items: center; }
.message-mascot { width: 72px; height: 72px; border-radius: 36px; }
.message-copy { margin-left: 9px; flex: 1; }
.message-name { color: #4c73c2; font-size: 12px; font-weight: 700; }
.message-text { margin-top: 4px; color: #6f7a91; font-size: 11px; line-height: 17px; }
</style>
