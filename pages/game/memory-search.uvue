.ms-good { color: #338e72; font-size: 13px; font-weight: 700; }
.ms-again { color: #c65b66; font-size: 13px; font-weight: 700; }
.ms-hint { color: #6d7789; font-size: 13px; }
.ms-stats { margin-top: 8px; width: 100%; padding: 10px 6px; border-radius: 18px; background-color: rgba(255, 255, 255, 0.94); flex-direction: row; }
.ms-stat { flex: 1; align-items: center; }
.ms-stat-value { color: #27324a; font-size: 17px; font-weight: 700; }
.ms-stat-label { margin-top: 3px; color: #8a93a7; font-size: 10px; }

