<template>
<TrainingFrame :difficulty="level" :preparing="state != 'running' && state != 'paused'" title="小鸟穿云" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
  <view class="page">
    <image class="cloud-background tap-content" src="/static/images/runtime/backgrounds/shadow-match-sky-v1.webp" mode="aspectFill"></image>
    <view class="content">
      <view class="header">
        <view><text class="dimension">反应控制训练</text><text class="title">小鸟穿云</text></view>
        <button v-if="state == 'demo'" class="skip-button training-preview-primary" @click="begin">开始训练</button>
      </view>
      <view class="progress"><view class="progress-fill" :style="{ width: progressWidth }"></view></view>
      <view id="bird-sky" class="sky" @click="flap">
        <view class="gate tap-content" :style="{ left: gateX + '%' }">
          <view class="cloud-wall cloud-top" :style="{ height: topWallHeight }"><view class="cloud-shine"></view><text class="cloud-mark">☁</text></view>
          <view class="gap-outline" :style="{ top: gapTop, height: gapHeight }"></view>
          <view class="cloud-wall cloud-bottom" :style="{ height: bottomWallHeight }"><text class="cloud-mark">☁</text><view class="cloud-shine"></view></view>
        </view>
        <view class="bird-wrap tap-content" :style="{ top: state == 'ready' || state == 'demo-done' ? '8%' : birdTop, left: state == 'ready' || state == 'demo-done' ? '42%' : '18px', transform: 'rotate(' + bodyAngle + 'deg)' }">
          <image class="bird" src="/static/images/runtime/game-characters/tap-bird-body-v2.webp" mode="aspectFit" @load="bodyReady = true" @error="loadFailed = true"></image>
          <image class="bird-wing" :style="{ transform: wingTransform }" src="/static/images/runtime/game-characters/tap-bird-wing-v2.webp" mode="aspectFit" @load="wingReady = true" @error="loadFailed = true"></image>
        </view>
        <text v-if="feedback != ''" class="feedback tap-content" :class="feedbackGood ? 'good' : 'again'">{{ feedback }}</text>
        <view v-if="state == 'ready' || state == 'demo-done'" class="instruction training-preview-card" @click.stop="ignoreTap">
          <text class="instruction-title">{{ state == 'demo-done' ? '试过啦，出发吧' : '点一下，飞起来' }}</text>
          <text v-if="loadFailed" class="hint">小鸟还没准备好，请返回重试</text>
          <button class="primary training-preview-primary" :disabled="!birdReady || loadFailed" @click.stop="begin">{{ birdReady ? '开始训练' : '准备中…' }}</button>
          <text v-if="birdReady && !loadFailed" class="replay training-preview-secondary" @click.stop="startDemo">{{ state == 'demo-done' ? '再试一次' : '先试玩' }}</text>
        </view>
      </view>
      <button class="flap-button" :disabled="state != 'running' && state != 'demo'" @click="flap">↑ 向上飞</button>
      <view class="stats">
        <text class="stat">{{ state == 'demo' ? '试玩不计成绩' : '通过 ' + passed + ' / ' + config.rounds }}</text>
        <text v-if="state == 'running' || state == 'paused'" class="stat">碰云 {{ hits }}</text>
        <text v-else class="stat">从云朵中间穿过</text>
      </view>
    </view>
  </view>
</TrainingFrame>
</template>

<script setup lang="uts">
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import { ref, computed, nextTick } from 'vue'
import { onLoad, onReady, onHide, onUnload, onResize } from '@dcloudio/uni-app'
import { getGameDifficulty } from '../../utils/difficulty.uts'
import { BirdConfig, getBirdConfig, nextBirdGap } from '../../utils/bird-cloud.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating


const GAME_HEIGHT = 390, BIRD_SIZE = 66, BIRD_LEFT = 18, GATE_WIDTH = 82
const level = ref(1), config = ref<BirdConfig>(getBirdConfig(1)), state = ref('ready')
const roundIndex = ref(0), passed = ref(0), hits = ref(0), elapsed = ref(0)
const birdY = ref(162), birdVelocity = ref(0), gateX = ref(105), gapCenter = ref(195), gateResolved = ref(false)
const feedback = ref(''), feedbackGood = ref(true), bodyReady = ref(false), wingReady = ref(false), loadFailed = ref(false)
const birdReady = computed((): boolean => bodyReady.value && wingReady.value)
const bodyAngle = ref(0), wingAngle = ref(-12), wingScale = ref(1)
let lastFlapAt = -1000
const wingTransform = computed((): string => 'rotate(' + wingAngle.value + 'deg) scaleY(' + wingScale.value + ')')
let gameTimer = 0, lastTick = 0, accumulator = 0, feedbackUntil = 0, skyWidth = 340
let resumeState = 'running'
const progressWidth = computed((): string => state.value == 'demo' || state.value == 'demo-done' ? '0%' : Math.round(roundIndex.value / config.value.rounds * 100) + '%')
const birdTop = computed((): string => birdY.value / GAME_HEIGHT * 100 + '%')
const gapTop = computed((): string => (gapCenter.value - config.value.gap / 2) / GAME_HEIGHT * 100 + '%')
const gapHeight = computed((): string => config.value.gap / GAME_HEIGHT * 100 + '%')
const topWallHeight = computed((): string => (gapCenter.value - config.value.gap / 2) / GAME_HEIGHT * 100 + '%')
const bottomWallHeight = computed((): string => (GAME_HEIGHT - gapCenter.value - config.value.gap / 2) / GAME_HEIGHT * 100 + '%')

function ignoreTap() { if (trainingPaused.value) return;}
function stopTimer() { if (gameTimer != 0) trainingClock.clearInterval(gameTimer); gameTimer = 0 }
function measureSky() {
  const sky = uni.getElementById('bird-sky')
  if (sky != null) { const rect = sky.getBoundingClientRect(); if (rect.width > 0) skyWidth = rect.width }
}
function finish() {
  if (state.value != 'running') return
  state.value = 'finished'; stopTimer()
  const accuracy = Math.round(passed.value / Math.max(1, config.value.rounds) * 100)
  uni.redirectTo({ url: '/pages/result/result?gameId=bird-cloud&dimensionId=sustained&score=' + accuracy + '&accuracy=' + accuracy + '&reaction=0&duration=' + Math.max(1, Math.round(elapsed.value / 1000)) + '&omissions=' + hits.value + '&completed=' + passed.value + '&total=' + config.value.rounds })
}
function resetGate() {
  gateX.value = 105; gateResolved.value = false
  gapCenter.value = nextBirdGap(gapCenter.value, config.value, Math.random())
}
function resolveGate() {
  if (gateResolved.value) return
  gateResolved.value = true
  const center = birdY.value + BIRD_SIZE / 2
  const safe = center >= gapCenter.value - config.value.gap / 2 + 8 && center <= gapCenter.value + config.value.gap / 2 - 8
  feedbackGood.value = safe; feedback.value = safe ? '穿过去啦！' : '碰到云啦'
  feedbackUntil = elapsed.value + 700
  if (state.value == 'demo') {
    state.value = 'demo-done'; stopTimer(); return
  }
  if (safe) { passed.value += 1; training.playFeedback('correct') }
  else { hits.value += 1; training.playFeedback('wrong') }
  roundIndex.value += 1
  if (roundIndex.value >= config.value.rounds) finish()
}
function animateBird() {
  // 与物理共用活动时钟：暂停停翅；点击一次明显下拍，再柔和收回。
  const sinceTap = elapsed.value - lastFlapAt
  const stroke = sinceTap < 320 ? Math.sin(Math.max(0, sinceTap) / 320 * Math.PI) : 0
  const idle = Math.sin(elapsed.value / 520 * Math.PI * 2)
  wingAngle.value = -12 + idle * 14 + stroke * 66
  wingScale.value = 0.92 - stroke * 0.24 + idle * 0.08
  const target = Math.max(-14, Math.min(12, birdVelocity.value * 2))
  bodyAngle.value += (target - bodyAngle.value) * 0.22
}
function step() {
  if (state.value != 'running' && state.value != 'demo') return
  elapsed.value += 32
  // 保留点击上升/松手下落的原玩法；重力与点击力度各级一致，避免换级后手感突变。
  birdVelocity.value = Math.min(7.2, birdVelocity.value + 0.38)
  birdY.value += birdVelocity.value
  if (birdY.value < 0) { birdY.value = 0; birdVelocity.value = 0.4 }
  if (birdY.value > GAME_HEIGHT - BIRD_SIZE) { birdY.value = GAME_HEIGHT - BIRD_SIZE; birdVelocity.value = -2.4 }
  animateBird()
  gateX.value -= config.value.speed
  // 云门中心与小鸟中心真正对齐时判断，替代旧的固定 27% 提前判定。
  const crossing = (BIRD_LEFT + BIRD_SIZE / 2 - GATE_WIDTH / 2) / skyWidth * 100
  if (!gateResolved.value && gateX.value <= crossing) resolveGate()
  if (gateX.value <= -GATE_WIDTH / skyWidth * 100 - 2 && state.value == 'running') resetGate()
  if (elapsed.value >= feedbackUntil) feedback.value = ''
}
function tick() {
  const now = trainingClock.now(), delta = now - lastTick; lastTick = now
  if (delta > 250) { training.pause(); return }
  accumulator += Math.max(0, delta)
  while (accumulator >= 32 && (state.value == 'running' || state.value == 'demo')) { accumulator -= 32; step() }
}
function startTimer() { stopTimer(); nextTick(() => measureSky()); lastTick = trainingClock.now(); gameTimer = trainingClock.setInterval(() => tick(), 32) }
function resetRun() {
  stopTimer(); roundIndex.value = 0; passed.value = 0; hits.value = 0; elapsed.value = 0; accumulator = 0
  birdY.value = 162; birdVelocity.value = 0; gapCenter.value = 195; gateX.value = 105; gateResolved.value = false
  feedback.value = ''; feedbackUntil = 0
  bodyAngle.value = 0; wingAngle.value = -12; wingScale.value = 1; lastFlapAt = -1000
}
function startDemo() { if (trainingPaused.value) return;
  if (!birdReady.value || loadFailed.value || (state.value != 'ready' && state.value != 'demo-done')) return
  resetRun(); config.value = getBirdConfig(1); state.value = 'demo'; startTimer()
}
function begin() { if (trainingPaused.value) return;
  if (!birdReady.value || loadFailed.value || (state.value != 'ready' && state.value != 'demo' && state.value != 'demo-done')) return
  resetRun(); config.value = getBirdConfig(level.value); state.value = 'running'; startTimer()
}
function flap() { if (trainingPaused.value) return;
  if (state.value != 'running' && state.value != 'demo') return
  birdVelocity.value = -6.1; lastFlapAt = elapsed.value
}
function pauseGame() { training.pause() }
function resumeGame() { training.resume() }
function exitGame() { stopTimer(); state.value = 'finished'; uni.navigateBack() }
onLoad(() => { level.value = getGameDifficulty('bird-cloud'); config.value = getBirdConfig(level.value) })
onReady(() => measureSky())
onResize(() => nextTick(() => measureSky()))
onUnload(() => stopTimer())
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => state.value == 'running' || state.value == 'finished')
</script>

<style>
.page { flex: 1; position: relative; background-color: #eaf6ff; }
.cloud-background { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.content { flex: 1; position: relative; padding: 18px 18px 22px; }
.header { flex-direction: row; justify-content: space-between; align-items: center; }
.dimension { color: #5982a1; font-size: 12px; font-weight: 700; }
.title { margin-top: 5px; color: #294c69; font-size: 23px; font-weight: 700; }
.pause-button { padding: 12px 14px; border-radius: 22px; background-color: rgba(255,255,255,0.8); }
.pause-label { color: #4b7695; font-size: 13px; }
.skip-button { margin: 0; padding: 0 16px; height: 42px; line-height: 42px; border-radius: 21px; background-color: #65bfa7; color: #ffffff; font-size: 14px; }
.progress { margin-top: 14px; height: 6px; border-radius: 3px; background-color: rgba(255,255,255,0.7); overflow: hidden; }
.progress-fill { height: 6px; border-radius: 3px; background-color: #66bfa9; }
.sky { flex: 1; min-height: 280px; margin-top: 16px; border-radius: 28px; background-color: rgba(255,255,255,0.5); position: relative; overflow: hidden; }
.bird-wrap { position: absolute; left: 18px; width: 66px; height: 16.9231%; z-index: 4; }
.bird { width: 100%; height: 100%; }
.bird-wing { position: absolute; left: 2%; top: 5%; width: 53%; height: 65%; transform-origin: 80% 82%; }
.gate { position: absolute; top: 0; width: 82px; height: 100%; z-index: 3; }
.cloud-wall { position: absolute; left: 0; width: 82px; background-color: #d8eaf7; border-width: 2px; border-color: #bed9ed; align-items: center; justify-content: center; overflow: hidden; }
.cloud-top { top: 0; border-radius: 0 0 34px 34px; }
.cloud-bottom { bottom: 0; border-radius: 34px 34px 0 0; }
.cloud-mark { color: #ffffff; font-size: 43px; }
.cloud-shine { position: absolute; left: 9px; top: 12px; width: 12px; height: 55%; border-radius: 6px; background-color: rgba(255,255,255,0.45); }
.gap-outline { position: absolute; left: 4px; width: 74px; border-width: 1px; border-style: dashed; border-color: rgba(85,165,185,0.35); border-radius: 24px; }
.feedback { position: absolute; top: 16px; left: 8%; width: 84%; text-align: center; font-size: 14px; font-weight: 700; z-index: 6; }
.good { color: #2c856d; }.again { color: #9e7751; }
.instruction { position: absolute; left: 6%; right: 6%; top: 28%; padding: 24px 14px 8px; border-radius: 26px; background-color: rgba(255,255,255,0.94); align-items: center; z-index: 10; }
.instruction-title { color: #305572; font-size: 21px; font-weight: 700; }
.hint { margin-top: 12px; color: #a66a50; font-size: 13px; }
.primary { margin-top: 20px; width: 172px; height: 50px; line-height: 50px; border-radius: 25px; background-color: #65bfa7; color: #ffffff; font-size: 17px; font-weight: 700; }
.replay { padding: 18px; color: #6389a4; font-size: 14px; }
.pause-cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(233,245,255,0.65); align-items: center; justify-content: center; z-index: 15; }
.pause-card { width: 86%; padding: 24px 12px 8px; border-radius: 26px; background-color: #ffffff; align-items: center; }
.flap-button { margin-top: 16px; padding: 0; width: 100%; height: 56px; line-height: 56px; border-radius: 24px; background-color: #65bfa7; color: #ffffff; font-size: 18px; font-weight: 700; }
.stats { margin-top: 12px; flex-direction: row; justify-content: space-between; }
.stat { color: #60839a; font-size: 12px; }

/* Shared preview palette: breathing-planet. Keep gameplay geometry unchanged. */
.training-preview-card { border-radius: 30px; background-color: rgba(255,255,255,0.65); }
.training-preview-primary { width: 200px; height: 50px; line-height: 50px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 25px; background-color: #8d9bdb; color: #ffffff; font-size: 17px; font-weight: 700; text-align: center; }
.training-preview-secondary { width: 200px; height: 42px; line-height: 42px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 21px; background-color: rgba(255,255,255,0.6); color: #7584b5; font-size: 14px; text-align: center; }
</style>
