<template>
<TrainingFrame :difficulty="difficultyLevel" :preparing="!started" title="找茬乐园" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
  <view class="backdrop">
  <image class="desk-background tap-content" :src="SPOT_DIFFERENCE_BACKGROUND" mode="aspectFill"></image>
  <scroll-view class="page" direction="vertical" show-scrollbar="false"><view class="content">
    <view v-if="started" class="header"><view><text class="dimension">观察发现训练</text><text class="title">找茬乐园</text><text class="scene-label">{{ started ? (sessionStep + 1) + ' / ' + sessionPlan.length + ' 组' : '试玩' }}</text></view><view class="counter"><text class="counter-value">{{ found.length }}/{{ targetCount }}</text></view></view>
    <view v-if="started" class="progress"><view class="progress-fill" :style="{ width: progressWidth }"></view></view>
    <image v-for="asset in preloadAssets" :key="asset.key" class="asset-preload tap-content" :src="asset.src" @load="onAssetLoaded(asset.key)" @error="onAssetFailed(asset.key)"></image>
    <view v-if="!imageShown" class="loading-state"><text>{{ imageLoadFailed ? '图片没有加载好' : '图片准备中…' }}</text><button v-if="imageLoadFailed" @click="retryScene">重新加载</button></view>
    <view v-if="!started" class="trial-actions training-preview-card">
      <text class="trial-title">{{ roundComplete ? '找齐啦！' : '点一点，找出 2 处不同' }}</text>
      <button class="training-preview-primary" @click="begin">开始训练</button>
      <text v-if="roundComplete" class="training-preview-secondary" @click="setupTrial">再试一次</text>
    </view>
    <view v-else class="tip"><view><text class="tip-title">找出 {{ targetCount }} 处不同</text></view><button class="tap-target hint-button" :disabled="found.length >= targetCount" @click="showHint">提示</button></view>

    <view class="scene-card" :style="{ opacity: imageShown ? 1 : 0 }"><text class="scene-label">{{ topUsesAlternate ? '图二' : '图一' }}</text><view class="scene-wrap" :style="{ height: sceneHeightStyle }" @click="miss">
      <image class="scene tap-content" :style="{ height: sceneHeightStyle }" :src="sceneA" :key="renderVersion" mode="aspectFit"></image>
      <template v-for="item in activeCandidates" :key="item.id"><view v-if="isAlternate(item, true)" class="scene-patch tap-content" :style="{ left: item.left, top: item.top, width: item.width, height: item.height }"><image class="patch-image tap-content" :src="sceneB" mode="scaleToFill" :style="{ width: sceneWidth + 'px', height: sceneHeightStyle, left: (-item.x * sceneWidth / 100) + 'px', top: (-item.y * sceneHeight / 100) + 'px' }"></image></view></template>
      <view v-for="hit in hitAreas" :key="'hit-' + hit.id" class="hit-target" :style="{ left: hit.left, top: hit.top, width: hit.width, height: hit.height }" @click.stop="find(hit.id)"></view>
      <view v-for="item in activeCandidates" :key="item.id" class="hotspot" :class="found.indexOf(item.id) >= 0 ? 'hotspot-found' : hintId == item.id ? 'hotspot-hint' : ''" :style="{ left: item.left, top: item.top, width: item.width, height: item.height }" @click.stop="find(item.id)"><text v-if="found.indexOf(item.id) >= 0" class="found-mark tap-content">✓</text><text v-else-if="hintId == item.id" class="hint-mark tap-content">!</text></view>
    </view></view>

    <view class="scene-card" :style="{ opacity: imageShown ? 1 : 0 }"><text class="scene-label">{{ topUsesAlternate ? '图一' : '图二' }}</text><view class="scene-wrap" :style="{ height: sceneHeightStyle }" @click="miss">
      <image class="scene tap-content" :style="{ height: sceneHeightStyle }" :src="sceneA" mode="aspectFit"></image>
      <template v-for="item in activeCandidates" :key="item.id"><view v-if="isAlternate(item, false)" class="scene-patch tap-content" :style="{ left: item.left, top: item.top, width: item.width, height: item.height }"><image class="patch-image tap-content" :src="sceneB" mode="scaleToFill" :style="{ width: sceneWidth + 'px', height: sceneHeightStyle, left: (-item.x * sceneWidth / 100) + 'px', top: (-item.y * sceneHeight / 100) + 'px' }"></image></view></template>
      <view v-for="hit in hitAreas" :key="'hit-' + hit.id" class="hit-target" :style="{ left: hit.left, top: hit.top, width: hit.width, height: hit.height }" @click.stop="find(hit.id)"></view>
      <view v-for="item in activeCandidates" :key="item.id" class="hotspot" :class="found.indexOf(item.id) >= 0 ? 'hotspot-found' : hintId == item.id ? 'hotspot-hint' : ''" :style="{ left: item.left, top: item.top, width: item.width, height: item.height }" @click.stop="find(item.id)"><text v-if="found.indexOf(item.id) >= 0" class="found-mark tap-content">✓</text><text v-else-if="hintId == item.id" class="hint-mark tap-content">!</text></view>
    </view></view>

    <button v-if="started" class="tap-target another-button" :disabled="!imageShown || roundComplete" @click="newRound">换一组图片</button>
    <view v-if="started" class="stats"><view class="stat"><text class="value">{{ errors }}</text><text class="label">误点</text></view><view class="stat"><text class="value">{{ hintsUsed }}</text><text class="label">提示</text></view><view class="stat"><text class="value">{{ elapsedLabel }}</text><text class="label">用时</text></view></view>
  </view></scroll-view>
  </view>
</TrainingFrame>
</template>

<script setup lang="uts">
import { SPOT_DIFFERENCE_BACKGROUND } from '../../utils/game-assets.uts'
import { timedRoundScore, scoreQuery, searchTargetMs } from '../../utils/game-scoring.uts'
const roundScores: number[] = []
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import { ref, computed } from 'vue'
import { onLoad, onUnload, onResize } from '@dcloudio/uni-app'
import { getGameDifficulty } from '../../utils/difficulty.uts'
import { localTestKey } from '../../utils/local-test.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating

import { DifferenceCandidate, DifferenceScene } from '../../utils/spot-difference-types.uts'
import { DIFFERENCE_SCENES, LEGACY_DIFFERENCE_SCENES, differenceSessionPlan, differenceTargetCount } from '../../utils/spot-difference-scenes.uts'
import { chooseUnseenDifference, markDifferenceShown, chooseDifferenceRecipe } from '../../utils/spot-difference-cycle.uts'
import { DifferenceHitbox, differenceHitboxes } from '../../utils/spot-difference-hitbox.uts'
const sessionStep = ref(0), renderVersion = ref(0), imageShown = ref(false)
const started = ref(false)
type SceneAsset = { key: string, src: string }
const preloadAssets = ref([] as SceneAsset[]), imageLoadFailed = ref(false)
let loadedAssets: string[] = []
let loadTimer = 0
const currentScene = ref(DIFFERENCE_SCENES[0] as DifferenceScene)
let sessionStartedAt = 0, totalErrors = 0, totalTargets = 0
const difficultyLevel = ref(1), activeIds = ref([] as string[]), found = ref([] as string[])
const candidates = computed((): DifferenceCandidate[] => currentScene.value.regions)
const sceneA = computed((): string => currentScene.value.imageA), sceneB = computed((): string => currentScene.value.imageB)
const sceneWidth = ref(320), roundComplete = ref(false)
const errors = ref(0), hintsUsed = ref(0), hintId = ref(''), sceneHeight = ref(180), elapsed = ref(0), topUsesAlternate = ref(false)
let ticker = 0, hintTimer = 0, finishTimer = 0, startedAt = 0
const sessionPlan = computed((): string[] => differenceSessionPlan(difficultyLevel.value))
const difficultyName = computed((): string => difficultyLevel.value <= 2 ? '轻松' : difficultyLevel.value <= 5 ? '成长' : difficultyLevel.value <= 8 ? '进阶' : '挑战')
const targetCount = computed((): number => started.value ? differenceTargetCount(difficultyLevel.value) : 2)
const activeCandidates = computed((): DifferenceCandidate[] => candidates.value.filter((item: DifferenceCandidate): boolean => activeIds.value.indexOf(item.id) >= 0))
const hitAreas = computed((): DifferenceHitbox[] => differenceHitboxes(activeCandidates.value, sceneWidth.value, sceneHeight.value).filter((hit: DifferenceHitbox): boolean => found.value.indexOf(hit.id) < 0))
const progressWidth = computed((): string => Math.round(((sessionStep.value + found.value.length / targetCount.value) / sessionPlan.value.length) * 100).toString() + '%')
const elapsedLabel = computed((): string => elapsed.value.toString() + 's')
const sceneHeightStyle = computed((): string => sceneHeight.value.toString() + 'px')
function isAlternate(item: DifferenceCandidate, isTop: boolean): boolean { if (activeIds.value.indexOf(item.id) < 0) return false; return isTop == topUsesAlternate.value }
function makeRecipe(): string[] {
  return chooseDifferenceRecipe(candidates.value, targetCount.value)
}
function onSceneShown() {
  if (imageShown.value || loadedAssets.length < 2) return
  if (loadTimer > 0) trainingClock.clearTimeout(loadTimer)
  imageShown.value = true; imageLoadFailed.value = false; startedAt = trainingClock.now()
  if (!started.value) return
  markDifferenceShown(currentScene.value, DIFFERENCE_SCENES, targetCount.value)
  uni.setStorageSync(localTestKey('spot_last_recipe_' + currentScene.value.id), activeIds.value.slice().sort().join(','))
}
function onAssetLoaded(key: string) {
  if (!preloadAssets.value.some((asset: SceneAsset): boolean => asset.key == key)) return
  if (loadedAssets.indexOf(key) < 0) loadedAssets.push(key)
  onSceneShown()
}
function onAssetFailed(key: string) {
  if (!preloadAssets.value.some((asset: SceneAsset): boolean => asset.key == key) || imageShown.value) return
  imageLoadFailed.value = true
}
function retryScene() {
  if (trainingPaused.value || roundComplete.value) return
  if (loadTimer > 0) trainingClock.clearTimeout(loadTimer)
  renderVersion.value += 1; imageShown.value = false; imageLoadFailed.value = false; loadedAssets = [] as string[]
  const prefix = renderVersion.value.toString()
  preloadAssets.value = [{ key: prefix + '-a', src: sceneA.value }, { key: prefix + '-b', src: sceneB.value }] as SceneAsset[]
  loadTimer = trainingClock.setTimeout(() => { if (!imageShown.value) imageLoadFailed.value = true }, 12000)
}
function newRound() { if (trainingPaused.value || roundComplete.value || !started.value) return;
  if (hintTimer > 0) trainingClock.clearTimeout(hintTimer)
  if (finishTimer > 0) trainingClock.clearTimeout(finishTimer)
  const tier = sessionPlan.value[sessionStep.value]
  const selected = chooseUnseenDifference(tier, DIFFERENCE_SCENES, targetCount.value)
  if (selected != null) currentScene.value = selected
  else { const fallback = chooseUnseenDifference(tier, LEGACY_DIFFERENCE_SCENES, targetCount.value); if (fallback == null) return; currentScene.value = fallback }
  const lastValue = uni.getStorageSync(localTestKey('spot_last_recipe_' + currentScene.value.id))
  const lastRecipe = lastValue == null ? '' : lastValue as string
  let next = makeRecipe(), signature = next.slice().sort().join(',')
  for (let attempt = 0; attempt < 8 && signature == lastRecipe; attempt++) { next = makeRecipe(); signature = next.slice().sort().join(',') }
  if (next.length != targetCount.value) { imageShown.value = false; imageLoadFailed.value = true; return }
  activeIds.value = next
  found.value = [] as string[]; errors.value = 0; hintsUsed.value = 0; hintId.value = ''; elapsed.value = 0; startedAt = trainingClock.now(); topUsesAlternate.value = Math.random() < 0.5
  retryScene()
}
function finish() {
  if (ticker > 0) trainingClock.clearInterval(ticker)
  const accuracy = Math.round(totalTargets * 100 / Math.max(1, totalTargets + totalErrors))
  const duration = Math.max(1, Math.round((trainingClock.now() - sessionStartedAt) / 1000))
  uni.redirectTo({ url: '/pages/result/result?gameId=spot-difference&dimensionId=selective&score=' + accuracy.toString() + '&accuracy=' + accuracy.toString() + '&reaction=0&duration=' + duration.toString() + scoreQuery(roundScores) })
}
function advanceScene() {
  totalTargets += targetCount.value; totalErrors += errors.value
  sessionStep.value += 1
  if (sessionStep.value >= sessionPlan.value.length) { finish(); return }
  roundComplete.value = false; newRound()
}
function find(id: string) { if (trainingPaused.value || !imageShown.value || roundComplete.value || activeIds.value.indexOf(id) < 0) return; if (found.value.indexOf(id) >= 0) return; found.value.push(id); training.playFeedback('correct'); if (hintId.value == id) hintId.value = ''; if (found.value.length >= targetCount.value) { roundComplete.value = true; if (!started.value) return; roundScores.push(timedRoundScore(true, trainingClock.now() - startedAt, targetCount.value * 15000, errors.value + hintsUsed.value)); finishTimer = trainingClock.setTimeout(() => advanceScene(), 650) } }
function miss() { if (trainingPaused.value || !imageShown.value || roundComplete.value) return; if (started.value) errors.value += 1; training.playFeedback('wrong') }
function showHint() { if (trainingPaused.value || !imageShown.value) return; if (found.value.length >= targetCount.value) return; if (hintTimer > 0) trainingClock.clearTimeout(hintTimer); const remaining = activeCandidates.value.filter((item: DifferenceCandidate): boolean => found.value.indexOf(item.id) < 0); remaining.sort((a: DifferenceCandidate, b: DifferenceCandidate): number => a.difficulty - b.difficulty); if (remaining.length > 0) hintId.value = remaining[0].id; hintsUsed.value += 1; hintTimer = trainingClock.setTimeout(() => { hintId.value = '' }, 1800) }
function resizeScene() { const info = uni.getWindowInfo(); sceneWidth.value = info.windowWidth - 48; sceneHeight.value = sceneWidth.value * 9 / 16 }
function setupTrial() {
  if (trainingPaused.value || started.value) return
  currentScene.value = LEGACY_DIFFERENCE_SCENES[0]
  activeIds.value = ['can', 'ball'] as string[]
  found.value = [] as string[]; roundComplete.value = false; topUsesAlternate.value = false
  retryScene()
}
function begin() {
  if (trainingPaused.value || started.value) return
  started.value = true; roundComplete.value = false; sessionStep.value = 0
  roundScores.length = 0; totalErrors = 0; totalTargets = 0
  sessionStartedAt = trainingClock.now()
  newRound()
  ticker = trainingClock.setInterval(() => { elapsed.value = imageShown.value ? Math.round((trainingClock.now() - startedAt) / 1000) : 0 }, 1000)
}
onResize(() => resizeScene())
onLoad((_options: OnLoadOptions) => {
  resizeScene()
  difficultyLevel.value = getGameDifficulty('spot-difference')
  setupTrial()
})
onUnload(() => { if (loadTimer > 0) trainingClock.clearTimeout(loadTimer); if (finishTimer > 0) trainingClock.clearTimeout(finishTimer); if (ticker > 0) trainingClock.clearInterval(ticker); if (hintTimer > 0) trainingClock.clearTimeout(hintTimer) })
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => started.value)
</script>

<style>
.backdrop { flex: 1; position: relative; }
.desk-background { position: absolute; width: 100%; height: 100%; }
.page { position: relative; }
.trial-actions { margin-top: 12px; padding: 16px 12px; align-items: center; }
.trial-title { margin-bottom: 12px; color: #495a82; font-size: 18px; font-weight: 700; }
.asset-preload { position: absolute; width: 1px; height: 1px; opacity: 0; }
.loading-state { padding: 12px; align-items: center; }
.hit-target { position: absolute; z-index: 3; }

.scene-patch { position: absolute; overflow: hidden; z-index: 2; }
.patch-image { position: absolute; }

.page { height: 100%; }.content { padding: 20px 16px 34px; }.header { flex-direction: row; align-items: center; justify-content: space-between; }.dimension { color: #ad7a10; font-size: 12px; font-weight: 700; }.title { margin-top: 4px; color: #1f2a44; font-size: 21px; font-weight: 700; }.counter { width: 62px; height: 38px; border-radius: 19px; background-color: #fff4d7; align-items: center; justify-content: center; }.counter-value { color: #a97810; font-size: 13px; font-weight: 700; }
.difficulty-display { margin-top: 14px; min-height: 48px; padding: 0 15px; border-radius: 15px; background-color: #fff7e5; flex-direction: row; align-items: center; justify-content: space-between; }.difficulty-title { color: #6d5115; font-size: 13px; font-weight: 700; }.difficulty-name { color: #a97810; font-size: 12px; font-weight: 700; }
.progress { margin-top: 12px; height: 8px; border-radius: 4px; background-color: #e5eaf2; overflow: hidden; }.progress-fill { height: 8px; background-color: #ffc857; }.tip { margin-top: 12px; padding: 9px 10px 9px 13px; border-radius: 16px; background-color: #fff7e5; flex-direction: row; align-items: center; justify-content: space-between; }.tip-title { color: #594b2f; font-size: 14px; font-weight: 700; }.tip-copy { margin-top: 3px; color: #8b7b59; font-size: 10px; }.hint-button { margin: 0; padding: 0 14px; height: 48px; line-height: 48px; border-radius: 14px; background-color: #ffc857; color: #6d5115; font-size: 12px; font-weight: 700; }
.scene-card { margin-top: 12px; padding: 8px; border-radius: 18px; background-color: #ffffff; }.scene-label { margin: 2px 0 7px 5px; color: #728097; font-size: 10px; font-weight: 700; }.scene-wrap { width: 100%; position: relative; overflow: hidden; border-radius: 13px; }.scene { width: 100%; border-radius: 13px; }.hotspot { position: absolute; border-radius: 12px; z-index: 4; }.hotspot-found { border: 3px solid #55c9a5; background-color: rgba(255,255,255,0.35); align-items: center; justify-content: center; }.hotspot-hint { border: 4px solid #ff9f43; background-color: rgba(255,245,218,0.48); align-items: center; justify-content: center; }.found-mark { color: #278567; font-size: 20px; font-weight: 800; }.hint-mark { color: #d86e16; font-size: 20px; font-weight: 800; }
.another-button { margin-top: 12px; width: 150px; height: 48px; line-height: 48px; border-radius: 14px; background-color: #fff4d7; color: #9b7119; font-size: 12px; font-weight: 700; }.stats { margin-top: 14px; flex-direction: row; }.stat { flex: 1; align-items: center; }.value { color: #25314a; font-size: 18px; font-weight: 700; }.label { margin-top: 3px; color: #8a93a7; font-size: 10px; }

/* Shared preview palette: breathing-planet. Keep gameplay geometry unchanged. */
.training-preview-card { border-radius: 30px; background-color: rgba(255,255,255,0.65); }
.training-preview-primary { width: 200px; height: 50px; line-height: 50px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 25px; background-color: #8d9bdb; color: #ffffff; font-size: 17px; font-weight: 700; text-align: center; }
.training-preview-secondary { width: 200px; height: 42px; line-height: 42px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 21px; background-color: rgba(255,255,255,0.6); color: #7584b5; font-size: 14px; text-align: center; }
</style>
