<template>
<TrainingFrame :difficulty="difficultyLevel" :preparing="!started" title="星空守望员" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
  <view class="page">
    <image class="night-background tap-content" src="/static/images/runtime/backgrounds/star-catcher-sky-v1.webp" mode="aspectFill"></image>
    <view class="content">
      <view class="game-header">
        <view><text class="round-label">反应控制训练</text><text class="game-title">守望金色星球</text></view>
        <view v-if="started" class="counter"><text class="counter-value">{{ displayRound }}/{{ totalRounds }}</text></view>
      </view>
      <view v-if="started" class="progress-track"><view class="progress-fill" :style="{ width: progressWidth }"></view></view>
      <view class="target-guide">
        <image class="guide-planet" :src="targetSource" mode="aspectFit"></image>
        <view class="guide-copy"><text class="guide-title">只点这一颗</text><text class="guide-note">其他星球不要点</text></view>
      </view>
      <view class="play-area">
        <view v-if="!started" class="instruction">
          <text class="demo-title">先试一下</text>
          <view class="demo-row">
            <view v-for="planet in demoPlanets" :key="planet" class="demo-choice" @click="tapDemo(planet)">
              <image class="demo-planet tap-content" :src="skyPlanetSources[planet]" mode="aspectFit"></image>
            </view>
          </view>
          <text class="demo-hint">{{ demoHint }}</text>
          <view class="demo-replay-row"><text v-if="demoDone" class="demo-replay training-preview-secondary" @click="resetDemo">再试一次</text></view>
          <button class="tap-target primary training-preview-primary" @click="begin">开始训练</button>
        </view>
        <view v-else-if="loadFailed" class="instruction">
          <text class="demo-hint">星球还没准备好</text>
          <button class="tap-target primary" @click="retryImage">重试</button>
        </view>
        <view v-else-if="visible" class="stimulus" @click="tapStimulus">
          <image :key="stimulusId" class="planet-image tap-content" :src="stimulusSource" mode="aspectFit" @load="onStimulusLoaded" @error="onStimulusError"></image>
          <text class="response-hint">{{ responseHint }}</text>
        </view>
        <text v-else class="waiting-text">· · ·</text>
      </view>
      <view v-if="started" class="footer-stats">
        <view class="footer-stat"><text class="footer-value">{{ hits }}</text><text class="footer-label">命中</text></view>
        <view class="footer-stat"><text class="footer-value">{{ omissions }}</text><text class="footer-label">遗漏</text></view>
        <view class="footer-stat"><text class="footer-value">{{ falseAlarms }}</text><text class="footer-label">误点</text></view>
      </view>
    </view>
  </view>
</TrainingFrame>
</template>

<script setup lang="uts">
import { scoreQuery } from '../../utils/game-scoring.uts'
const roundScores: number[] = []
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import { ref, computed } from 'vue'
import { onLoad, onHide, onUnload } from '@dcloudio/uni-app'
import { getGameDifficulty } from '../../utils/difficulty.uts'
import { skyPlanetSources, getSkyTiming, pickSkyDistractor } from '../../utils/sky-planets.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating


const started = ref(false), finished = ref(false), visible = ref(false), currentTarget = ref(false)
const difficultyLevel = ref(1), targetIndex = ref(0), stimulusIndex = ref(0), stimulusId = ref(0)
const roundIndex = ref(0), totalRounds = ref(12), showDuration = ref(2800), gapDuration = ref(1100)
const hits = ref(0), omissions = ref(0), falseAlarms = ref(0), responded = ref(false)
const stimulusReady = ref(false), loadFailed = ref(false), paused = ref(false)
const reactions = ref([] as number[]), responseHint = ref('')
const demoDone = ref(false), demoHint = ref('点上面那颗星球'), demoPlanets = ref([0, 8] as number[])
let roundPlan = [] as boolean[]
let appearedAt = 0, gameStartedAt = 0, pausedAt = 0, loadingAt = 0
let showTimer = 0, gapTimer = 0, loadTimer = 0

const targetSource = computed((): string => skyPlanetSources[targetIndex.value])
const stimulusSource = computed((): string => skyPlanetSources[stimulusIndex.value])
const displayRound = computed((): number => started.value ? Math.min(totalRounds.value, roundIndex.value + 1) : 0)
const progressWidth = computed((): string => started.value ? Math.min(100, Math.round(roundIndex.value / totalRounds.value * 100)).toString() + '%' : '0%')

function resetDemo() { if (trainingPaused.value) return; if (started.value) return; demoDone.value = false; demoHint.value = '点上面那颗星球' }
function tapDemo(index: number) { if (trainingPaused.value) return;
  if (started.value || demoDone.value) return
  if (index == targetIndex.value) { demoDone.value = true; demoHint.value = '✓ 找对啦！' }
  else demoHint.value = '这颗不用点，再看看上面'
}
function configureDifficulty() {
  difficultyLevel.value = getGameDifficulty('sky-watcher')
  const timing = getSkyTiming(difficultyLevel.value)
  totalRounds.value = timing.rounds; showDuration.value = timing.showMs; gapDuration.value = timing.gapMs
  // 一次训练固定一个目标，试玩与正式训练使用完全相同的素材。
  targetIndex.value = Math.floor(Math.random() * 4)
  const other = 8 + Math.floor(Math.random() * 12)
  demoPlanets.value = Math.random() < 0.5 ? [targetIndex.value, other] : [other, targetIndex.value]
}
function buildRoundPlan() {
  roundPlan = [] as boolean[]
  const count = Math.max(4, Math.round(totalRounds.value * 0.35))
  for (let i = 0; i < totalRounds.value; i++) roundPlan.push(i < count)
  for (let i = roundPlan.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1)); const value = roundPlan[i]
    roundPlan[i] = roundPlan[j]; roundPlan[j] = value
  }
}
function clearTimers() {
  if (showTimer > 0) trainingClock.clearTimeout(showTimer)
  if (gapTimer > 0) trainingClock.clearTimeout(gapTimer)
  if (loadTimer > 0) trainingClock.clearTimeout(loadTimer)
  showTimer = 0; gapTimer = 0; loadTimer = 0
}
function finishGame() {
  clearTimers(); finished.value = true; visible.value = false
  const targetTotal = hits.value + omissions.value
  const distractorTotal = totalRounds.value - targetTotal
  const targetAccuracy = targetTotal == 0 ? 0 : hits.value / targetTotal
  const inhibitionAccuracy = distractorTotal == 0 ? 1 : Math.max(0, 1 - falseAlarms.value / distractorTotal)
  const accuracy = Math.round((targetAccuracy * 0.7 + inhibitionAccuracy * 0.3) * 100)
  const sum = reactions.value.reduce((total: number, value: number): number => total + value, 0)
  const average = reactions.value.length == 0 ? 0 : Math.round(sum / reactions.value.length)
  const duration = Math.max(1, Math.round((trainingClock.now() - gameStartedAt) / 1000))
  uni.redirectTo({ url: '/pages/result/result?gameId=sky-watcher&dimensionId=sustained&score=' + accuracy.toString() +
    '&accuracy=' + accuracy.toString() + '&reaction=' + average.toString() + '&duration=' + duration.toString() +
    '&omissions=' + omissions.value.toString() + '&falseAlarms=' + falseAlarms.value.toString() + scoreQuery(roundScores) })
}
function onStimulusError() {
  if (!started.value || finished.value || paused.value || !visible.value || stimulusReady.value) return
  clearTimers(); loadFailed.value = true
}
function showNext() {
  if (paused.value || finished.value) return
  clearTimers()
  if (roundIndex.value >= totalRounds.value) { finishGame(); return }
  currentTarget.value = roundPlan[roundIndex.value]
  stimulusIndex.value = currentTarget.value ? targetIndex.value : pickSkyDistractor(difficultyLevel.value, targetIndex.value)
  responded.value = false; stimulusReady.value = false; loadFailed.value = false; responseHint.value = ''
  stimulusId.value += 1; visible.value = true; loadingAt = trainingClock.now()
  loadTimer = trainingClock.setTimeout(() => onStimulusError(), 5000)
}
function onStimulusLoaded() {
  if (!started.value || finished.value || paused.value || !visible.value || loadFailed.value || stimulusReady.value) return
  if (loadTimer > 0) trainingClock.clearTimeout(loadTimer)
  loadTimer = 0
  // 本地素材解码完成后才开始反应计时，加载时间也不计入总时长。
  gameStartedAt += Math.max(0, trainingClock.now() - loadingAt)
  stimulusReady.value = true; appearedAt = trainingClock.now()
  showTimer = trainingClock.setTimeout(() => {
    visible.value = false; stimulusReady.value = false
    roundScores.push(currentTarget.value == responded.value ? 100 : 0)
    if (currentTarget.value && !responded.value) { omissions.value += 1; training.playFeedback('missed') }
    roundIndex.value += 1
    gapTimer = trainingClock.setTimeout(() => showNext(), gapDuration.value)
  }, showDuration.value)
}
function begin() { if (trainingPaused.value) return;
  if (started.value) return
  buildRoundPlan(); started.value = true; gameStartedAt = trainingClock.now()
  gapTimer = trainingClock.setTimeout(() => showNext(), gapDuration.value)
}
function tapStimulus() { if (trainingPaused.value) return;
  if (!started.value || paused.value || !visible.value || !stimulusReady.value || responded.value || finished.value) return
  responded.value = true
  if (currentTarget.value) { { hits.value += 1; training.playFeedback('correct') } reactions.value.push(trainingClock.now() - appearedAt); responseHint.value = '✓' }
  else { { falseAlarms.value += 1; training.playFeedback('wrong') } responseHint.value = '这颗不用点' }
}
function retryImage() { if (trainingPaused.value) return;
  if (!loadFailed.value || paused.value) return
  gameStartedAt += Math.max(0, trainingClock.now() - loadingAt)
  showNext()
}
function pauseGame() { training.pause() }
function resumeGame() { training.resume() }
onLoad((_options: OnLoadOptions) => configureDifficulty())
onUnload(() => { finished.value = true; clearTimers() })
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => started.value)
</script>

<style>
.page { position: relative; flex: 1; background-color: #17266d; }
.night-background { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.content { position: relative; flex: 1; padding: 18px; }
.game-header { flex-direction: row; justify-content: space-between; align-items: center; }
.round-label { color: #dbe8ff; font-size: 12px; font-weight: 700; }
.game-title { margin-top: 4px; color: #ffffff; font-size: 21px; font-weight: 700; }
.counter { width: 62px; height: 38px; border-radius: 19px; background-color: #e5f6ef; align-items: center; justify-content: center; }
.counter-value { color: #3f987a; font-size: 13px; font-weight: 700; }
.progress-track { margin-top: 14px; height: 7px; border-radius: 4px; background-color: #e5eaf2; overflow: hidden; }
.progress-fill { height: 7px; background-color: #55c9a5; }
.target-guide { margin-top: 14px; padding: 8px 16px; border-radius: 20px; background-color: rgba(255,255,255,0.94); flex-direction: row; align-items: center; }
.guide-planet { width: 72px; height: 72px; }
.guide-copy { margin-left: 14px; }
.guide-title { color: #25314a; font-size: 17px; font-weight: 700; }
.guide-note { margin-top: 5px; color: #64728b; font-size: 12px; }
.play-area { margin-top: 14px; height: 360px; border-radius: 26px; background-color: rgba(255,255,255,0.5); position: relative; overflow: hidden; align-items: center; justify-content: center; }
.instruction { width: 100%; align-items: center; }
.demo-title { color: #25314a; font-size: 17px; font-weight: 700; }
.demo-row { margin-top: 18px; flex-direction: row; align-items: center; justify-content: center; }
.demo-choice { width: 118px; height: 118px; margin: 0 4px; align-items: center; justify-content: center; }
.demo-planet { width: 110px; height: 110px; }
.demo-hint { margin-top: 12px; color: #25314a; font-size: 13px; }
.demo-replay-row { height: 32px; justify-content: center; }
.demo-replay { padding: 8px 20px; color: #344b75; font-size: 12px; }
.primary { margin-top: 10px; width: 140px; height: 48px; line-height: 48px; border-radius: 16px; background-color: #55b895; color: #ffffff; font-size: 15px; font-weight: 700; }
.stimulus { width: 190px; height: 220px; align-items: center; justify-content: center; }
.planet-image { width: 180px; height: 180px; }
.response-hint { height: 28px; margin-top: 8px; color: #25314a; font-size: 15px; font-weight: 700; }
.waiting-text { color: #344b75; font-size: 24px; }
.footer-stats { margin-top: 15px; flex-direction: row; }
.footer-stat { flex: 1; align-items: center; }
.footer-value { color: #ffffff; font-size: 18px; font-weight: 700; }
.footer-label { margin-top: 3px; color: #dbe8ff; font-size: 11px; }

/* Shared preview palette: breathing-planet. Keep gameplay geometry unchanged. */
.training-preview-card { border-radius: 30px; background-color: rgba(255,255,255,0.65); }
.training-preview-primary { width: 200px; height: 50px; line-height: 50px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 25px; background-color: #8d9bdb; color: #ffffff; font-size: 17px; font-weight: 700; text-align: center; }
.training-preview-secondary { width: 200px; height: 42px; line-height: 42px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 21px; background-color: rgba(255,255,255,0.6); color: #7584b5; font-size: 14px; text-align: center; }
</style>
