<template>
<TrainingFrame title="奇偶轨道" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
  <view class="page">
    <view class="game-header"><view><text class="round-label">转换注意训练</text><text class="game-title">奇偶轨道</text></view><view class="counter"><text class="counter-value">{{ displayRound }}/{{ totalRounds }}</text></view></view>
    <view class="progress-track"><view class="progress-fill" :style="{ width: progressWidth }"></view></view>
    <view class="rule-card" :class="reversed ? 'reversed-card' : ''"><text class="rule-title">{{ reversed ? '偶数走左 · 奇数走右' : '奇数走左 · 偶数走右' }}</text><text v-if="justSwitched" class="switch-badge">换轨</text></view>
    <view class="number-stage">
      <view v-if="!started" class="instruction"><view class="sample-numbers"><text class="sample-number">3</text><text class="sample-number">8</text></view><button class="tap-target primary" @click="begin">开始</button></view>
      <view v-else class="challenge"><text class="number">{{ currentNumber }}</text><text class="number-kind">判断后选择轨道</text><text class="feedback" :class="feedback == '轨道正确' ? 'good' : 'again'">{{ feedback }}</text></view>
    </view>
    <view v-if="started" class="tracks"><ActionSurface class="tap-target track left" :disabled="!accepting" @click="answer('left')"><text class="track-label tap-content">左轨</text><text class="track-rule tap-content">{{ reversed ? '偶数' : '奇数' }}</text></ActionSurface><ActionSurface class="tap-target track right" :disabled="!accepting" @click="answer('right')"><text class="track-label tap-content">右轨</text><text class="track-rule tap-content">{{ reversed ? '奇数' : '偶数' }}</text></ActionSurface></view>
    <view class="footer-stats"><view class="footer-stat"><text class="footer-value">{{ correct }}</text><text class="footer-label">正确</text></view><view class="footer-stat"><text class="footer-value">{{ errors }}</text><text class="footer-label">错误</text></view><view class="footer-stat"><text class="footer-value">{{ switchErrors }}</text><text class="footer-label">切换错误</text></view></view>
  </view>
</TrainingFrame>
</template>

<script setup lang="uts">
import { timedRoundScore, scoreQuery, searchTargetMs } from '../../utils/game-scoring.uts'
const roundScores: number[] = []
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import ActionSurface from '../../components/ActionSurface.uvue'
import { ref, computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { getGameTuningAge } from '../../utils/difficulty.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating

const started = ref(false), accepting = ref(false), reversed = ref(false), justSwitched = ref(false), useTwoDigits = ref(false)
const totalRounds = ref(14), blockSize = ref(4), roundIndex = ref(0), currentNumber = ref(1)
const correct = ref(0), errors = ref(0), switchErrors = ref(0), feedback = ref(''), reactions = ref([] as number[])
let appearedAt = 0, gameStartedAt = 0, nextTimer = 0
const displayRound = computed((): number => started.value ? Math.min(totalRounds.value, roundIndex.value + 1) : 0)
const progressWidth = computed((): string => started.value ? Math.round((roundIndex.value / totalRounds.value) * 100).toString() + '%' : '0%')
function configure() { const age = getGameTuningAge('number-track'); if (age <= 6) { totalRounds.value = 10; blockSize.value = 5 } else if (age <= 9) { totalRounds.value = 14; blockSize.value = 4 } else if (age <= 12) { totalRounds.value = 18; blockSize.value = 3; useTwoDigits.value = true } else { totalRounds.value = 22; blockSize.value = 2; useTwoDigits.value = true } }
function clearTimer() { if (nextTimer > 0) trainingClock.clearTimeout(nextTimer) }
function finish() { clearTimer(); const accuracy = Math.round((correct.value / totalRounds.value) * 100); const sum = reactions.value.reduce((total: number, value: number): number => total + value, 0); const average = reactions.value.length == 0 ? 0 : Math.round(sum / reactions.value.length); const duration = Math.max(1, Math.round((trainingClock.now() - gameStartedAt) / 1000)); uni.redirectTo({ url: '/pages/result/result?gameId=number-track&dimensionId=alternating&score=' + accuracy.toString() + '&accuracy=' + accuracy.toString() + '&reaction=' + average.toString() + '&duration=' + duration.toString() + '&switchErrors=' + switchErrors.value.toString() + scoreQuery(roundScores) }) }
function prepare() { if (roundIndex.value >= totalRounds.value) { finish(); return }; justSwitched.value = roundIndex.value > 0 && roundIndex.value % blockSize.value == 0; if (justSwitched.value) reversed.value = !reversed.value; currentNumber.value = useTwoDigits.value ? 10 + Math.floor(Math.random() * 90) : 1 + Math.floor(Math.random() * 9); feedback.value = ''; accepting.value = true; appearedAt = trainingClock.now() }
function begin() { if (trainingPaused.value) return; started.value = true; gameStartedAt = trainingClock.now(); prepare() }
function expected(): string { const odd = currentNumber.value % 2 == 1; const goesLeft = reversed.value ? !odd : odd; return goesLeft ? 'left' : 'right' }
function answer(side: string) { if (trainingPaused.value) return; if (!accepting.value) return; accepting.value = false; roundScores.push(timedRoundScore(side == expected(), trainingClock.now() - appearedAt, searchTargetMs('number-track', getGameTuningAge('number-track') - 4))); reactions.value.push(trainingClock.now() - appearedAt); if (side == expected()) { { correct.value += 1; training.playFeedback('correct') } feedback.value = '轨道正确' } else { { errors.value += 1; training.playFeedback('wrong') } if (justSwitched.value) switchErrors.value += 1; feedback.value = '先看颜色规则' }; nextTimer = trainingClock.setTimeout(() => { roundIndex.value += 1; prepare() }, 520) }
onLoad((_options: OnLoadOptions) => configure()); onUnload(() => clearTimer())
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => started.value)
</script>

<style>
.page { flex: 1; padding: 20px; }.game-header { flex-direction: row; justify-content: space-between; align-items: center; }.round-label { color: #8062bf; font-size: 12px; font-weight: 700; }.game-title { margin-top: 4px; color: #1f2a44; font-size: 21px; font-weight: 700; }.counter { width: 62px; height: 38px; border-radius: 19px; background-color: #eee9fa; align-items: center; justify-content: center; }.counter-value { color: #785bb7; font-size: 13px; font-weight: 700; }
.progress-track { margin-top: 18px; height: 8px; border-radius: 4px; background-color: #e5eaf2; overflow: hidden; }.progress-fill { height: 8px; border-radius: 4px; background-color: #9b7ede; }.rule-card { margin-top: 14px; padding: 15px; border-radius: 18px; background-color: #eaf0ff; position: relative; }.reversed-card { background-color: #f0eafa; }.rule-kicker { color: #7e87a0; font-size: 10px; }.rule-title { margin-top: 4px; color: #46526b; font-size: 15px; font-weight: 700; }.switch-badge { position: absolute; right: 12px; top: 16px; padding: 5px 9px; border-radius: 10px; background-color: #fff2cc; color: #a4730d; font-size: 9px; font-weight: 700; }
.number-stage { margin-top: 14px; height: 290px; border-radius: 25px; background-color: #ffffff; align-items: center; justify-content: center; }.instruction, .challenge { width: 100%; align-items: center; }.sample-numbers { flex-direction: row; }.sample-number { margin: 0 13px; color: #9b7ede; font-size: 58px; font-weight: 800; }.instruction-title { margin-top: 14px; color: #344059; font-size: 18px; font-weight: 700; }.instruction-copy { margin-top: 8px; width: 80%; color: #818a9f; font-size: 11px; line-height: 18px; text-align: center; }.primary { margin-top: 18px; width: 140px; height: 48px; line-height: 48px; border-radius: 14px; background-color: #9b7ede; color: #ffffff; font-size: 14px; font-weight: 700; }.number { color: #4f3c76; font-size: 96px; font-weight: 800; }.number-kind { margin-top: 3px; color: #8992a5; font-size: 11px; }.feedback { margin-top: 14px; font-size: 11px; font-weight: 700; }.good { color: #338e72; }.again { color: #c65b66; }
.tracks { margin-top: 12px; flex-direction: row; }.track { flex: 1; height: 68px; border-radius: 17px; align-items: center; justify-content: center; }.left { margin-right: 6px; background-color: #eaf0ff; }.right { margin-left: 6px; background-color: #f0eafa; }.track-label { color: #7b8599; font-size: 10px; }.track-rule { margin-top: 3px; color: #46526b; font-size: 16px; font-weight: 700; }.footer-stats { margin-top: 13px; flex-direction: row; }.footer-stat { flex: 1; align-items: center; }.footer-value { color: #25314a; font-size: 18px; font-weight: 700; }.footer-label { margin-top: 3px; color: #8a93a7; font-size: 11px; }
</style>
