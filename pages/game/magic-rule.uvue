<template>
  <TrainingFrame :difficulty="level" :preparing="!started" title="魔法规则" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
    <view class="mr-page">
      <image class="mr-scene" src="/static/images/runtime/backgrounds/star-catcher-sky-v1.webp" mode="aspectFill"></image>
      <view class="mr-content">
        <view class="mr-header">
          <view>
            <text class="mr-eyebrow">切换兼顾训练</text>
            <text class="mr-title">魔法规则</text>
          </view>
          <view class="mr-header-right">
            <view v-if="started" class="mr-level"><text class="mr-level-text">难度 {{ level }}</text></view>
            <view class="mr-counter"><text class="mr-counter-text">{{ started ? displayRound.toString() + '/' + totalRounds.toString() : '试玩' }}</text></view>
          </view>
        </view>
        <view class="mr-progress"><view class="mr-progress-fill" :style="{ width: progressWidth }"></view></view>

        <view v-if="!started" class="mr-intro training-preview-card">
          <text class="mr-demo-title">先试一下</text>
          <text class="mr-demo-hint">{{ demoHint }}</text>
          <view class="mr-rule-card" :class="demoRule == 'color' ? 'mr-rule-color' : 'mr-rule-shape'">
            <text v-if="demoStep == 1" class="mr-switch-badge">规则变了</text>
            <text class="mr-rule-title">{{ demoRule == 'color' ? '按照颜色分类' : '按照形状分类' }}</text>
          </view>
          <view class="mr-stage">
            <view class="mr-stim mr-stim-square" :style="{ backgroundColor: demoStimulusColor }"></view>
          </view>
          <view class="mr-answer-row">
            <ActionSurface class="mr-answer mr-answer-left" @click="answerDemo('left')">
              <view v-if="demoRule == 'color'" class="mr-answer-dot mr-blue-dot tap-content"></view>
              <view v-else class="mr-answer-sym mr-sym-circle tap-content"></view>
              <text class="mr-answer-label tap-content">{{ demoRule == 'color' ? '蓝色' : '圆形' }}</text>
            </ActionSurface>
            <ActionSurface class="mr-answer mr-answer-right" @click="answerDemo('right')">
              <view v-if="demoRule == 'color'" class="mr-answer-dot mr-yellow-dot tap-content"></view>
              <view v-else class="mr-answer-sym mr-sym-square tap-content"></view>
              <text class="mr-answer-label tap-content">{{ demoRule == 'color' ? '黄色' : '方形' }}</text>
            </ActionSurface>
          </view>
          <text v-if="demoDone" class="mr-demo-replay training-preview-secondary" @click="resetDemo">再试一次</text>
          <button class="mr-start training-preview-primary" @click="begin">开始训练</button>
        </view>

        <view v-else class="mr-play">
          <view class="mr-rule-card" :class="currentRule == 'color' ? 'mr-rule-color' : 'mr-rule-shape'">
            <text v-if="justSwitched" class="mr-switch-badge">规则变了</text>
            <text class="mr-rule-title">{{ currentRule == 'color' ? '按照颜色分类' : '按照形状分类' }}</text>
          </view>
          <view class="mr-stage">
            <view v-if="stimulusShape == 'circle'" class="mr-stim mr-stim-circle" :style="{ backgroundColor: stimulusColorValue }"></view>
            <view v-else class="mr-stim mr-stim-square" :style="{ backgroundColor: stimulusColorValue }"></view>
          </view>
          <view class="mr-feedback"><text :class="feedback == '正确' ? 'mr-good' : 'mr-again'">{{ feedback }}</text></view>
          <view class="mr-answer-row">
            <ActionSurface class="mr-answer mr-answer-left" @click="answer('left')">
              <view v-if="currentRule == 'color'" class="mr-answer-dot mr-blue-dot tap-content"></view>
              <view v-else class="mr-answer-sym mr-sym-circle tap-content"></view>
              <text class="mr-answer-label tap-content">{{ currentRule == 'color' ? '蓝色' : '圆形' }}</text>
            </ActionSurface>
            <ActionSurface class="mr-answer mr-answer-right" @click="answer('right')">
              <view v-if="currentRule == 'color'" class="mr-answer-dot mr-yellow-dot tap-content"></view>
              <view v-else class="mr-answer-sym mr-sym-square tap-content"></view>
              <text class="mr-answer-label tap-content">{{ currentRule == 'color' ? '黄色' : '方形' }}</text>
            </ActionSurface>
          </view>
          <view class="mr-stats">
            <view class="mr-stat"><text class="mr-stat-value">{{ correct }}</text><text class="mr-stat-label">正确</text></view>
            <view class="mr-stat"><text class="mr-stat-value">{{ errors }}</text><text class="mr-stat-label">错误</text></view>
            <view class="mr-stat"><text class="mr-stat-value">{{ switchErrors }}</text><text class="mr-stat-label">切换错误</text></view>
          </view>
        </view>
      </view>
    </view>
  </TrainingFrame>
</template>

<script setup lang="uts">
import { timedRoundScore, scoreQuery, searchTargetMs } from '../../utils/game-scoring.uts'
const roundScores: number[] = []
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import ActionSurface from '../../components/ActionSurface.uvue'
import { ref, computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { getGameTuningAge, getGameDifficulty } from '../../utils/difficulty.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating

const level = ref(1)
const started = ref(false)
const totalRounds = ref(14)
const blockSize = ref(4)
const roundIndex = ref(0)
const currentRule = ref('color')
const stimulusColor = ref('blue')
const stimulusShape = ref('circle')
const justSwitched = ref(false)
const acceptingAnswer = ref(false)
const feedback = ref('')
const correct = ref(0)
const errors = ref(0)
const switchErrors = ref(0)
const reactions = ref([] as number[])
let appearedAt = 0
let gameStartedAt = 0
let answerTimer = 0

const displayRound = computed((): number => started.value ? Math.min(totalRounds.value, roundIndex.value + 1) : 0)
const progressWidth = computed((): string => {
  if (!started.value) return '0%'
  return Math.min(100, Math.round((roundIndex.value / totalRounds.value) * 100)).toString() + '%'
})
const stimulusColorValue = computed((): string => stimulusColor.value == 'blue' ? '#5B8DEF' : '#FFC857')

// 试玩：同一张蓝色方形先按颜色分一次，再换成按形状分一次，让孩子看见「图没变、规则变了、答案要换」。
const demoStep = ref(0)
const demoHint = ref('')
const demoRule = computed((): string => demoStep.value == 0 ? 'color' : 'shape')
// 两步用同一张蓝色方形，只有规则变，让孩子把注意力放在「规则」而不是图形上。
const demoStimulusColor = computed((): string => '#5B8DEF')
const demoDone = computed((): boolean => demoStep.value >= 2)
function demoCorrectSide(): string {
  return demoStep.value == 0 ? 'left' : 'right'
}
function resetDemo() {
  demoStep.value = 0
  demoHint.value = '现在按颜色分类，它是蓝色的'
}
function answerDemo(side: string) {
  if (trainingPaused.value || demoDone.value) return
  if (side == demoCorrectSide()) {
    demoStep.value += 1
    demoHint.value = demoStep.value == 1 ? '真棒！规则要变了，再看一次' : '太棒啦！规则变了要重新看'
  } else {
    demoHint.value = demoStep.value == 0 ? '现在按颜色分类，点「蓝色」' : '现在按形状分类，点「方形」'
  }
}

function configure() {
  level.value = getGameDifficulty('magic-rule')
  const age = getGameTuningAge('magic-rule')
  if (age <= 6) { totalRounds.value = 10; blockSize.value = 5 }
  else if (age <= 9) { totalRounds.value = 14; blockSize.value = 4 }
  else if (age <= 12) { totalRounds.value = 18; blockSize.value = 3 }
  else { totalRounds.value = 22; blockSize.value = 3 }
}

function clearTimer() { if (answerTimer > 0) trainingClock.clearTimeout(answerTimer) }
function finishGame() {
  clearTimer()
  const accuracy = Math.round((correct.value / totalRounds.value) * 100)
  const reactionTotal = reactions.value.reduce((sum: number, value: number): number => sum + value, 0)
  const average = reactions.value.length == 0 ? 0 : Math.round(reactionTotal / reactions.value.length)
  const duration = Math.max(1, Math.round((trainingClock.now() - gameStartedAt) / 1000))
  uni.redirectTo({
    url: '/pages/result/result?gameId=magic-rule&dimensionId=divided&score=' + accuracy.toString() +
      '&accuracy=' + accuracy.toString() + '&reaction=' + average.toString() + '&duration=' + duration.toString() +
      '&switchErrors=' + switchErrors.value.toString() + scoreQuery(roundScores) })
}
function prepareRound() {
  if (roundIndex.value >= totalRounds.value) {
    finishGame()
    return
  }
  justSwitched.value = roundIndex.value > 0 && roundIndex.value % blockSize.value == 0
  if (justSwitched.value) currentRule.value = currentRule.value == 'color' ? 'shape' : 'color'
  stimulusColor.value = Math.random() < 0.5 ? 'blue' : 'yellow'
  stimulusShape.value = Math.random() < 0.5 ? 'circle' : 'square'
  feedback.value = ''
  acceptingAnswer.value = true
  appearedAt = trainingClock.now()
}

function begin() {
  if (trainingPaused.value) return
  if (started.value) return
  started.value = true
  roundIndex.value = 0
  currentRule.value = 'color'
  correct.value = 0
  errors.value = 0
  switchErrors.value = 0
  feedback.value = ''
  reactions.value = [] as number[]
  roundScores.length = 0
  gameStartedAt = trainingClock.now()
  prepareRound()
}

function correctSide(): string {
  if (currentRule.value == 'color') return stimulusColor.value == 'blue' ? 'left' : 'right'
  return stimulusShape.value == 'circle' ? 'left' : 'right'
}

function answer(side: string) {
  if (trainingPaused.value) return
  if (!started.value || !acceptingAnswer.value) return
  acceptingAnswer.value = false
  roundScores.push(timedRoundScore(side == correctSide(), trainingClock.now() - appearedAt, searchTargetMs('magic-rule', getGameTuningAge('magic-rule') - 4)))
  reactions.value.push(trainingClock.now() - appearedAt)
  if (side == correctSide()) {
    { correct.value += 1; training.playFeedback('correct') }
    feedback.value = '正确'
  } else {
    { errors.value += 1; training.playFeedback('wrong') }
    if (justSwitched.value) switchErrors.value += 1
    feedback.value = '再看规则'
  }
  answerTimer = trainingClock.setTimeout(() => {
    roundIndex.value += 1
    prepareRound()
  }, 520)
}

onLoad(() => { configure(); resetDemo() })
onUnload(() => clearTimer())
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => started.value)
</script>

<style>
.mr-page { flex: 1; position: relative; background-color: #17266d; }
.mr-scene { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.mr-content { position: relative; flex: 1; padding: 18px 20px 16px; }
.mr-header { flex-direction: row; justify-content: space-between; align-items: center; }
.mr-header-right { flex-direction: row; align-items: center; }
.mr-eyebrow { color: #dbe8ff; font-size: 12px; font-weight: 700; }
.mr-title { margin-top: 4px; color: #ffffff; font-size: 21px; font-weight: 700; }
.mr-level { margin-right: 8px; height: 38px; padding: 0 12px; border-radius: 19px; background-color: rgba(255, 255, 255, 0.92); align-items: center; justify-content: center; }
.mr-level-text { color: #8062bf; font-size: 12px; font-weight: 700; }
.mr-counter { width: 62px; height: 38px; border-radius: 19px; background-color: rgba(255, 255, 255, 0.92); align-items: center; justify-content: center; }
.mr-counter-text { color: #785bb7; font-size: 13px; font-weight: 700; }
.mr-progress { margin-top: 16px; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.65); overflow: hidden; }
.mr-progress-fill { height: 8px; border-radius: 4px; background-color: #9b7ede; }
.mr-intro { margin-top: 18px; align-items: center; }
.mr-demo-title { color: #1f2a44; font-size: 18px; font-weight: 700; }
.mr-demo-hint { margin-top: 8px; color: #69758d; font-size: 13px; text-align: center; }
.mr-rule-card { margin-top: 14px; width: 100%; padding: 15px 17px; border-radius: 20px; position: relative; }
.mr-rule-color { background-color: rgba(234, 240, 255, 0.95); }
.mr-rule-shape { background-color: rgba(240, 234, 250, 0.95); }
.mr-rule-title { color: #37435c; font-size: 17px; font-weight: 700; }
.mr-switch-badge { position: absolute; right: 12px; top: 16px; padding: 5px 10px; border-radius: 12px; background-color: #fff2cc; color: #a4730d; font-size: 10px; font-weight: 700; }
.mr-stage { margin-top: 12px; width: 100%; height: 190px; border-radius: 24px; background-color: rgba(255, 255, 255, 0.92); align-items: center; justify-content: center; }
.mr-stim { width: 96px; height: 96px; }
.mr-stim-circle { border-radius: 48px; }
.mr-stim-square { border-radius: 18px; transform: rotate(8deg); }
.mr-feedback { margin-top: 8px; height: 24px; align-items: center; justify-content: center; }
.mr-good { color: #338e72; font-size: 13px; font-weight: 700; }
.mr-again { color: #c65b66; font-size: 13px; font-weight: 700; }
.mr-answer-row { margin-top: 10px; width: 100%; flex-direction: row; }
.mr-answer { flex: 1; height: 64px; border-radius: 19px; background-color: rgba(255, 255, 255, 0.95); flex-direction: row; align-items: center; justify-content: center; }
.mr-answer-left { margin-right: 6px; }
.mr-answer-right { margin-left: 6px; }
.mr-answer-label { margin-left: 8px; color: #3d485f; font-size: 14px; font-weight: 700; }
.mr-answer-dot { width: 23px; height: 23px; border-radius: 12px; }
.mr-answer-sym { width: 23px; height: 23px; }
.mr-blue-dot { background-color: #5b8def; }
.mr-yellow-dot { background-color: #ffc857; }
.mr-sym-circle { border-radius: 12px; background-color: #9b7ede; }
.mr-sym-square { border-radius: 5px; background-color: #9b7ede; }
.mr-demo-replay { margin-top: 12px; padding: 8px 16px; color: #785bb7; font-size: 13px; font-weight: 700; }
.mr-start { margin-top: 12px; width: 200px; height: 50px; line-height: 50px; border-radius: 25px; background-color: #9b7ede; color: #ffffff; font-size: 17px; font-weight: 700; }
.mr-stats { margin-top: 14px; width: 100%; padding: 12px 8px; border-radius: 20px; background-color: rgba(255, 255, 255, 0.92); flex-direction: row; }
.mr-stat { flex: 1; align-items: center; }
.mr-stat-value { color: #25314a; font-size: 18px; font-weight: 700; }
.mr-stat-label { margin-top: 3px; color: #8a93a7; font-size: 10px; }

/* Shared preview palette: breathing-planet. Keep gameplay geometry unchanged. */
.training-preview-card { border-radius: 30px; background-color: rgba(255,255,255,0.65); }
.training-preview-primary { width: 200px; height: 50px; line-height: 50px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 25px; background-color: #8d9bdb; color: #ffffff; font-size: 17px; font-weight: 700; text-align: center; }
.training-preview-secondary { width: 200px; height: 42px; line-height: 42px; padding: 0; margin-left: auto; margin-right: auto; border-width: 0; border-radius: 21px; background-color: rgba(255,255,255,0.6); color: #7584b5; font-size: 14px; text-align: center; }
</style>
