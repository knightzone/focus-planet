<template>
<TrainingFrame :title="gameName" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
  <view class="page">
    <image class="scene tap-content" src="/static/images/runtime/backgrounds/shadow-match-desk-v1.webp" mode="aspectFill"></image>
    <scroll-view class="scroll" direction="vertical" show-scrollbar="false"><view class="content">
      <view class="header"><view><text class="dimension">{{ mode == 'spot-change' ? '双星观察室' : dimensionLabel }}</text><text class="title">{{ started ? missionTitle : gameName }}</text></view><text class="counter-value">{{ started ? displayRound + ' / ' + totalRounds : '难度 ' + scoringLevel }}</text></view>
      <view class="progress"><view class="progress-fill" :style="{ width: progressWidth, backgroundColor: accentColor }"></view></view>
      <view v-if="!started" class="instruction">
        <image v-if="mode == 'spot-change'" class="cover tap-content" src="/static/images/runtime/level-thumbnails/spot-change.webp" mode="aspectFill"></image>
        <view class="intro-body">
          <template v-if="mode == 'spot-change'">
            <text class="intro-title">谁悄悄变了？</text>
            <view class="example">
              <view class="example-side"><text class="example-label">先看</text><view class="example-grid"><view v-for="(symbol, index) in demoBefore" :key="index" class="example-cell"><image class="example-image tap-content" :src="objectPath(symbol)" mode="aspectFit"></image></view></view></view>
              <text class="arrow">→</text>
              <view class="example-side"><text class="example-label">再找</text><view class="example-grid"><view v-for="(symbol, index) in demoAfter" :key="index" class="example-cell" :class="index == 2 ? 'example-changed' : ''"><image class="example-image tap-content" :src="objectPath(symbol)" mode="aspectFit"></image></view></view></view>
            </view>
          </template>
          <template v-else-if="mode == 'symbol-detective'">
            <image class="detective-star tap-content" src="/static/images/runtime/brand/focus-star-solo-v1.webp" mode="aspectFit"></image>
            <text class="intro-title">谁和大家不一样？</text>
            <view class="detective-demo"><view v-for="(symbol, index) in detectiveDemo" :key="index" class="detective-demo-cell" :class="demoFound && index == 2 ? 'cell-correct' : ''" @click="tryDetective(index)"><image class="detective-demo-image tap-content" :src="objectPath(symbol)" mode="aspectFit"></image></view></view>
            <text class="demo-feedback">{{ demoFeedback }}</text>
          </template>
          <YoungChildCue v-else :kind="mode == 'memory-search' ? 'search' : 'match'"></YoungChildCue>
          <button class="primary" :class="mode == 'symbol-detective' ? 'detective-primary' : ''" @click="begin">开始训练</button>
        </view>
      </view>
      <view v-else class="board-wrap" :class="mode == 'symbol-detective' ? 'detective-board' : ''">
        <view class="phase-bar"><text class="phase-label">{{ phase == 'preview' ? '看一看，记住它' : phase == 'mask' ? '藏起来啦…' : feedback != '' ? feedback : mode == 'symbol-detective' ? '找齐不同的图案' : '点一点，找到它' }}</text><text class="phase-detail">{{ mode == 'symbol-detective' ? foundIndices.length + ' / ' + oddCount : phase == 'search' && accepting ? '目标 ' + answerTargetMs / 1000 + ' 秒' : '' }}</text></view>
        <view v-if="phase == 'preview' && mode == 'memory-search'" class="preview-mask"><image class="preview-target tap-content" :src="objectPath(targetSymbol)" mode="aspectFit"></image></view>
        <view v-else-if="phase == 'mask'" class="preview-mask"><image class="mask-star tap-content" src="/static/images/runtime/brand/focus-star-solo-v1.webp" mode="aspectFit"></image></view>
        <view v-else class="board-stage">
          <view class="board"><view v-for="(symbol, index) in board" :key="index" class="cell" :class="(mode == 'symbol-detective' ? foundIndices.indexOf(index) >= 0 ? 'cell-correct' : wrongIndices.indexOf(index) >= 0 ? 'cell-wrong' : '' : feedback != '' && index == answerIndex ? 'cell-correct' : '') + (mode == 'symbol-detective' ? ' detective-cell' : '')" :style="{ width: ((mode == 'symbol-detective' ? 90 : 84) / columns) + '%', height: columns >= 7 ? '40px' : columns == 6 ? '46px' : columns == 5 ? '54px' : columns == 2 ? '104px' : columns == 3 ? '84px' : '68px' }" @click="choose(index)"><text v-if="mode == 'symbol-detective' && foundIndices.indexOf(index) >= 0" class="found-check">✓</text><image v-else :class="'cell-image tap-content' + (mode == 'symbol-detective' ? ' detective-cell-image' : '')" :src="objectPath(symbol)" mode="aspectFit"></image></view></view>
        </view>
      </view>
      <text v-if="started" class="footer">已找到 {{ mode == 'symbol-detective' ? totalFound : correct }} 个</text>
    </view></scroll-view>
  </view>
</TrainingFrame>
</template>

<script setup lang="uts">
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import { ref, computed } from 'vue'
import YoungChildCue from '../../components/YoungChildCue.uvue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { getGameDifficulty, getGameTuningAge } from '../../utils/difficulty.uts'
import { getGameName } from '../../utils/catalog.uts'
import { GAME_OBJECT_IDS, getGameObjectPath } from '../../utils/game-assets.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating


import { spotChangePool, spotChangeBoard } from '../../utils/spot-change-assets.uts'
import { spotChangeConfig } from '../../utils/spot-change.uts'
import { timedRoundScore, scoreQuery, searchTargetMs } from '../../utils/game-scoring.uts'
const roundScores: number[] = []
const scoringLevel = ref(1), columns = ref(4), answerTargetMs = ref(9000)
const demoPool = spotChangePool(1, 0, 0)
const demoBefore = [demoPool[0], demoPool[1], demoPool[2], demoPool[3]]
const demoAfter = [demoPool[0], demoPool[1], demoPool[4], demoPool[3]]
const detectiveDemo = [demoPool[0], demoPool[0], demoPool[1], demoPool[0]]
const demoFound = ref(false), demoFeedback = ref('可以先点一点')
const oddCount = ref(1), totalFound = ref(0), foundIndices = ref([] as number[]), wrongIndices = ref([] as number[])
let targetIndices: number[] = []
const assetSeed = Math.floor(Math.random() * 120)
let roundSymbols: string[] = []
const SYMBOLS = GAME_OBJECT_IDS
const mode = ref('spot-change'), gameName = ref('找出变化'), dimensionId = ref('sustained')
const started = ref(false), phase = ref('search'), totalRounds = ref(4), gridSize = ref(9), previewDuration = ref(2200), roundIndex = ref(0)
const board = ref([] as string[]), originalBoard = ref([] as string[]), targetSymbol = ref('bunny'), answerIndex = ref(0)
const accepting = ref(false), feedback = ref(''), correct = ref(0), errors = ref(0), reactions = ref([] as number[])
let shownAt = 0, gameStartedAt = 0, phaseTimer = 0, nextTimer = 0
const displayRound = computed((): number => started.value ? Math.min(totalRounds.value, roundIndex.value + 1) : 0)
const progressWidth = computed((): string => started.value ? Math.round((roundIndex.value / totalRounds.value) * 100).toString() + '%' : '0%')
const dimensionLabel = computed((): string => mode.value == 'spot-change' ? '持续注意训练' : mode.value == 'symbol-detective' ? '选择注意训练' : '分配注意训练')
const accentColor = computed((): string => mode.value == 'spot-change' ? '#55C9A5' : mode.value == 'symbol-detective' ? '#FFC857' : '#F17C8D')
const missionTitle = computed((): string => mode.value == 'spot-change' ? '找出变化的位置' : mode.value == 'symbol-detective' ? '找出不一样的' : '找到记住的伙伴')
const missionTip = computed((): string => phase.value == 'preview' ? '请认真观察' : '点击你认为正确的位置')
const introCopy = computed((): string => mode.value == 'spot-change' ? '卡通网格会短暂展示，随后一个位置发生变化。' : mode.value == 'symbol-detective' ? '找齐和大多数不一样的图案。' : '先记住卡通目标，再搜索目标并忽略其他物体。')
const reactionLabel = computed((): string => { if (reactions.value.length == 0) return '--'; const sum = reactions.value.reduce((a: number, b: number): number => a + b, 0); return Math.round(sum / reactions.value.length).toString() + 'ms' })
function objectPath(id: string): string { return id.startsWith('/static/') ? id : getGameObjectPath(id) }

function configureDifficulty() { scoringLevel.value = getGameDifficulty(mode.value); if (mode.value == 'spot-change') { const c = spotChangeConfig(scoringLevel.value); totalRounds.value = c.rounds; gridSize.value = c.cells; columns.value = c.columns; previewDuration.value = c.previewMs; answerTargetMs.value = c.targetMs; return }; answerTargetMs.value = searchTargetMs(mode.value, scoringLevel.value); const age = getGameTuningAge(mode.value); if (age <= 6) { totalRounds.value = 3; gridSize.value = 9; previewDuration.value = 2200 } else if (age <= 9) { totalRounds.value = 4; gridSize.value = 12; previewDuration.value = 2400 } else if (age <= 12) { totalRounds.value = 5; gridSize.value = 16; previewDuration.value = 2800 } else { totalRounds.value = 6; gridSize.value = 20; previewDuration.value = 3200 } }
function randomSymbol(except: string): string { const pool = mode.value != 'memory-search' ? roundSymbols : SYMBOLS; let value = pool[Math.floor(Math.random() * pool.length)]; while (value == except) value = pool[Math.floor(Math.random() * pool.length)]; return value }
function tryDetective(index: number) {
  if (trainingPaused.value || started.value || demoFound.value) return
  demoFound.value = index == 2
  demoFeedback.value = demoFound.value ? '找到啦！' : '再看看哪一个不一样'
  training.playFeedback(demoFound.value ? 'correct' : 'wrong')
}
function shuffle(values: string[]): string[] { const result = values.slice(); for (let i = result.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const v = result[i]; result[i] = result[j]; result[j] = v } return result }
function clearTimers() { if (phaseTimer > 0) trainingClock.clearTimeout(phaseTimer); if (nextTimer > 0) trainingClock.clearTimeout(nextTimer) }
function finish() { clearTimers(); const accuracy = mode.value == 'symbol-detective' ? Math.round(totalFound.value * 100 / Math.max(1, totalFound.value + errors.value)) : Math.round((correct.value / totalRounds.value) * 100); const sum = reactions.value.reduce((a: number, b: number): number => a + b, 0); const average = reactions.value.length == 0 ? 0 : Math.round(sum / reactions.value.length); const duration = Math.max(1, Math.round((trainingClock.now() - gameStartedAt) / 1000)); uni.redirectTo({ url: '/pages/result/result?gameId=' + mode.value + '&dimensionId=' + dimensionId.value + '&score=' + accuracy.toString() + '&accuracy=' + accuracy.toString() + '&reaction=' + average.toString() + '&duration=' + duration.toString() + scoreQuery(roundScores) }) }
function prepare() {
  if (roundIndex.value >= totalRounds.value) { finish(); return }
  feedback.value = ''; accepting.value = false
  if (mode.value == 'symbol-detective') {
    const levelIndex = Math.max(0, Math.min(9, scoringLevel.value - 1))
    gridSize.value = [9,12,16,20,25,30,36,42,48,48][levelIndex]
    oddCount.value = [1,2,2,3,3,4,5,6,7,8][levelIndex]
    columns.value = [3,3,4,4,5,5,6,6,6,6][levelIndex]
    answerTargetMs.value = searchTargetMs(mode.value, scoringLevel.value) * oddCount.value
    foundIndices.value = []; wrongIndices.value = []; targetIndices = []
    roundSymbols = spotChangePool(scoringLevel.value, roundIndex.value, assetSeed)
    const common = roundSymbols[Math.floor(Math.random() * roundSymbols.length)]; targetSymbol.value = randomSymbol(common); answerIndex.value = Math.floor(Math.random() * gridSize.value)
    const values = [] as string[]; for (let i = 0; i < gridSize.value; i++) values.push(i < oddCount.value ? randomSymbol(common) : common)
    board.value = shuffle(values)
    for (let i = 0; i < board.value.length; i++) { if (board.value[i] != common) targetIndices.push(i) }
    answerIndex.value = targetIndices[0]; phase.value = 'search'; accepting.value = true; shownAt = trainingClock.now()
  } else if (mode.value == 'memory-search') {
    targetSymbol.value = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)]; phase.value = 'preview'
    phaseTimer = trainingClock.setTimeout(() => { const values = [] as string[]; values.push(targetSymbol.value); while (values.length < gridSize.value) values.push(randomSymbol(targetSymbol.value)); board.value = shuffle(values); answerIndex.value = board.value.indexOf(targetSymbol.value); phase.value = 'search'; accepting.value = true; shownAt = trainingClock.now() }, 1100)
  } else {
    roundSymbols = spotChangePool(scoringLevel.value, roundIndex.value, assetSeed)
    const values = spotChangeBoard(roundSymbols, gridSize.value); originalBoard.value = values; board.value = values.slice(); phase.value = 'preview'
    phaseTimer = trainingClock.setTimeout(() => {
      phase.value = 'mask'
      phaseTimer = trainingClock.setTimeout(() => {
        answerIndex.value = Math.floor(Math.random() * gridSize.value)
        const changed = originalBoard.value.slice(); changed[answerIndex.value] = randomSymbol(changed[answerIndex.value])
        board.value = changed; phase.value = 'search'; accepting.value = true; shownAt = trainingClock.now()
        phaseTimer = trainingClock.setTimeout(() => {
          if (!accepting.value) return
          accepting.value = false; { errors.value += 1; training.playFeedback('missed') } roundScores.push(0); feedback.value = '下一轮再试'
          nextTimer = trainingClock.setTimeout(() => { roundIndex.value += 1; prepare() }, 520)
        }, answerTargetMs.value * 2)
      }, 500)
    }, previewDuration.value)
  }
}
function begin() { if (trainingPaused.value) return; if (started.value) return; started.value = true; gameStartedAt = trainingClock.now(); prepare() }
function chooseDetective(index: number) {
  if (index < 0 || index >= board.value.length || foundIndices.value.indexOf(index) >= 0 || wrongIndices.value.indexOf(index) >= 0) return
  if (targetIndices.indexOf(index) < 0) {
    wrongIndices.value.push(index); errors.value += 1; training.playFeedback('wrong'); feedback.value = '再看看'; return
  }
  foundIndices.value.push(index); totalFound.value += 1; training.playFeedback('correct'); feedback.value = ''
  if (foundIndices.value.length < oddCount.value) return
  accepting.value = false; correct.value += 1; feedback.value = '找齐啦！'
  const elapsed = trainingClock.now() - shownAt
  reactions.value.push(elapsed)
  roundScores.push(Math.round(timedRoundScore(true, elapsed, answerTargetMs.value) * oddCount.value / (oddCount.value + wrongIndices.value.length)))
  nextTimer = trainingClock.setTimeout(() => { roundIndex.value += 1; prepare() }, 520)
}
function choose(index: number) { if (trainingPaused.value) return; if (!accepting.value) return; if (mode.value == 'symbol-detective') { chooseDetective(index); return }; accepting.value = false; if (phaseTimer > 0) trainingClock.clearTimeout(phaseTimer); roundScores.push(timedRoundScore(index == answerIndex.value, trainingClock.now() - shownAt, answerTargetMs.value)); reactions.value.push(trainingClock.now() - shownAt); if (index == answerIndex.value) { { correct.value += 1; training.playFeedback('correct') } feedback.value = '正确' } else { { errors.value += 1; training.playFeedback('wrong') } feedback.value = '再仔细观察' }; nextTimer = trainingClock.setTimeout(() => { roundIndex.value += 1; prepare() }, 520) }
onLoad((options: UTSJSONObject) => { const option = options['gameId']; mode.value = option == null || option == '' ? 'spot-change' : option as string; gameName.value = getGameName(mode.value); dimensionId.value = mode.value == 'spot-change' ? 'sustained' : mode.value == 'symbol-detective' ? 'selective' : 'divided'; configureDifficulty() })
onUnload(() => clearTimers())
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => started.value)
</script>

<style>
.detective-star { width: 56px; height: 56px; margin-bottom: 12px; }
.detective-demo { width: 100%; margin-top: 18px; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.detective-demo-cell { width: 43%; height: 106px; margin: 5px; border-radius: 20px; border-width: 2px; border-color: #eee4cc; background-color: #fffaf0; align-items: center; justify-content: center; }
.detective-demo-image { width: 88px; height: 88px; }
.demo-feedback { margin-top: 12px; color: #819080; font-size: 13px; }
.page { flex: 1; position: relative; background-color: #e9e1d0; }.scene { position: absolute; width: 100%; height: 100%; }.scroll { flex: 1; position: relative; }.content { padding: 20px 18px 30px; }
.header { flex-direction: row; align-items: center; justify-content: space-between; }.dimension { color: #797960; font-size: 12px; }.title { margin-top: 6px; color: #465849; font-size: 23px; font-weight: 700; }.counter-value { padding: 9px 12px; border-radius: 18px; background-color: rgba(255,255,255,0.8); color: #70816f; font-size: 12px; }.progress { margin-top: 16px; height: 5px; border-radius: 3px; background-color: rgba(255,255,255,0.65); overflow: hidden; }.progress-fill { height: 5px; border-radius: 3px; }
.instruction { margin-top: 20px; border-radius: 28px; background-color: rgba(255,255,255,0.88); overflow: hidden; }.cover { width: 100%; height: 155px; }.intro-body { padding: 22px 16px 26px; align-items: center; }.intro-title { color: #465849; font-size: 21px; font-weight: 700; }.example { margin-top: 18px; width: 100%; flex-direction: row; align-items: center; }.example-side { flex: 1; align-items: center; }.example-label { color: #8a957f; font-size: 12px; margin-bottom: 8px; }.example-grid { width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; }.example-cell { width: 44%; height: 56px; margin: 2px; border-radius: 12px; background-color: #f5f5ed; border-width: 2px; border-color: transparent; align-items: center; justify-content: center; overflow: hidden; }.example-changed { border-color: #67b599; background-color: #e6f3e9; }.example-image { width: 46px; height: 46px; }.arrow { padding: 0 5px; color: #b4aa84; font-size: 22px; }.primary { margin-top: 23px; width: 200px; height: 50px; line-height: 50px; border-width: 0; border-radius: 25px; background-color: #69b39a; color: #ffffff; font-size: 17px; font-weight: 700; }
.board-wrap { margin-top: 20px; padding: 18px 5px 22px; min-height: 400px; border-radius: 28px; background-color: rgba(255,255,255,0.88); }.phase-bar { padding: 0 13px 15px; flex-direction: row; align-items: center; justify-content: space-between; }.phase-label { color: #5c7661; font-size: 16px; font-weight: 700; }.phase-detail { color: #99a18e; font-size: 11px; }.preview-mask { flex: 1; min-height: 300px; align-items: center; justify-content: center; }.preview-target { width: 124px; height: 124px; border-radius: 22px; }.mask-star { width: 72px; height: 72px; opacity: 0.55; }.board-stage { width: 100%; flex: 1; justify-content: center; align-items: center; }.board { padding: 8px 0; width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; }.cell { margin: 4px; border-radius: 15px; background-color: #f3f5ee; border-width: 2px; border-color: #e9eddf; align-items: center; justify-content: center; overflow: hidden; }.cell-correct { border-color: #67b599; background-color: #e4f2e7; }.cell-image { width: 86%; height: 86%; border-radius: 11px; }.footer { margin-top: 18px; text-align: center; color: #77866e; font-size: 12px; }
/* 侦探模式扁平覆盖类：元素同时挂基础类与下列类，靠源序覆盖，兼容样式隔离 2.0 */
.detective-board { background-color: rgba(255,255,255,0.9); }
.detective-cell { margin: 2px; border-radius: 10px; background-color: #fffaf0; border-color: #eee4cc; }
.cell-correct { background-color: #e4f2e7; border-color: #67b599; }
.cell-wrong { background-color: #f9e9e4; border-color: #d3a39a; }
.detective-primary { background-color: #c18b38; }
.found-check { color: #2b9270; font-size: 20px; font-weight: 800; }
</style>
