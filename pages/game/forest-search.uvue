<template>
  <TrainingFrame title="森林寻宝" @back="training.back()" :paused="trainingPaused" :busy="trainingBusy" @pause="training.pause()" @resume="training.resume()" @restart="training.restart()" @exit="training.exit()">
    <view class="page">
      <image class="scene" src="/static/images/runtime/backgrounds/firefly-night-forest-v1.webp" mode="aspectFill"></image>
      <view class="content">
        <view class="header">
          <view><text class="eyebrow">选择注意训练</text><text class="title">森林寻宝</text></view>
          <view class="counter"><text class="counter-text">{{ displayRound }}/{{ totalRounds }}</text></view>
        </view>
        <view class="progress"><view class="progress-fill" :style="{ width: progressWidth }"></view></view>

        <view v-if="!started" class="instruction">
          <text class="demo-title">先试一下</text>
          <view class="demo-target-row">
            <text class="demo-target-label">找到和它一样的 2 个</text>
            <image class="demo-target-icon tap-content" :src="DEMO_TARGET" mode="aspectFit"></image>
          </view>
          <view class="demo-board">
            <view v-for="(item, index) in demoBoard" :key="'demo-' + index" class="demo-card" :class="demoFound.indexOf(index) >= 0 ? 'demo-found' : demoWrong == index ? 'demo-wrong' : ''" @click="pickDemo(index)">
              <text v-if="demoFound.indexOf(index) >= 0" class="demo-check">✓</text>
              <image v-else class="demo-image tap-content" :src="item" mode="aspectFit"></image>
            </view>
          </view>
          <text class="demo-hint">{{ demoHint }}</text>
          <text v-if="demoDone" class="demo-replay" @click="resetDemo">再试一次</text>
          <button class="primary" @click="begin">开始</button>
        </view>

        <template v-else>
          <view class="mission-card">
            <text class="mission-label">本轮目标</text>
            <view class="mission-row"><image class="mission-icon" :src="objectPath(targetItem)" mode="aspectFit"></image><text class="mission-text">还要找到 {{ remaining }} 个</text></view>
          </view>
          <view class="search-board">
            <view v-for="(item, index) in board" :key="index" class="object-card" :class="foundIndexes.indexOf(index) >= 0 ? 'object-found' : ''" @click="choose(item, index)">
              <text v-if="foundIndexes.indexOf(index) >= 0" class="found-symbol">✓</text>
              <image v-else class="object-image" :src="objectPath(item)" mode="aspectFit"></image>
            </view>
          </view>
        </template>

        <view class="feedback"><text v-if="feedback != ''" :class="feedback == '找到了' ? 'good' : 'again'">{{ feedback }}</text></view>
        <view class="stats">
          <view class="stat"><text class="value">{{ foundTotal }}</text><text class="label">找到</text></view>
          <view class="stat"><text class="value">{{ errors }}</text><text class="label">误点</text></view>
          <view class="stat"><text class="value">{{ reactionLabel }}</text><text class="label">平均发现</text></view>
        </view>
      </view>
    </view>
  </TrainingFrame>
</template>

<script setup lang="uts">
import { timedRoundScore, scoreQuery, searchTargetMs } from '../../utils/game-scoring.uts'
const roundScores: number[] = []
import TrainingFrame from '../../components/TrainingFrame.uvue'
import { useTrainingSession } from '../../utils/training-session.uts'
import { ref, computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { getGameDifficulty, getGameTuningAge } from '../../utils/difficulty.uts'
import { getGameObjectPath } from '../../utils/game-assets.uts'
import { spotChangePool } from '../../utils/spot-change-assets.uts'
const training = useTrainingSession()
const trainingClock = training.clock
const trainingPaused = training.paused, trainingBusy = training.navigating


const started = ref(false)
const level = ref(1)
const totalRounds = ref(4)
const boardSize = ref(12)
const targetPerRound = ref(3)
const roundIndex = ref(0)
const targetItem = ref('bunny')
const board = ref([] as string[])
const foundIndexes = ref([] as number[])
const remaining = ref(0)
const foundTotal = ref(0)
const errors = ref(0)
const feedback = ref('')
const reactions = ref([] as number[])
const assetSeed = Math.floor(Math.random() * 120)
let scoreRoundBegan = 0, scoreRoundErrors = 0
let roundStartedAt = 0
let gameStartedAt = 0
let nextTimer = 0

// 试玩演示：同一水果组里藏 2 个目标，点齐即完成；不计时、不计分。
const DEMO_TARGET = '/static/images/runtime/illustrations/shadow-match/easy-fruits/apple.webp'
const DEMO_OTHERS = [
  '/static/images/runtime/illustrations/shadow-match/easy-fruits/banana.webp',
  '/static/images/runtime/illustrations/shadow-match/easy-fruits/pineapple.webp',
  '/static/images/runtime/illustrations/shadow-match/easy-fruits/strawberry.webp',
  '/static/images/runtime/illustrations/shadow-match/easy-fruits/grapes.webp'
]
const demoBoard = ref([] as string[])
const demoFound = ref([] as number[])
const demoWrong = ref(-1)
const demoDone = computed((): boolean => demoFound.value.length >= 2)
const demoHint = computed((): string => {
  if (demoDone.value) return '找对啦！'
  if (demoWrong.value >= 0) return '这个不是目标，再看看'
  if (demoFound.value.length == 1) return '还剩 1 个'
  return '点一点和它一样的图案'
})
function setupDemo() {
  demoBoard.value = shuffled(DEMO_OTHERS.slice())
  demoBoard.value.splice(Math.floor(Math.random() * (demoBoard.value.length + 1)), 0, DEMO_TARGET)
  demoBoard.value.splice(Math.floor(Math.random() * (demoBoard.value.length + 1)), 0, DEMO_TARGET)
  demoFound.value = [] as number[]; demoWrong.value = -1
}
function pickDemo(index: number) { if (trainingPaused.value || demoDone.value || demoFound.value.indexOf(index) >= 0) return
  if (demoBoard.value[index] == DEMO_TARGET) { demoFound.value.push(index); demoWrong.value = -1 } else { demoWrong.value = index } }
function resetDemo() { if (trainingPaused.value) return; setupDemo() }

const displayRound = computed((): number => started.value ? Math.min(totalRounds.value, roundIndex.value + 1) : 0)
const progressWidth = computed((): string => started.value ? Math.round((roundIndex.value / totalRounds.value) * 100).toString() + '%' : '0%')
const reactionLabel = computed((): string => {
  if (reactions.value.length == 0) return '--'
  const total = reactions.value.reduce((sum: number, value: number): number => sum + value, 0)
  return Math.round(total / reactions.value.length).toString() + 'ms'
})
function objectPath(item: string): string { return item.startsWith('/static/') ? item : getGameObjectPath(item) }

function configureDifficulty() {
  level.value = getGameDifficulty('forest-search')
  const age = getGameTuningAge('forest-search')
  if (age <= 6) { totalRounds.value = 3; boardSize.value = 9; targetPerRound.value = 2 }
  else if (age <= 9) { totalRounds.value = 4; boardSize.value = 12; targetPerRound.value = 3 }
  else if (age <= 12) { totalRounds.value = 5; boardSize.value = 16; targetPerRound.value = 3 }
  else { totalRounds.value = 6; boardSize.value = 20; targetPerRound.value = 4 }
}
function shuffled(values: string[]): string[] {
  const result = values.slice()
  for (let i = result.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const v = result[i]; result[i] = result[j]; result[j] = v }
  return result
}
function clearTimer() { if (nextTimer > 0) trainingClock.clearTimeout(nextTimer) }
function finishGame() {
  clearTimer()
  const accuracy = Math.round((foundTotal.value / Math.max(1, foundTotal.value + errors.value)) * 100)
  const reactionTotal = reactions.value.reduce((sum: number, value: number): number => sum + value, 0)
  const average = reactions.value.length == 0 ? 0 : Math.round(reactionTotal / reactions.value.length)
  const duration = Math.max(1, Math.round((trainingClock.now() - gameStartedAt) / 1000))
  uni.redirectTo({ url: '/pages/result/result?gameId=forest-search&dimensionId=selective&score=' + accuracy.toString() + '&accuracy=' + accuracy.toString() + '&reaction=' + average.toString() + '&duration=' + duration.toString() + scoreQuery(roundScores) })
}
function prepareRound() {
  if (roundIndex.value >= totalRounds.value) { finishGame(); return }
  const pool = spotChangePool(level.value, roundIndex.value, assetSeed)
  targetItem.value = pool[Math.floor(Math.random() * pool.length)]
  const distractors = pool.filter((item: string): boolean => item != targetItem.value)
  const values = [] as string[]
  for (let i = 0; i < targetPerRound.value; i++) values.push(targetItem.value)
  while (values.length < boardSize.value) values.push(distractors[Math.floor(Math.random() * distractors.length)])
  board.value = shuffled(values); foundIndexes.value = [] as number[]; remaining.value = targetPerRound.value
  feedback.value = ''; roundStartedAt = trainingClock.now(); scoreRoundBegan = roundStartedAt; scoreRoundErrors = errors.value
}
function begin() { if (trainingPaused.value) return; started.value = true; gameStartedAt = trainingClock.now(); prepareRound() }
function choose(item: string, index: number) { if (trainingPaused.value) return;
  if (!started.value || remaining.value <= 0 || foundIndexes.value.indexOf(index) >= 0) return
  if (item == targetItem.value) {
    foundIndexes.value.push(index); remaining.value -= 1; { foundTotal.value += 1; training.playFeedback('correct') } feedback.value = '找到了'
    reactions.value.push(trainingClock.now() - roundStartedAt); roundStartedAt = trainingClock.now()
    if (remaining.value == 0) { roundScores.push(timedRoundScore(true, trainingClock.now() - scoreRoundBegan, searchTargetMs('forest-search', getGameTuningAge('forest-search') - 4) * targetPerRound.value, errors.value - scoreRoundErrors)); nextTimer = trainingClock.setTimeout(() => { roundIndex.value += 1; prepareRound() }, 500) }
  } else { { errors.value += 1; training.playFeedback('wrong') } feedback.value = '这不是目标' }
}
onLoad((_options: OnLoadOptions) => { configureDifficulty(); setupDemo() }); onUnload(() => clearTimer())
// 准备/试玩阶段直接返回；进入正式训练后才拦截返回。
training.setStartedCheck((): boolean => started.value)
</script>

<style>
.page { flex: 1; background-color: #0f2a1e; }
.scene { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.content { position: relative; flex: 1; padding: 18px 18px 20px; }
.header { flex-direction: row; justify-content: space-between; align-items: center; }.eyebrow { color: #b9ddc6; font-size: 12px; font-weight: 700; }.title { margin-top: 4px; color: #ffffff; font-size: 21px; font-weight: 700; }
.counter { min-width: 64px; height: 38px; padding: 0 12px; border-radius: 19px; background-color: rgba(255,255,255,0.92); align-items: center; justify-content: center; }.counter-text { color: #2c6e4f; font-size: 13px; font-weight: 700; }
.progress { margin-top: 16px; height: 8px; border-radius: 4px; background-color: rgba(255,255,255,0.32); overflow: hidden; }.progress-fill { height: 8px; border-radius: 4px; background-color: #ffd66b; }
.instruction { margin-top: 16px; padding: 22px 18px 20px; border-radius: 25px; background-color: rgba(255,255,255,0.95); align-items: center; }.demo-title { color: #344059; font-size: 18px; font-weight: 700; }
.demo-target-row { margin-top: 14px; flex-direction: row; align-items: center; }.demo-target-label { color: #5f6b52; font-size: 13px; font-weight: 700; }.demo-target-icon { margin-left: 10px; width: 44px; height: 44px; border-radius: 12px; background-color: #f2f7ee; }
.demo-board { margin-top: 14px; width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; }.demo-card { margin: 4px; width: 28%; height: 84px; border-radius: 16px; background-color: #ffffff; border-width: 2px; border-color: #e2e8d8; align-items: center; justify-content: center; overflow: hidden; }.demo-image { width: 64px; height: 64px; border-radius: 12px; }
.demo-found { background-color: #ddf3e7; border-color: #55c9a5; }.demo-wrong { background-color: #fdeef0; border-color: #f17c8d; }.demo-check { color: #2b9270; font-size: 24px; font-weight: 800; }
.demo-hint { margin-top: 12px; color: #8a967e; font-size: 12px; }.demo-replay { margin-top: 6px; padding: 8px 16px; color: #3f9a6d; font-size: 12px; font-weight: 700; }
.primary { margin-top: 12px; width: 150px; height: 48px; line-height: 48px; border-radius: 15px; background-color: #3f9a6d; color: #ffffff; font-size: 14px; font-weight: 700; }
.mission-card { margin-top: 14px; padding: 14px 18px; border-radius: 20px; background-color: rgba(255,255,255,0.92); }.mission-label { color: #718b82; font-size: 10px; }.mission-row { margin-top: 4px; flex-direction: row; align-items: center; }.mission-icon { width: 44px; height: 44px; border-radius: 11px; background-color: #f2f7ee; }.mission-text { margin-left: 12px; color: #3e6257; font-size: 14px; font-weight: 700; }
.search-board { margin-top: 14px; padding: 10px 6px; border-radius: 24px; background-color: rgba(7,30,20,0.5); flex-direction: row; flex-wrap: wrap; justify-content: center; }.object-card { margin: 4px; width: 20%; height: 66px; border-radius: 14px; background-color: rgba(255,255,255,0.97); align-items: center; justify-content: center; overflow: hidden; }.object-image { width: 56px; height: 56px; border-radius: 10px; }
.object-found { background-color: #d8f3e5; }.found-symbol { color: #2b9270; font-size: 22px; font-weight: 800; }
.feedback { height: 34px; align-items: center; justify-content: center; }.good { color: #9df0c6; font-size: 12px; font-weight: 700; }.again { color: #ffc9b8; font-size: 12px; font-weight: 700; }
.stats { margin-top: 2px; padding: 12px 8px; border-radius: 18px; background-color: rgba(255,255,255,0.92); flex-direction: row; }.stat { flex: 1; align-items: center; }.value { color: #25314a; font-size: 17px; font-weight: 700; }.label { margin-top: 3px; color: #8a93a7; font-size: 10px; }
</style>
