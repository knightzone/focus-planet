.mission-hint { margin-top: 4px; color: #8a967e; font-size: 11px; }
.board { position: relative; margin-top: 12px; flex-shrink: 0; border-radius: 18px; background-color: rgba(255,255,255,0.72); overflow: hidden; }
.slot { position: absolute; border-width: 1px; border-style: dashed; border-color: rgba(120,140,160,0.5); align-items: center; justify-content: center; }
