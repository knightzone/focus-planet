.label { margin-top: 3px; color: #8a93a7; font-size: 10px; }
.primary { margin-top: 8px; width: 160px; height: 46px; line-height: 46px; border-radius: 15px; background-color: #3f95d1; color: #ffffff; font-size: 14px; font-weight: 700; }
.demo-replay { margin-top: 10px; padding: 6px 16px; color: #2f7fa8; font-size: 12px; font-weight: 700; }
