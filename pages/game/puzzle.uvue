.tray-box-selected { border-radius: 8px; background-color: rgba(74,163,216,0.28); }
.tray-empty { position: absolute; left: 0; right: 0; top: 24px; text-align: center; color: #9aa6b6; font-size: 12px; }
.feedback { height: 32px; flex-shrink: 0; align-items: center; justify-content: center; }
.good { color: #338e72; font-size: 12px; font-weight: 700; }
.again { color: #c65b66; font-size: 12px; font-weight: 700; }
.stats { height: 60px; flex-shrink: 0; padding: 10px 8px; border-radius: 18px; background-color: rgba(255,255,255,0.94); flex-direction: row; }
.stat { flex: 1; align-items: center; }
