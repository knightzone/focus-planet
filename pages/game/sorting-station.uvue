.play-area { margin-top: 14px; width: 100%; position: relative; border-radius: 24px; background-color: rgba(255,255,255,0.55); overflow: hidden; }
.station-zone { position: absolute; top: 8px; height: 110px; border-radius: 20px; align-items: center; justify-content: center; }.station-zone.left { left: 8px; right: 50%; margin-right: 5px; background-color: rgba(234,240,255,0.96); }.station-zone.right { left: 50%; right: 8px; margin-left: 5px; background-color: rgba(255,240,210,0.96); }.station-ready { border-width: 2px; border-color: #eda62c; }.station-wrong { background-color: #fdeef0; border-width: 2px; border-color: #f17c8d; }.station-name { color: #46536d; font-size: 16px; font-weight: 700; }.station-count { margin-top: 4px; color: #8a94a8; font-size: 11px; }
