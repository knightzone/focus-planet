<template>
  <scroll-view class="page" direction="vertical" show-scrollbar="false">
    <view v-if="viewState == 'setup'" class="page-content">
      <view class="top-row">
        <view>
          <text class="eyebrow">星陪伴</text>
          <text class="title">专注一下</text>
        </view>
        <image class="top-mascot" src="/static/images/runtime/brand/focus-star-planet-v1.webp" mode="aspectFit"></image>
      </view>

      <text class="section-title">你准备做什么？</text>
      <view class="mode-list">
        <view class="mode-card" :class="selectedMode == 'screen' ? 'mode-card-active' : ''" @click="selectMode('screen')">
          <image class="mode-image" src="/static/images/runtime/companion/screen-learning.webp" mode="aspectFill"></image>
          <view class="mode-copy"><text class="mode-title" :class="selectedMode == 'screen' ? 'mode-title-active' : ''">屏幕学习</text></view>
          <view class="mode-status" :class="selectedMode == 'screen' ? 'mode-status-active' : ''"><text class="mode-check" :class="selectedMode == 'screen' ? 'mode-check-active' : ''">{{ selectedMode == 'screen' ? '✓' : '›' }}</text></view>
        </view>
        <view class="mode-card" :class="selectedMode == 'desk' ? 'mode-card-active' : ''" @click="selectMode('desk')">
          <image class="mode-image" src="/static/images/runtime/companion/desk-homework.webp" mode="aspectFill"></image>
          <view class="mode-copy"><text class="mode-title" :class="selectedMode == 'desk' ? 'mode-title-active' : ''">桌面作业</text></view>
          <view class="mode-status" :class="selectedMode == 'desk' ? 'mode-status-active' : ''"><text class="mode-check" :class="selectedMode == 'desk' ? 'mode-check-active' : ''">{{ selectedMode == 'desk' ? '✓' : '›' }}</text></view>
        </view>
        <view class="mode-card" :class="selectedMode == 'reading' ? 'mode-card-active' : ''" @click="selectMode('reading')">
          <image class="mode-image" src="/static/images/runtime/companion/reading-time.webp" mode="aspectFill"></image>
          <view class="mode-copy"><text class="mode-title" :class="selectedMode == 'reading' ? 'mode-title-active' : ''">阅读时间</text></view>
          <view class="mode-status" :class="selectedMode == 'reading' ? 'mode-status-active' : ''"><text class="mode-check" :class="selectedMode == 'reading' ? 'mode-check-active' : ''">{{ selectedMode == 'reading' ? '✓' : '›' }}</text></view>
        </view>
      </view>

      <view class="section-header">
        <text class="section-title section-title-inline">专注多久？</text>
      </view>
      <view class="duration-row">
        <view v-for="item in durationOptions" :key="item" class="duration-chip" :class="selectedMinutes == item ? 'duration-chip-active' : ''" @click="selectDuration(item)">
          <text class="duration-number" :class="selectedMinutes == item ? 'duration-number-active' : ''">{{ item }}</text><text class="duration-unit" :class="selectedMinutes == item ? 'duration-unit-active' : ''">分钟</text>
        </view>
      </view>

      <view class="camera-option" @click="toggleCameraAnalysis">
        <view class="camera-option-copy">
          <text class="camera-option-title">坐姿陪伴</text>
          <text class="camera-option-desc">仅本机识别</text>
        </view>
        <view class="camera-toggle" :class="cameraEnabled ? 'camera-toggle-on' : ''"><view class="camera-toggle-knob" :class="cameraEnabled ? 'camera-toggle-knob-on' : ''"></view></view>
      </view>

      <button class="tap-target start-button" @click="startFocus">开始专注</button>
      <view class="bottom-space"></view>
    </view>

    <view v-else-if="viewState == 'focus' || viewState == 'break'" class="session-content">
      <text class="session-kicker">{{ viewState == 'focus' ? modeName : '休息一下' }}</text>
      <text class="session-title">{{ viewState == 'focus' ? '跃跃陪你专注' : '看看远处，喝口水' }}</text>
      <view class="timer-ring" :class="viewState == 'break' ? 'timer-ring-break' : ''">
        <text class="timer-time">{{ remainingText }}</text>
        <text class="timer-label">{{ paused ? '已暂停' : (viewState == 'focus' ? '专注中' : '休息中') }}</text>
      </view>
      <view class="progress-track"><view class="progress-fill" :class="viewState == 'break' ? 'progress-fill-break' : ''" :style="{ width: progressWidth }"></view></view>
      <!-- #ifdef APP-ANDROID || APP-IOS -->
      <view v-if="viewState == 'focus' && cameraEnabled" class="observation-card">
        <camera id="focusCamera" class="camera-preview" device-position="front" flash="off" resolution="low" frame-size="small" @initdone="onCameraInit" @error="onCameraError"></camera>
        <view class="observation-copy">
          <view class="observation-head"><view class="status-dot" :class="detectionLevel == 'good' ? 'status-good' : detectionLevel == 'warn' ? 'status-warn' : 'status-idle'"></view><text class="observation-title">{{ detectionStatus }}</text></view>
        </view>
      </view>
      <!-- #endif -->
      <button class="tap-target primary-button" @click="togglePause">{{ paused ? '继续' : '暂停' }}</button>
      <button class="tap-target secondary-button" @click="finishPhaseEarly">{{ viewState == 'focus' ? '提前完成专注' : '跳过休息' }}</button>
      <text class="cancel-link" @click="cancelSession">取消本轮</text>
    </view>

    <view v-else class="complete-content">
      <image class="complete-mascot" src="/static/images/runtime/brand/duo-star-v1.webp" mode="aspectFit"></image>
      <text class="complete-kicker">本轮完成</text>
      <text class="complete-title">认真投入了 {{ completedMinutes }} 分钟</text>
      <view class="complete-card">
        <view class="complete-stat"><text class="complete-value">{{ modeName }}</text><text class="complete-label">陪伴模式</text></view>
        <view class="complete-divider"></view>
        <view class="complete-stat"><text class="complete-value">{{ reminderCountText }}</text><text class="complete-label">温和提醒</text></view>
      </view>
      <view v-if="cameraEnabled" class="complete-observation"><text class="complete-observation-title">端侧观察摘要</text><text class="complete-observation-copy">{{ observationSummary }}</text></view>
      <button class="tap-target start-button complete-button" @click="backToSetup">再来一轮</button>
      <button class="tap-target secondary-button" @click="goMine">查看我的记录</button>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import { getProfile } from '../../utils/storage.uts'
import { addCompanionRecord, getCompanionModeName } from '../../utils/companion-storage.uts'
import { detectFaceFrame } from '@/uni_modules/focus-face-detector'
import { FaceFrameResult } from '../../uni_modules/focus-face-detector/utssdk/interface.uts'
import { submitCompanionSession } from '../../utils/server-api.uts'
import { getDeviceId } from '../../utils/api-client.uts'
import { getAuthSession, requireLogin } from '../../utils/auth.uts'
import { setCompanionUpdateBusy } from '../../utils/app-update.uts'

const selectedMode = ref('desk')
const selectedMinutes = ref(15)
const durationOptions = [1, 10, 15, 20, 25]
const viewState = ref('setup')
const remainingSeconds = ref(0)
const paused = ref(false)
const postureReminderShown = ref(false)
const lastBreakCompleted = ref(false)
const completedFocusSeconds = ref(0)
const sessionStartedAt = ref(0)
const cameraEnabled = ref(false)
const cameraReady = ref(false)
const detectionStatus = ref('等待相机启动')
const detectionLevel = ref('idle')
const detectionSamples = ref(0)
const steadyPresenceSamples = ref(0)
const awaySamples = ref(0)
const tooCloseSamples = ref(0)
const headTurnSamples = ref(0)
const detectionReminderCount = ref(0)
const hasDetectedFace = ref(false)
const consecutiveMissingSamples = ref(0)
let timer = 0
let lastDetectionNoticeAt = 0
let lastFrameAnalyzedAt = 0
// #ifdef APP-ANDROID || APP-IOS
let frameListener: CameraContextCameraFrameListener | null = null
// #endif
let phaseEndsAt = 0
let focusTotalSeconds = 0
let breakTotalSeconds = 0

// UTS/Kotlin local symbols are declaration-order sensitive. Declare the mutually
// dependent session callbacks before assigning their implementations below.
let startTimer: () => void = (): void => {}
let clearTimer: () => void = (): void => {}
let startDetectionListener: () => void = (): void => {}
let stopDetectionListener: () => void = (): void => {}
let applyDetection: (result: FaceFrameResult) => void = (_result: FaceFrameResult): void => {}
let tick: () => void = (): void => {}
let beginBreak: (finishedPlannedFocus: boolean) => void = (_finishedPlannedFocus: boolean): void => {}
let completeSession: (breakCompleted: boolean) => void = (_breakCompleted: boolean): void => {}
let backToSetup: () => void = (): void => {}

const breakMinutes = computed((): number => selectedMinutes.value == 1 ? 1 : selectedMinutes.value <= 10 ? 3 : 5)
const modeName = computed((): string => getCompanionModeName(selectedMode.value))
const remainingText = computed((): string => {
  const minutes = Math.floor(remainingSeconds.value / 60)
  const seconds = remainingSeconds.value % 60
  return minutes.toString().padStart(2, '0') + ':' + seconds.toString().padStart(2, '0')
})
const progressWidth = computed((): string => {
  const total = viewState.value == 'focus' ? focusTotalSeconds : breakTotalSeconds
  if (total <= 0) return '0%'
  const progress = Math.max(0, Math.min(100, Math.round((total - remainingSeconds.value) * 100 / total)))
  return progress.toString() + '%'
})
const phaseTip = computed((): string => {
  if (paused.value) return '准备好后继续，暂停期间不会消耗剩余时间。'
  if (viewState.value == 'break') return '站起来活动一下，望向远处，让眼睛和肩颈休息。'
  if (cameraEnabled.value) return detectionStatus.value + '。检测只用于本轮温和提醒。'
  if (postureReminderShown.value) return '刚刚完成了一次坐姿自检：双脚放稳，肩膀放松。'
  return '保持自然坐姿。时间过半时，星伴会提醒你自己检查一次。'
})
const completedMinutes = computed((): number => Math.max(1, Math.round(completedFocusSeconds.value / 60)))
const reminderCountText = computed((): string => {
  const count = cameraEnabled.value ? detectionReminderCount.value : (postureReminderShown.value ? 1 : 0)
  return count.toString() + ' 次'
})
const observationSummary = computed((): string => {
  if (cameraEnabled.value == false) return '本轮未开启端侧观察。'
  if (detectionSamples.value == 0) return '本轮没有取得有效观察帧。'
  const steadyRate = Math.round(steadyPresenceSamples.value * 100 / detectionSamples.value)
  return '稳定在屏 ' + steadyRate.toString() + '% · 离开 ' + (awaySamples.value * 3).toString() + ' 秒 · 距离过近 ' + (tooCloseSamples.value * 3).toString() + ' 秒 · 明显偏头 ' + (headTurnSamples.value * 3).toString() + ' 秒'
})

function selectMode(mode: string) { selectedMode.value = mode }
function selectDuration(minutes: number) { selectedMinutes.value = minutes }
function toggleCameraAnalysis() {
  // #ifdef APP-ANDROID || APP-IOS
  cameraEnabled.value = cameraEnabled.value == false
  // #endif
  // #ifndef APP-ANDROID || APP-IOS
  uni.showToast({ title: '端侧观察目前支持 Android 与 iOS', icon: 'none' })
  // #endif
}

function startFocus() {
  if (!requireLogin()) return
  if (getProfile() == null) {
    uni.navigateTo({ url: '/pages/profile/profile' })
    return
  }
  focusTotalSeconds = selectedMinutes.value * 60
  breakTotalSeconds = breakMinutes.value * 60
  remainingSeconds.value = focusTotalSeconds
  completedFocusSeconds.value = 0
  sessionStartedAt.value = Date.now()
  postureReminderShown.value = false
  lastBreakCompleted.value = false
  cameraReady.value = false
  detectionStatus.value = cameraEnabled.value ? '等待相机授权' : '未开启端侧观察'
  detectionLevel.value = 'idle'
  detectionSamples.value = 0
  steadyPresenceSamples.value = 0
  awaySamples.value = 0
  tooCloseSamples.value = 0
  headTurnSamples.value = 0
  detectionReminderCount.value = 0
  hasDetectedFace.value = false
  consecutiveMissingSamples.value = 0
  lastDetectionNoticeAt = 0
  lastFrameAnalyzedAt = 0
  paused.value = false
  viewState.value = 'focus'
  setCompanionUpdateBusy(true)
  phaseEndsAt = Date.now() + remainingSeconds.value * 1000
  uni.hideTabBar()
  startTimer()
}

startTimer = (): void => {
  clearTimer()
  timer = setInterval(() => tick(), 1000)
}

clearTimer = (): void => {
  if (timer > 0) {
    clearInterval(timer)
    timer = 0
  }
}

// #ifdef APP-ANDROID || APP-IOS
function onCameraInit(_event: UniCameraInitDoneEvent) {
  cameraReady.value = true
  detectionStatus.value = '正在进行端侧观察'
  detectionLevel.value = 'idle'
  const context = uni.createCameraContext()
  frameListener = context?.onCameraFrame((frame: CameraContextOnCameraFrame) => {
    if (paused.value || viewState.value != 'focus') return
    const now = Date.now()
    if (now - lastFrameAnalyzedAt < 3000) return
    lastFrameAnalyzedAt = now
    const rgba = frame.data
    const frameWidth = frame.width
    const frameHeight = frame.height
    if (rgba == null || frameWidth == null || frameHeight == null || frameWidth <= 0 || frameHeight <= 0) return
    const detection = detectFaceFrame(rgba, frameWidth, frameHeight)
    applyDetection(detection)
  })
  startDetectionListener()
}

function onCameraError(_event: UniCameraErrorEvent) {
  cameraReady.value = false
  stopDetectionListener()
  detectionStatus.value = '相机未授权，已改用定时提醒'
  detectionLevel.value = 'warn'
}
// #endif

startDetectionListener = (): void => {
  // #ifdef APP-ANDROID || APP-IOS
  if (cameraEnabled.value == false || cameraReady.value == false || paused.value || viewState.value != 'focus') return
  frameListener?.start({
    fail: (_error: any) => {
      detectionStatus.value = '暂时无法读取相机帧'
      detectionLevel.value = 'warn'
    }
  } as CameraContextCameraFrameListenerStartOptions)
  // #endif
}

stopDetectionListener = (): void => {
  // #ifdef APP-ANDROID || APP-IOS
  frameListener?.stop({} as CameraContextCameraFrameListenerStopOptions)
  // #endif
}

applyDetection = (result: FaceFrameResult): void => {
  if (result.supported == false) {
    detectionStatus.value = result.errorMessage == '' ? '当前设备暂不支持检测' : result.errorMessage
    detectionLevel.value = 'warn'
    stopDetectionListener()
    return
  }
  detectionSamples.value += 1
  let issueMessage = ''
  if (result.detected == false || result.confidence < 0.3) {
    consecutiveMissingSamples.value += 1
    if (hasDetectedFace.value == false) {
      detectionStatus.value = consecutiveMissingSamples.value < 3 ? '正在确认画面，请保持正对镜头' : '暂未识别到面部，请调整光线和距离'
      detectionLevel.value = consecutiveMissingSamples.value < 3 ? 'idle' : 'warn'
      if (consecutiveMissingSamples.value == 3) issueMessage = '请让面部完整进入画面，并保持光线充足'
    } else if (consecutiveMissingSamples.value < 4) {
      detectionStatus.value = '暂时无法判断姿态，请回正后保持一下'
      detectionLevel.value = consecutiveMissingSamples.value < 2 ? 'idle' : 'warn'
      if (consecutiveMissingSamples.value == 2) issueMessage = '请轻轻抬头并回正，星伴正在重新识别'
    } else {
      awaySamples.value += 1
      detectionStatus.value = '已持续离开观察范围'
      detectionLevel.value = 'warn'
      issueMessage = '回到合适的位置，继续当前的小目标吧'
    }
  } else if (result.faceCount > 1) {
    hasDetectedFace.value = true
    consecutiveMissingSamples.value = 0
    detectionStatus.value = '画面中出现多人'
    detectionLevel.value = 'warn'
  } else if (result.faceScale >= 0.58) {
    hasDetectedFace.value = true
    consecutiveMissingSamples.value = 0
    tooCloseSamples.value += 1
    detectionStatus.value = '距离屏幕有点近'
    detectionLevel.value = 'warn'
    issueMessage = '向后坐一点，让眼睛更舒服'
  } else if (result.faceScale <= 0.11 || result.centerX < 0.20 || result.centerX > 0.80 || result.centerY < 0.18 || result.centerY > 0.86) {
    hasDetectedFace.value = true
    consecutiveMissingSamples.value = 0
    awaySamples.value += 1
    detectionStatus.value = '请回到画面中央'
    detectionLevel.value = 'warn'
    issueMessage = '调整一下位置，让星伴能看到你'
  } else if (Math.abs(result.yaw) > 28 || Math.abs(result.roll) > 22 || Math.abs(result.pitch) > 25) {
    hasDetectedFace.value = true
    consecutiveMissingSamples.value = 0
    headTurnSamples.value += 1
    detectionStatus.value = '头部偏转有点久'
    detectionLevel.value = 'warn'
    issueMessage = '肩膀放松，把头摆正一些'
  } else {
    hasDetectedFace.value = true
    consecutiveMissingSamples.value = 0
    steadyPresenceSamples.value += 1
    detectionStatus.value = '状态稳定，继续保持'
    detectionLevel.value = 'good'
  }
  if (issueMessage != '' && Date.now() - lastDetectionNoticeAt >= 15000) {
    lastDetectionNoticeAt = Date.now()
    detectionReminderCount.value += 1
    postureReminderShown.value = true
    uni.showToast({ title: issueMessage, icon: 'none', duration: 2500 })
  }
}

tick = (): void => {
  if (paused.value) return
  remainingSeconds.value = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000))
  if (viewState.value == 'focus' && cameraEnabled.value == false && postureReminderShown.value == false && remainingSeconds.value <= Math.round(focusTotalSeconds / 2)) {
    postureReminderShown.value = true
    uni.showToast({ title: '坐姿自检：肩膀放松，双脚放稳', icon: 'none', duration: 2500 })
  }
  if (remainingSeconds.value <= 0) {
    clearTimer()
    if (viewState.value == 'focus') beginBreak(true)
    else if (viewState.value == 'break') completeSession(true)
  }
}

function togglePause() {
  if (paused.value) {
    paused.value = false
    phaseEndsAt = Date.now() + remainingSeconds.value * 1000
    startTimer()
    if (viewState.value == 'focus' && cameraEnabled.value && cameraReady.value) startDetectionListener()
  } else {
    tick()
    paused.value = true
    clearTimer()
    stopDetectionListener()
  }
}

function finishPhaseEarly() {
  if (viewState.value == 'break') {
    completeSession(false)
    return
  }
  uni.showModal({
    title: '提前完成？',
    content: '已经专注的时间会保存，并进入休息阶段。',
    confirmText: '完成专注',
    cancelText: '继续专注',
    success: (result) => {
      if (result.confirm) beginBreak(false)
    }
  })
}

beginBreak = (finishedPlannedFocus: boolean): void => {
  stopDetectionListener()
  completedFocusSeconds.value = finishedPlannedFocus ? focusTotalSeconds : Math.max(1, focusTotalSeconds - remainingSeconds.value)
  remainingSeconds.value = breakTotalSeconds
  paused.value = false
  viewState.value = 'break'
  phaseEndsAt = Date.now() + remainingSeconds.value * 1000
  startTimer()
}

completeSession = (breakCompleted: boolean): void => {
  clearTimer()
  stopDetectionListener()
  lastBreakCompleted.value = breakCompleted
  const now = Date.now()
  addCompanionRecord({
    id: 'companion-' + now.toString(),
    mode: selectedMode.value,
    plannedMinutes: selectedMinutes.value,
    focusedSeconds: completedFocusSeconds.value,
    breakMinutes: breakMinutes.value,
    breakCompleted: breakCompleted,
    postureReminderCount: cameraEnabled.value ? detectionReminderCount.value : (postureReminderShown.value ? 1 : 0),
    cameraAnalysisEnabled: cameraEnabled.value,
    observedSeconds: detectionSamples.value * 3,
    steadyPresenceSeconds: steadyPresenceSamples.value * 3,
    awaySeconds: awaySamples.value * 3,
    tooCloseSeconds: tooCloseSamples.value * 3,
    headTurnSeconds: headTurnSamples.value * 3,
    detectionIssueCount: detectionReminderCount.value,
    startedAt: sessionStartedAt.value,
    completedAt: now
  })
  const profile = getProfile()
  if (profile != null && getAuthSession() != null) {
    const submissionId = 'companion-' + now.toString() + '-' + Math.round(Math.random() * 100000).toString()
    submitCompanionSession({
      submissionId: submissionId,
      mode: selectedMode.value,
      startedAt: new Date(sessionStartedAt.value).toISOString(),
      endedAt: new Date(now).toISOString(),
      plannedDurationSeconds: selectedMinutes.value * 60,
      durationSeconds: completedFocusSeconds.value,
      restCompleted: breakCompleted,
      cameraEnabled: cameraEnabled.value,
      validFrameCount: cameraEnabled.value ? detectionSamples.value : 0,
      stableOnScreenSeconds: cameraEnabled.value ? Math.min(completedFocusSeconds.value, steadyPresenceSamples.value * 3) : 0,
      tooCloseSeconds: cameraEnabled.value ? Math.min(completedFocusSeconds.value, tooCloseSamples.value * 3) : 0,
      postureReminderCount: cameraEnabled.value ? detectionReminderCount.value : 0,
      awayCount: cameraEnabled.value ? awaySamples.value : 0,
      deviceId: getDeviceId()
    }, (_data: UTSJSONObject) => {}, (message: string, _code: string) => console.log('陪伴记录同步失败：' + message))
  }
  viewState.value = 'complete'
  setCompanionUpdateBusy(false)
  uni.showTabBar()
}

function cancelSession() {
  uni.showModal({
    title: '取消本轮？',
    content: '取消后不会保存这次记录。',
    confirmText: '确认取消',
    cancelText: '继续',
    success: (result) => {
      if (result.confirm) backToSetup()
    }
  })
}

backToSetup = (): void => {
  clearTimer()
  stopDetectionListener()
  viewState.value = 'setup'
  setCompanionUpdateBusy(false)
  remainingSeconds.value = 0
  paused.value = false
  uni.showTabBar()
}

function goMine() {
  uni.switchTab({ url: '/pages/mine/mine' })
}

onShow(() => {
  const profile = getProfile()
  if (profile == null) {
    if (getAuthSession() != null) uni.navigateTo({ url: '/pages/profile/profile' })
    return
  }
  if (viewState.value == 'setup') {
    if (profile.age <= 6) selectedMinutes.value = 10
    else if (profile.age <= 9) selectedMinutes.value = 15
    else if (profile.age <= 12) selectedMinutes.value = 20
    else selectedMinutes.value = 25
  } else if ((viewState.value == 'focus' || viewState.value == 'break') && paused.value == false) {
    tick()
    if (viewState.value == 'focus' || viewState.value == 'break') startTimer()
    if (viewState.value == 'focus' && cameraEnabled.value && cameraReady.value) startDetectionListener()
  }
})

onHide(() => {
  clearTimer()
  stopDetectionListener()
})

onUnload(() => {
  setCompanionUpdateBusy(false)
  clearTimer()
  stopDetectionListener()
  uni.showTabBar()
})
</script>

<style>
.page { height: 100%; }
.page-content { padding: 50px 20px 34px; }
.top-row { flex-direction: row; align-items: center; justify-content: space-between; }
.eyebrow { color: #55a98d; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
.title { margin-top: 5px; color: #1f2a44; font-size: 24px; font-weight: 700; }
.top-mascot { width: 62px; height: 62px; border-radius: 31px; }
.hero-card { margin-top: 23px; padding: 23px; border-radius: 25px; background-color: #55c9a5; }
.hero-kicker { color: #eafff8; font-size: 12px; font-weight: 700; }
.hero-title { margin-top: 7px; color: #ffffff; font-size: 23px; font-weight: 700; }
.hero-copy { margin-top: 9px; color: #effff9; font-size: 13px; line-height: 20px; }
.privacy-pill { margin-top: 16px; padding: 8px 11px; border-radius: 13px; background-color: #ffffff; align-self: flex-start; }
.privacy-pill-text { color: #37856e; font-size: 10px; font-weight: 600; }
