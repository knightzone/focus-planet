<template>
  <view class="page">
    <view class="mascot-wrap">
      <image class="mascot" src="/static/images/runtime/brand/focus-star-planet-v1.webp" mode="aspectFit"></image>
    </view>

    <text class="title">家长验证</text>
    <text class="subtitle">请家长完成这道题</text>

    <view class="challenge-card">
      <text class="challenge-text">{{ challengeText }}</text>
      <input class="answer-input" v-model="answer" type="number" maxlength="2" placeholder="输入答案" placeholder-style="color:#a9b3c6" @confirm="submit" />
      <text class="hint-text">{{ hintText }}</text>
    </view>

    <button class="submit-button" :class="canSubmit ? '' : 'submit-button-disabled'" @click="submit">确定</button>
    <button class="cancel-button" @click="cancel">返回</button>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { ParentChallenge, createParentChallenge, parentLockRemainingSeconds, recordParentFailure, unlockParentArea } from '../../utils/parent-lock.uts'
import { clearAuthSession } from '../../utils/auth.uts'
import { requestAccountDeletion } from '../../utils/server-api.uts'

const challengeText = ref('')
const answer = ref('')
const hintText = ref('')
const lockSeconds = ref(0)
const lockAction = ref('settings')
let challengeAnswer = 0
let lockTimer = 0

const canSubmit = computed((): boolean => lockSeconds.value == 0 && answer.value.length > 0)

// 每次答错都换新题，避免孩子对着同一题穷举答案。
function nextChallenge() {
  const challenge: ParentChallenge = createParentChallenge()
  challengeText.value = challenge.text
  challengeAnswer = challenge.answer
  answer.value = ''
}

function refreshLock() {
  lockSeconds.value = parentLockRemainingSeconds()
  hintText.value = lockSeconds.value > 0
    ? '答错 3 次，请 ' + lockSeconds.value.toString() + ' 秒后再试'
    : '家长请读出大写数字，用数字键盘作答'
}

function startLockTimer() {
  if (lockTimer != 0) return
  lockTimer = setInterval(() => {
    refreshLock()
    if (lockSeconds.value > 0) return
    clearInterval(lockTimer)
    lockTimer = 0
    nextChallenge()
  }, 1000)
}

function submit() {
  if (lockSeconds.value > 0) { uni.showToast({ title: '请稍候再试', icon: 'none' }); return }
  if (answer.value.length == 0) { uni.showToast({ title: '请输入答案', icon: 'none' }); return }
  if (parseInt(answer.value, 10) == challengeAnswer) {
    unlockParentArea()
    if (lockTimer != 0) { clearInterval(lockTimer); lockTimer = 0 }
    uni.showToast({ title: '已进入家长模式', icon: 'success' })
    setTimeout(() => runAction(), 350)
    return
  }
  const lockedFor = recordParentFailure()
  if (lockedFor > 0) {
    refreshLock()
    startLockTimer()
    uni.showToast({ title: '答错次数过多，已暂时锁定', icon: 'none' })
    return
  }
  nextChallenge()
  uni.showToast({ title: '答案不对，请家长再试一次', icon: 'none' })
}

// 验证通过后执行原先卡在门外的动作：退出登录 / 提交注销 / 返回上级页。
function runAction() {
  if (lockAction.value == 'logout') {
    clearAuthSession()
    uni.switchTab({ url: '/pages/mine/mine' })
    return
  }
  if (lockAction.value == 'delete') {
    // 家长验证通过后再真正提交注销；成功后本地会话立即失效。
    requestAccountDeletion((_data: UTSJSONObject) => {
      clearAuthSession()
      uni.showToast({ title: '已提交注销申请', icon: 'none', duration: 2500 })
      setTimeout(() => uni.reLaunch({ url: '/pages/index/index' }), 900)
    }, (message: string, _code: string) => {
      uni.showToast({ title: message, icon: 'none' })
      setTimeout(() => uni.navigateBack(), 900)
    })
    return
  }
  uni.navigateBack()
}

function cancel() { uni.navigateBack() }

onLoad((options: UTSJSONObject) => {
  const value = options['action']
  if (value != null) lockAction.value = value as string
  nextChallenge()
  refreshLock()
  if (lockSeconds.value > 0) startLockTimer()
})

onUnload(() => {
  if (lockTimer != 0) { clearInterval(lockTimer); lockTimer = 0 }
})
</script>

<style>
.page { padding: 58px 24px 34px; align-items: center; }
.mascot-wrap { width: 142px; height: 142px; border-radius: 71px; background-color: #eaf0ff; align-items: center; justify-content: center; }
.mascot { width: 132px; height: 142px; border-radius: 66px; }
.title { margin-top: 25px; color: #1f2a44; font-size: 25px; font-weight: 700; }
.subtitle { margin-top: 8px; color: #78839a; font-size: 13px; }
.challenge-card { margin-top: 30px; width: 100%; padding: 26px 20px 20px; border-radius: 25px; background-color: #ffffff; align-items: center; }
.challenge-text { color: #2b3853; font-size: 32px; font-weight: 700; letter-spacing: 2px; }
.answer-input { margin-top: 20px; width: 190px; height: 54px; padding: 0 14px; border-radius: 16px; background-color: #eaf1ff; color: #26324a; font-size: 20px; text-align: center; }
.hint-text { margin-top: 14px; color: #8b95a8; font-size: 11px; text-align: center; }
.submit-button { margin-top: 26px; width: 200px; height: 52px; line-height: 52px; border-radius: 26px; background-color: #5b8def; color: #ffffff; font-size: 16px; font-weight: 700; }
.submit-button-disabled { background-color: #adc4f3; }
.cancel-button { margin-top: 16px; width: 132px; height: 46px; line-height: 46px; border-radius: 23px; background-color: #e9edf5; color: #69758d; font-size: 14px; }
</style>
