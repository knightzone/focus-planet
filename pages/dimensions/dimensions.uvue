<template>
  <scroll-view class="page" direction="vertical" show-scrollbar="false">
    <view class="intro">
      <view class="intro-copy"><text class="title">{{ pageTitle }}</text></view>
      <image class="intro-mascot" src="/static/images/runtime/brand/duo-star-v1.webp" mode="aspectFit"></image>
    </view>

    <view v-for="dimension in visibleDimensions" :key="dimension.id" class="dimension-block">
      <view class="dimension-head">
        <view class="color-mark" :style="{ backgroundColor: dimension.color }"></view>
        <view class="dimension-copy">
          <text class="dimension-title">{{ dimension.name }}</text>
        </view>
      </view>
      <view class="game-list">
        <view v-for="game in gameList(dimension.id)" :key="game.id" class="game-row" @click="openGame(game.id)">
          <image class="game-cover tap-content" :src="thumbnailFor(game.id)" mode="aspectFill"></image>
          <view class="game-copy tap-content">
            <text class="game-name">{{ game.name }}</text>
            <view class="game-action" :style="{ backgroundColor: dimension.color }">
              <text class="game-action-icon">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { DIMENSIONS, gamesForDimension, getGameThumbnail, TrainingGame } from '../../utils/catalog.uts'

const visibleDimensions = ref(DIMENSIONS)
const pageTitle = ref('五维专注力')
function gameList(id: string): TrainingGame[] { return gamesForDimension(id) }
function thumbnailFor(id: string): string { return getGameThumbnail(id) }
onLoad((options: UTSJSONObject) => {
  const value = options['dimensionId']
  if (value == null) return
  const dimensionId = value as string
  const exists = DIMENSIONS.find((item): boolean => item.id == dimensionId)
  if (exists == null) return
  visibleDimensions.value = [exists]
  pageTitle.value = exists.name
})
function openGame(id: string) { uni.navigateTo({ url: '/pages/dimensions/game-showcase?gameId=' + id }) }
</script>

<style>
.page { height: 100%; }
.intro { margin: 18px 16px 8px; padding: 18px 14px 12px 20px; border-radius: 22px; background-color: #eaf0ff; flex-direction: row; align-items: center; }
.intro-copy { flex: 1; }
.intro-mascot { width: 92px; height: 92px; border-radius: 24px; }
.title { color: #1f2a44; font-size: 24px; font-weight: 700; }
.subtitle { margin-top: 8px; color: #6f7a91; font-size: 13px; line-height: 20px; }
.dimension-block { margin: 14px 16px; padding: 16px 12px 12px; border-radius: 22px; background-color: #ffffff; }
.dimension-head { flex-direction: row; align-items: center; }
.color-mark { width: 13px; height: 46px; border-radius: 7px; }
.dimension-copy { margin-left: 12px; }
.dimension-title { color: #25314b; font-size: 18px; font-weight: 700; }
.dimension-description { margin-top: 4px; color: #7a8499; font-size: 12px; }
.game-list { margin-top: 12px; }
.game-row { min-height: 92px; margin-top: 8px; padding: 8px; border-radius: 17px; background-color: #f7f9fd; flex-direction: row; align-items: center; }
.game-cover { width: 126px; height: 76px; border-radius: 13px; background-color: #eaf0fb; }
.game-copy { margin-left: 14px; flex: 1; flex-direction: row; align-items: center; justify-content: space-between; }
.game-name { flex: 1; color: #2b3650; font-size: 15px; font-weight: 700; }
.game-action { width: 30px; height: 30px; margin-left: 8px; border-radius: 15px; align-items: center; justify-content: center; }
.game-action-icon { margin-top: -2px; color: #ffffff; font-size: 25px; font-weight: 500; }
.bottom-space { height: 30px; }
</style>
