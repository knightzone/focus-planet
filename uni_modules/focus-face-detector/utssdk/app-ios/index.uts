import { AppleSignedTransactionResult, AppleStoreProductsResult, DetectFaceFrame, FaceFrameResult, FetchAppleSignedTransaction, FetchAppleStoreProducts } from '../interface.uts'

export function openUpdateLink(url: string, completed: (success: boolean) => void) {
  FocusFaceDetectorNative.openUpdateLink(url, completed)
}

// 本地续费提醒：UNUserNotificationCenter，不发远程推送、不接第三方推送 SDK。
export function scheduleRenewalReminder(identifier: string, title: string, body: string, atEpochMs: number, completed: (granted: boolean) => void) {
  FocusFaceDetectorNative.scheduleRenewalReminder(identifier, title, body, atEpochMs, completed)
}

export function cancelRenewalReminder(identifier: string) {
  FocusFaceDetectorNative.cancelRenewalReminder(identifier)
}

export const detectFaceFrame: DetectFaceFrame = function (rgba: ArrayBuffer, width: number, height: number): FaceFrameResult {
  const value = JSON.parse<FaceFrameResult>(FocusFaceDetectorNative.detectRgba(rgba.toData(), width.toInt(), height.toInt()))
  if (value != null) return value
  return {
    supported: false,
    detected: false,
    faceCount: 0,
    faceScale: 0,
    centerX: 0.5,
    centerY: 0.5,
    yaw: 0,
    roll: 0,
    pitch: 0,
    confidence: 0,
    errorMessage: 'iOS 检测结果解析失败'
  }
}

export const fetchAppleStoreProducts: FetchAppleStoreProducts = function (productIds: string[], completed: (result: AppleStoreProductsResult) => void) {
  FocusFaceDetectorNative.fetchStoreProducts(productIds, (json: string) => {
    const value = JSON.parse<AppleStoreProductsResult>(json)
    if (value != null) { completed(value!); return }
    completed({ success: false, products: [], errorMessage: 'App Store 商品信息解析失败' })
  })
}

// StoreKit's JSON representation is not a signed JWS. Read the verification result instead.
export const fetchAppleSignedTransaction: FetchAppleSignedTransaction = function (transactionId: string, productId: string, completed: (result: AppleSignedTransactionResult) => void) {
  FocusFaceDetectorNative.fetchSignedTransaction(transactionId, productId, (json: string) => {
    const value = JSON.parse<AppleSignedTransactionResult>(json)
    if (value != null) { completed(value!); return }
    completed({ jws: '', errorMessage: 'Apple 签名交易解析失败' })
  })
}
