import { getProfile, getRecords, TrainingRecord, getLocalDayKey } from './storage.uts'

export type DifficultyState = {
  gameId: string,
  level: number,
  lastLowPairKey: string,
  updatedAt: number
}

export type DifficultyUpdate = {
  previousLevel: number,
  currentLevel: number,
  change: number,
  message: string
}

type DailyPeak = {
  dayKey: string,
  peak: number
}

const DIFFICULTY_KEY = 'focus_planet_difficulty_states'
const TEST_DIFFICULTY_KEY = 'focus_planet_test_difficulty'
export const MAX_DIFFICULTY = 10
export const UPGRADE_SCORE = 85
export const LOW_SCORE = 60

function clampLevel(level: number): number {
  return Math.max(1, Math.min(MAX_DIFFICULTY, level))
}

export function getTestDifficultyOverride(): number {
  const value = uni.getStorageSync(TEST_DIFFICULTY_KEY)
  if (value == null || value == '') return 0
  const level = value as number
  return level <= 0 ? 0 : clampLevel(level)
}

export function setTestDifficultyOverride(level: number) {
  if (level <= 0) {
    uni.removeStorageSync(TEST_DIFFICULTY_KEY)
    return
  }
  uni.setStorageSync(TEST_DIFFICULTY_KEY, clampLevel(level))
}

export function defaultDifficultyForAge(age: number): number {
  return clampLevel(age - 4)
}

function readStates(): DifficultyState[] {
  const value = uni.getStorageSync(DIFFICULTY_KEY)
  if (value == null || value == '') return [] as DifficultyState[]
  const states = JSON.parse<DifficultyState[]>(JSON.stringify(value))
  return states == null ? [] as DifficultyState[] : states
}

function saveStates(states: DifficultyState[]) {
  uni.setStorageSync(DIFFICULTY_KEY, states)
}

function ensureState(gameId: string): DifficultyState {
  const states = readStates()
  const found = states.find((item: DifficultyState): boolean => item.gameId == gameId)
  if (found != null) return found
  const profile = getProfile()
  const state = {
    gameId: gameId,
    level: defaultDifficultyForAge(profile == null ? 8 : profile.age),
    lastLowPairKey: '',
    updatedAt: Date.now()
  } as DifficultyState
  states.push(state)
  saveStates(states)
  return state
}

function replaceState(state: DifficultyState) {
  const states = readStates()
  const index = states.findIndex((item: DifficultyState): boolean => item.gameId == state.gameId)
  if (index < 0) states.push(state)
  else states[index] = state
  saveStates(states)
}

function closedDayPeaks(gameId: string, level: number, records: TrainingRecord[], todayKey: string): DailyPeak[] {
  const peaks = [] as DailyPeak[]
  for (let i = 0; i < records.length; i++) {
    const record = records[i]
    if (record.gameId != gameId || record.difficultyLevel == null || record.difficultyLevel != level) continue
    const dayKey = getLocalDayKey(record.completedAt)
    if (dayKey == todayKey) continue
    const existing = peaks.find((item: DailyPeak): boolean => item.dayKey == dayKey)
    if (existing == null) peaks.push({ dayKey: dayKey, peak: record.score })
    else if (record.score > existing.peak) existing.peak = record.score
  }
  peaks.sort((left: DailyPeak, right: DailyPeak): number => left.dayKey < right.dayKey ? -1 : left.dayKey > right.dayKey ? 1 : 0)
  return peaks
}

export function getGameDifficulty(gameId: string): number {
  const testLevel = getTestDifficultyOverride()
  if (testLevel > 0) return testLevel
  const state = ensureState(gameId)
  const previousLevel = state.level
  let shouldSave = false
  const peaks = closedDayPeaks(gameId, state.level, getRecords(), getLocalDayKey(Date.now()))
  if (peaks.length >= 2) {
    const first = peaks[peaks.length - 2]
    const second = peaks[peaks.length - 1]
    const pairKey = state.level.toString() + ':' + first.dayKey + ':' + second.dayKey
    if (first.peak < LOW_SCORE && second.peak < LOW_SCORE && pairKey != state.lastLowPairKey) {
      state.lastLowPairKey = pairKey
      shouldSave = true
      if (state.level > 1) state.level -= 1
    }
  }
  if (state.level != previousLevel || shouldSave) {
    state.updatedAt = Date.now()
    replaceState(state)
  }
  return clampLevel(state.level)
}

export function getGameTuningAge(gameId: string): number {
  const level = getGameDifficulty(gameId)
  return level + 4
}

export function getDifficultyLabel(level: number): string {
  const normalized = clampLevel(level)
  if (normalized <= 2) return '难度 ' + normalized.toString() + ' · 轻松'
  if (normalized <= 5) return '难度 ' + normalized.toString() + ' · 成长'
  if (normalized <= 8) return '难度 ' + normalized.toString() + ' · 进阶'
  return '难度 ' + normalized.toString() + ' · 挑战'
}

export function updateGameDifficulty(gameId: string, playedLevel: number, score: number, completedAt: number, records: TrainingRecord[]): DifficultyUpdate {
  const testLevel = getTestDifficultyOverride()
  if (testLevel > 0) {
    return {
      previousLevel: testLevel,
      currentLevel: testLevel,
      change: 0,
      message: '测试模式已锁定难度 ' + testLevel.toString()
    }
  }
  const state = ensureState(gameId)
  const previousLevel = clampLevel(state.level)
  let message = '继续保持当前难度'

  if (playedLevel == previousLevel && score >= UPGRADE_SCORE) {
    if (previousLevel < MAX_DIFFICULTY) state.level = previousLevel + 1
    state.lastLowPairKey = ''
    message = previousLevel < MAX_DIFFICULTY ? '表现达标，下次进入难度 ' + state.level.toString() : '已达到最高难度，继续保持'
  } else {
    const peaks = closedDayPeaks(gameId, previousLevel, records, getLocalDayKey(completedAt))
    if (peaks.length >= 2) {
      const first = peaks[peaks.length - 2]
      const second = peaks[peaks.length - 1]
      const pairKey = previousLevel.toString() + ':' + first.dayKey + ':' + second.dayKey
      if (first.peak < LOW_SCORE && second.peak < LOW_SCORE && pairKey != state.lastLowPairKey) {
        state.lastLowPairKey = pairKey
        if (previousLevel > 1) {
          state.level = previousLevel - 1
          message = '最近两个训练日的最高分偏低，下次调整为难度 ' + state.level.toString()
        }
      }
    }
  }

  state.level = clampLevel(state.level)
  state.updatedAt = completedAt
  replaceState(state)
  return {
    previousLevel: previousLevel,
    currentLevel: state.level,
    change: state.level - previousLevel,
    message: message
  }
}
