const PLANETS: MemorySearchGroup = {
  id: 'sky-planets',
  tier: 1,
  ids: ['gold-ring', 'gold-purple-ring', 'gold-crater', 'gold-bands', 'amber-ring', 'lemon-ring', 'peach-ring', 'orange-crater', 'blue-ring', 'teal-crater', 'violet-bands', 'pink-ring', 'earth', 'mint-cloud', 'red-lava', 'ice-blue', 'indigo-moons', 'lavender-ring', 'green-dots', 'silver-crater'],
  names: ['金环星球', '紫金星球', '金色星球', '条纹星球', '琥珀星球', '柠檬星球', '蜜桃星球', '橙色星球', '蓝色星球', '青色星球', '紫色星球', '粉色星球', '地球', '薄荷星球', '火星', '冰蓝星球', '双月星球', '薰衣草星球', '绿点星球', '银色星球']
}

// 10 档阶梯：难度由「棋盘图片总数（= 找全所需轮数）+ 记忆展示时长 + 单目标目标时间 + 误点预算」共同决定。
// 单目标目标时间复用 utils/game-scoring.uts 里 memory-search 的 6500 → 4000ms 分档。
const LEVEL_BOARD = [6, 6, 8, 8, 9, 10, 12, 12, 15, 16]
// 棋盘固定 4 列（2026-09-18 用户要求）：列数不再随难度变化，格子才能保持足够大；
// 难度仍由棋盘规模 / 记忆时长 / 单目标时间 / 误点预算承担（难度指标不含 columns）。
const LEVEL_COLUMNS = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4]
const LEVEL_PREVIEW_MS = [2200, 2000, 1800, 1700, 1500, 1400, 1300, 1200, 1100, 1000]
// 全游戏共享的误点预算：累计误点达到该值即结束。
const LEVEL_MAX_ERRORS = [8, 8, 7, 7, 6, 6, 5, 5, 4, 4]

export const TRIAL_ROUNDS = 2
export const TRIAL_BOARD_SIZE = 4
export const TRIAL_COLUMNS = 4
export const TRIAL_PREVIEW_MS = 2400

function clampLevel(level: number): number {
  return Math.max(1, Math.min(10, Math.round(level)))
}

export function memorySearchLevelConfig(level: number): MemorySearchLevelConfig {
  const index = clampLevel(level) - 1
  return {
    level: index + 1,
    boardSize: LEVEL_BOARD[index],
    columns: LEVEL_COLUMNS[index],
    previewMs: LEVEL_PREVIEW_MS[index],
    perTargetMs: searchTargetMs('memory-search', index + 1),
    maxErrors: LEVEL_MAX_ERRORS[index]
  }
}

// 试玩配置：4 张图片、2 轮即可，用第 1 档的宽松参数，且不计入正式成绩。
export function memorySearchTrialConfig(): MemorySearchLevelConfig {
  const base = memorySearchLevelConfig(1)
  return {
    level: 1,
    boardSize: TRIAL_BOARD_SIZE,
    columns: TRIAL_COLUMNS,
    previewMs: TRIAL_PREVIEW_MS,
    perTargetMs: base.perTargetMs,
    maxErrors: base.maxErrors
  }
}

// 难度指标：只由本档参数算出，用于回归断言严格递增。
export function memorySearchDifficultyIndex(level: number): number {
  const config = memorySearchLevelConfig(level)
  return config.boardSize * 100 - (config.previewMs + config.perTargetMs) / 10 - config.maxErrors * 5
}

// 找全整张棋盘所需的总点击数：1 + 2 + … + boardSize。
export function memorySearchTotalFinds(boardSize: number): number {
  const size = Math.max(0, Math.round(boardSize))
  return size * (size + 1) / 2
}

// 单张基础分：把满分平均摊到找全所需的每一次点击上。
export function memorySearchFindBase(boardSize: number): number {
  const total = memorySearchTotalFinds(boardSize)
  if (total <= 0) return 0
  return gameScoreMax('memory-search') / total
}

// 每点对一张的得分：比目标时间快就多给，单张封顶 2 倍基础分；最慢也保底 1 分（鼓励继续找）。
export function memorySearchFindScore(findElapsedMs: number, perTargetMs: number, base: number): number {
  if (!Number.isFinite(base) || base <= 0) return 0
  if (!Number.isFinite(perTargetMs) || perTargetMs <= 0) return Math.max(1, Math.floor(base))
  const elapsed = Number.isFinite(findElapsedMs) && findElapsedMs > 1 ? findElapsedMs : 1
  const raw = Math.round(base * perTargetMs / elapsed)
  const cap = Math.max(1, Math.floor(base * 2))
  return Math.max(1, Math.min(cap, raw))
}

// 一局分数：累计每张的得分，封顶满分（超过即提前收工）。
export function memorySearchGameScore(findScores: number[]): number {
  let total = 0
  for (let i = 0; i < findScores.length; i++) {
    const value = findScores[i]
    if (Number.isFinite(value) && value > 0) total += value
  }
  return Math.min(gameScoreMax('memory-search'), Math.floor(total))
}

function tierOf(level: number): number {
  return level <= 3 ? 1 : level <= 6 ? 2 : 3
}

function pushGroup(pool: MemorySearchAsset[], group: MemorySearchGroup, planets: boolean) {
  for (let i = 0; i < group.ids.length; i++) {
    const id = group.id + ':' + group.ids[i]
    if (planets) {
      pool.push({ id: id, name: group.names[i], kind: 'planet', path: PLANET_BASE + group.ids[i] + '.webp', shadowPath: '' })
    } else {
      pool.push({ id: id, name: group.names[i], kind: 'illustration', path: ILLUSTRATION_BASE + group.id + '/' + group.ids[i] + '.webp', shadowPath: ILLUSTRATION_BASE + group.id + '/' + group.ids[i] + '-shadow.webp' })
    }
  }
}

const POOL_CACHE: MemorySearchAsset[][] = [[], [], [], []]

// 本档可用的素材池；缓存按档位复用，避免每轮重新拼装。
export function memorySearchPool(level: number): MemorySearchAsset[] {
  const tier = tierOf(clampLevel(level))
  if (POOL_CACHE[tier].length > 0) return POOL_CACHE[tier]
  const pool = [] as MemorySearchAsset[]
  for (let i = 0; i < GROUPS.length; i++) {
    if (GROUPS[i].tier <= tier) pushGroup(pool, GROUPS[i], false)
  }
  pushGroup(pool, PLANETS, true)
  POOL_CACHE[tier] = pool
  return pool
}

function shuffled<T>(items: T[], rand: () => number): T[] {
  const copy = items.slice()
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1))
    const tmp = copy[i]
    copy[i] = copy[j]
    copy[j] = tmp
  }
  return copy
}

// 棋盘与目标一律使用彩色图：本游戏不上影子图。
export function memorySearchTile(asset: MemorySearchAsset): MemorySearchTile {
  return {
    id: asset.id,
    name: asset.name,
    path: asset.path,
    isShadow: false,
    isPlanet: asset.kind == 'planet'
  }
}

// 从本档素材池里随机取 size 张互不相同的图片作为本局固定棋盘。
function buildBoard(config: MemorySearchLevelConfig, rand: () => number): MemorySearchTile[] {
  const pool = shuffled(memorySearchPool(config.level), rand)
  const tiles = [] as MemorySearchTile[]
  for (let i = 0; i < pool.length && tiles.length < config.boardSize; i++) {
    tiles.push(memorySearchTile(pool[i]))
  }
  return tiles
}

// 一轮 = 重排后的整张棋盘 + 当前累加目标集合。棋盘集合整局不变，只有顺序变。
function buildRound(config: MemorySearchLevelConfig, index: number, targets: MemorySearchTile[], board: MemorySearchTile[], rand: () => number): MemorySearchRound {
  return {
    index: index,
    tiles: shuffled(board, rand),
    targets: targets.slice(),
    boardSize: config.boardSize,
    columns: config.columns,
    previewMs: config.previewMs,
    targetBudgetMs: config.perTargetMs * targets.length
  }
}

export function generateMemorySearchBoard(level: number, rand: () => number): MemorySearchTile[] {
  return buildBoard(memorySearchLevelConfig(level), rand)
}

// 正式训练：固定棋盘 + 随机目标出场序。第 k 轮（从 1 计）找该顺序的前 k 张，
// 因此第 boardSize 轮正好覆盖整张棋盘 —— 打完就是「找全了」。
export function generateMemorySearchRounds(level: number, rand: () => number): MemorySearchRound[] {
  const config = memorySearchLevelConfig(level)
  const board = buildBoard(config, rand)
  const order = shuffled(board, rand)
  const rounds = [] as MemorySearchRound[]
  for (let k = 0; k < order.length; k++) {
    const targets = [] as MemorySearchTile[]
    for (let i = 0; i <= k; i++) targets.push(order[i])
    rounds.push(buildRound(config, k, targets, board, rand))
  }
  return rounds
}

// 试玩：4 张图片、2 轮，同样随机、非影子、不计分。
export function generateMemorySearchTrial(rand: () => number): MemorySearchRound[] {
  const config = memorySearchTrialConfig()
  const board = buildBoard(config, rand)
  const order = shuffled(board, rand)
  const rounds = [] as MemorySearchRound[]
  for (let k = 0; k < TRIAL_ROUNDS; k++) {
    const targets = [] as MemorySearchTile[]
    for (let i = 0; i <= k && i < order.length; i++) targets.push(order[i])
    rounds.push(buildRound(config, k, targets, board, rand))
  }
  return rounds
}
