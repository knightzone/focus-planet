// 记忆与搜索（memory-search）关卡参数与出题：无尽累加的记忆 + 搜索规则。
// 设计记录见 docs/MEMORY_SEARCH.md。难度阶梯、素材池与计分口径集中在本文件，页面只负责流程与交互。
//
// 规则要点：
// 1) 固定棋盘：每局开局选定 boardSize 张互不相同的图片作为棋盘，整局不变，每轮只重排位置。
//    目标出场序是棋盘的一个随机排列，第 k 轮（从 1 计）要找该顺序的前 k 张 —— 目标完全随机生成。
// 2) 零影子图：棋盘与目标只用彩色素材（shadow-match 彩图 + sky-planets 星球），不使用任何影子图。
// 3) 无尽累加：找齐本轮目标即自动进入下一轮（目标 +1），直到任一结束条件成立：
//    a. 失败：累计误点达到本档 maxErrors；
//    b. 满分：累计局分达到满分上限（提前收工）；
//    c. 找全了：完成 boardSize 轮 —— 此时棋盘上每张图都当过目标并被找到。
// 4) 累计计分：F = boardSize ×(boardSize+1)/ 2 是找全所需的总点击数，base = 满分 / F。
//    每点对一张按速度给分（越快越高，单张封顶 2 倍 base，最慢也有 1 分），局分 = 各项之和，上限满分。
//    因此打得快可以中途攒满满分收工，打得稳可以一路走到「找全了」。图片总数随难度增加。

import { gameScoreMax, searchTargetMs } from './game-scoring.uts'

export type MemorySearchAsset = {
  id: string,
  name: string,
  kind: string,
  path: string,
  // 影子版素材仍保留在池定义里，但本游戏只使用彩色图（见 memorySearchTile）。
  shadowPath: string
}

export type MemorySearchTile = {
  id: string,
  name: string,
  path: string,
  isShadow: boolean,
  isPlanet: boolean
}

export type MemorySearchLevelConfig = {
  level: number,
  boardSize: number,
  columns: number,
  previewMs: number,
  perTargetMs: number,
  maxErrors: number
}

export type MemorySearchRound = {
  index: number,
  tiles: MemorySearchTile[],
  targets: MemorySearchTile[],
  boardSize: number,
  columns: number,
  previewMs: number,
  targetBudgetMs: number
}

type MemorySearchGroup = {
  id: string,
  tier: number,
  ids: string[],
  names: string[]
}

const ILLUSTRATION_BASE = '/static/images/runtime/illustrations/shadow-match/'
const PLANET_BASE = '/static/images/runtime/sky-planets/'

