import { LOCAL_TEST_MODE } from './local-test.uts'
import { API_BASE_URL, getPlatformName } from './api-client.uts'

// Set by release channel, never inferred from the device manufacturer.
export function updateChannel(): string { return getPlatformName() == 'ios' ? 'appstore' : 'android_official' }
export const UPDATE_PAGE = 'pages/update/update'
// v2：服务端契约改为 POST /config（startup config），缓存结构随之升级，旧 v1 缓存自动弃用。
const CACHE_KEY = 'focus_update_policy_v2'
let policy: UTSJSONObject | null = null
let checking = false
let initialized = false
let foreground = false
let presenting = false
let companionBusy = false
let lastCheck = 0
let lastAttempt = 0
let watchTimer = 0

export function installedVersionName(): string {
  const raw = uni.getAppBaseInfo().appVersion
  return raw == null ? '' : raw
}
export function validUpdateLink(url: string, platform: string): boolean {
  // Official Android distribution needs a production domain added here before publishing.
  const hosts = platform == 'ios' ? ['apps.apple.com'] : ['appgallery.huawei.com', 'app.mi.com', 'sj.qq.com']
  if (!url.startsWith('https://')) return false
  const host = url.substring(8).split('/')[0].toLowerCase()
  return hosts.indexOf(host) >= 0
}
function modeOf(update: UTSJSONObject): string {
  if (update['forceUpdate'] == true) return 'force'
  if (update['optionalUpdate'] == true) return 'optional'
  return 'none'
}
// 服务端在 data.update 里直接给出结论（forceUpdate/optionalUpdate 已含最低版本比较），客户端不再自行比较版本号。
export function updateMode(value: UTSJSONObject | null): string {
  if (value == null) return 'none'
  const update = value['update']
  if (update == null || typeof update != 'object') return 'none'
  return modeOf(update as UTSJSONObject)
}
// 暂存降级链接：服务端 versionPolicy 未配置或配置了非法 updateUrl 时兜底使用，
// 保证强更/提示更新逻辑始终可用；服务端 app_config.json 配上真实链接（尤其安卓渠道）后自动优先生效。
const FALLBACK_UPDATE_URL: UTSJSONObject = {
  'ios': 'https://apps.apple.com/cn/app/id6808091213',
  'android': 'https://sj.qq.com/appdetail/com.zhuanzhuapp.mate'
}

function resolveUpdateUrl(update: UTSJSONObject, platform: string): string {
  const link = update['updateUrl']
  if (typeof link == 'string' && validUpdateLink(link, platform)) return link as string
  const fallback = FALLBACK_UPDATE_URL[platform]
  return fallback == null ? '' : fallback as string
}
// 响应校验：update 块结构完整、回显的 currentVersion 与本机一致；需要提示时用降级链接兜底更新地址。
function validPolicy(value: UTSJSONObject, platform: string, currentVersion: string): boolean {
  const update = value['update']
  if (update == null || typeof update != 'object') return false
  const block = update as UTSJSONObject
  const latest = block['latestVersion']
  const link = block['updateUrl']
  const notes = block['releaseNotes']
  if (typeof block['forceUpdate'] != 'boolean' || typeof block['optionalUpdate'] != 'boolean') return false
  if (typeof latest != 'string' || typeof link != 'string' || typeof notes != 'string') return false
  if (block['currentVersion'] != currentVersion) return false
  if (modeOf(block) != 'none') {
    const resolved = resolveUpdateUrl(block, platform)
    if (resolved == '') return false
    block['updateUrl'] = resolved
  }
  return true
}
export function currentUpdate(): UTSJSONObject | null { return policy }
function skipKey(value: UTSJSONObject): string {
  const update = value['update'] as UTSJSONObject
  return 'focus_update_skip_' + getPlatformName() + '_' + updateChannel() + '_' + (update['latestVersion'] as string)
}
export function dismissUpdate() {
  if (policy == null) return
  uni.setStorageSync(skipKey(policy!), Date.now())
}
export function updateRequired(): boolean { return !LOCAL_TEST_MODE && updateMode(policy) == 'force' }
export function setCompanionUpdateBusy(value: boolean) { companionBusy = value }
function currentRoute(): string {
  const pages = getCurrentPages()
  return pages.length == 0 ? '' : pages[pages.length - 1].route
}
function safeToPresent(): boolean {
  const route = currentRoute()
  return foreground && route != '' && !route.startsWith('pages/game/') && !companionBusy && route != 'pages/login/login' && route != 'pages/account/account' && route != 'pages/parent-lock/parent-lock'
}
export function enforceUpdate(): boolean {
  if (!updateRequired()) return false
  if (currentRoute() != UPDATE_PAGE && !presenting) {
    presenting = true
    uni.reLaunch({ url: '/' + UPDATE_PAGE, complete: () => { presenting = false } })
  }
  return true
}
function presentUpdate(manual: boolean = false) {
  if (!safeToPresent() || presenting) return
  if (updateRequired()) { enforceUpdate(); return }
  if (currentRoute() == UPDATE_PAGE) { uni.$emit('focus-update-changed'); return }
  if (updateMode(policy) != 'optional') return
  const value = policy!
  const key = skipKey(value)
  const skipped = uni.getStorageSync(key)
  if (!manual && skipped != null && skipped != '' && Date.now() - (skipped as number) < 24 * 60 * 60 * 1000) return
  presenting = true
  const update = value['update'] as UTSJSONObject
  uni.showModal({
    title: '星伴有新版本啦', content: '发现 ' + (update['latestVersion'] as string) + '，请家长帮忙更新一下。',
    confirmText: '查看更新', cancelText: '稍后再说',
    success: (result) => {
      if (result.confirm) uni.navigateTo({ url: '/' + UPDATE_PAGE })
      else uni.setStorageSync(key, Date.now())
    }, complete: () => { presenting = false }
  })
}
export function checkAppUpdate(manual: boolean = false) {
  if (LOCAL_TEST_MODE) return
  const platform = getPlatformName()
  if (platform != 'ios' && platform != 'android') return
  if (checking) return
  if (!manual && (Date.now() - lastCheck < 6 * 60 * 60 * 1000 || Date.now() - lastAttempt < 60000)) { presentUpdate(); return }
  const version = installedVersionName()
  if (version == '') return
  checking = true
  let accepted = false
  lastAttempt = Date.now()
  uni.$emit('focus-update-checking', true)
  // 启动配置接口：匿名、5 秒超时、不带 Token；版本结论由服务端按 platform/appVersion 计算。
  uni.request({ url: API_BASE_URL + '/config', method: 'POST', timeout: 5000,
    header: { 'Content-Type': 'application/json' },
    data: { platform: platform, appVersion: version },
    success: (result) => {
      if (result.statusCode != 200) return
      const envelope = JSON.parse<UTSJSONObject>(JSON.stringify(result.data))
      if (envelope == null || !Object.keys(envelope).includes('data')) return
      const raw = envelope['data']
      if (raw == null) { policy = null; uni.removeStorageSync(CACHE_KEY) }
      else {
        const next = JSON.parse<UTSJSONObject>(JSON.stringify(raw))
        if (next == null || !validPolicy(next, platform, version)) return
        policy = next
        uni.setStorageSync(CACHE_KEY, next)
      }
      accepted = true
      lastCheck = Date.now()
      uni.$emit('focus-update-changed')
      if (manual && updateMode(policy) == 'none' && currentRoute() != UPDATE_PAGE) uni.showToast({ title: '已经是最新版本', icon: 'none' })
      presentUpdate(manual)
    }, fail: () => {},
    complete: () => {
      checking = false
      uni.$emit('focus-update-checking', false)
      if (manual && !accepted) uni.showToast({ title: '暂时无法检查，请稍后再试', icon: 'none' })
    }
  })
}
export function initializeAppUpdate() {
  if (LOCAL_TEST_MODE) return
  if (initialized) return
  initialized = true
  const raw = uni.getStorageSync(CACHE_KEY)
  if (raw != null && raw != '') {
    const saved = JSON.parse<UTSJSONObject>(JSON.stringify(raw))
    // 缓存策略仅在结构完整且对应本机当前版本时恢复；App 升级后回显版本不一致，自动作废。
    if (saved != null && validPolicy(saved, getPlatformName(), installedVersionName())) policy = saved
  }
  uni.$on('focus-app-update-required', () => checkAppUpdate(true))
  const routes = ['navigateTo', 'redirectTo', 'reLaunch', 'switchTab']
  for (let i = 0; i < routes.length; i++) {
    uni.addInterceptor(routes[i], {
      invoke: (options: UTSJSONObject): boolean => {
        if (!updateRequired()) return true
        const url = options['url']
        if (typeof url == 'string' && url.startsWith('/' + UPDATE_PAGE)) return true
        // Results persist in result onLoad; let the active round finish saving.
        if (typeof url == 'string' && url.startsWith('/pages/result/result') && currentRoute().startsWith('pages/game/')) return true
        setTimeout(() => enforceUpdate(), 0)
        return false
      }
    })
  }
}
export function resumeAppUpdate() {
  if (LOCAL_TEST_MODE) return
  foreground = true
  if (watchTimer == 0) watchTimer = setInterval(() => presentUpdate(), 1000)
  setTimeout(() => checkAppUpdate(currentRoute() == UPDATE_PAGE), 400)
}
export function pauseAppUpdate() { foreground = false; if (watchTimer != 0) clearInterval(watchTimer); watchTimer = 0 }
