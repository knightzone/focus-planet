import { LOCAL_TEST_MODE, localTestKey } from './local-test.uts'
import { calculateAge } from './profile-options.uts'
import { getGameDimensionId } from './catalog.uts'

export type ChildProfile = {
  nickname: string,
  age: number,
  birthYear: number,
  birthMonth: number,
  gender: string,
  avatarId: string,
  nicknameCustomized: boolean,
  createdAt: number,
  serverId?: string
}

export type TrainingRecord = {
  id: string,
  gameId: string,
  dimensionId: string,
  score: number,
  scoreAlgorithmVersion?: string,
  difficultyLevel?: number,
  accuracy: number,
  averageReaction: number,
  durationSeconds?: number,
  omissions?: number,
  falseAlarms?: number,
  switchErrors?: number,
  interferenceErrors?: number,
  completedCount?: number,
  totalCount?: number,
  completedAt: number,
  lessonNo?: number,
  slotNo?: number,
  localSyncId?: string,
  // 兼容已安装测试版本留下的旧本地字段；轻量成绩接口从不接收该字段。
  submissionId?: string,
  lessonSyncPending?: boolean
}

const PROFILE_KEY = localTestKey('focus_planet_profile')
const RECORDS_KEY = 'focus_planet_records'
function accountRecordsKey(): string {
  if (LOCAL_TEST_MODE) return RECORDS_KEY + '_local_test'
  const raw = uni.getStorageSync('focus_planet_auth_session')
  if (raw == null || raw == '') return RECORDS_KEY + '_guest'
  const session = JSON.parse<UTSJSONObject>(JSON.stringify(raw))!
  return RECORDS_KEY + '_' + (session['userId'] as string)
}
const SCHEMA_KEY = 'focus_planet_schema_version'
const CURRENT_SCHEMA_VERSION = 2

function ensureSchema() {
  if (LOCAL_TEST_MODE) return
  const versionValue = uni.getStorageSync(SCHEMA_KEY)
  const version = versionValue == null || versionValue == '' ? 1 : versionValue as number
  if (version < 2) {
    const oldRecords = uni.getStorageSync(RECORDS_KEY)
    if (oldRecords != null && oldRecords != '') {
      const records = JSON.parse<TrainingRecord[]>(JSON.stringify(oldRecords))
      if (records != null) {
        for (let i = 0; i < records.length; i++) {
          if (records[i].durationSeconds == null) records[i].durationSeconds = 0
        }
        uni.setStorageSync(RECORDS_KEY, records)
      }
    }
    uni.setStorageSync(SCHEMA_KEY, CURRENT_SCHEMA_VERSION)
  }
}

export function getProfile(): ChildProfile | null {
  const value = uni.getStorageSync(PROFILE_KEY)
  if (value == null || value == '') return null
  const profile = JSON.parse<ChildProfile>(JSON.stringify(value))
  if (profile == null) return null
  profile.age = calculateAge(profile.birthYear, profile.birthMonth)
  return profile
}

export function saveProfile(profile: ChildProfile) {
  uni.setStorageSync(PROFILE_KEY, profile)
}

export function getRecords(): TrainingRecord[] {
  ensureSchema()
  const value = uni.getStorageSync(accountRecordsKey())
  if (value == null || value == '') return [] as TrainingRecord[]
  // iOS 原生存储对自定义类型数组的可选字段还原不稳定；新数据统一保存为 JSON 字符串。
  // 读取时仍兼容旧版本直接存入的数组。
  const records = typeof value == 'string' ? JSON.parse<TrainingRecord[]>(value as string) : JSON.parse<TrainingRecord[]>(JSON.stringify(value))
  return records == null ? [] as TrainingRecord[] : records
}

export function addRecord(record: TrainingRecord) {
  const category = getGameDimensionId(record.gameId)
  if (category != '') record.dimensionId = category
  const records = getRecords()
  // 同一课同一游戏只有一条本地最佳成绩；再次训练较低分不增加记录数。
  const existingIndex = record.lessonNo == null ? -1 : records.findIndex((item: TrainingRecord): boolean => item.lessonNo == record.lessonNo && item.gameId == record.gameId)
  if (existingIndex >= 0) {
    if (record.score > records[existingIndex].score) records[existingIndex] = record
  } else records.unshift(record)
  saveRecords(records)
  const stored = getRecords().find((item: TrainingRecord): boolean => item.lessonNo == record.lessonNo && item.gameId == record.gameId)
  console.log('[lesson-sync] storage write game=' + record.gameId + ' lesson=' + (record.lessonNo == null ? 'missing' : record.lessonNo!.toString()) + ' replaced=' + (existingIndex >= 0 && stored != null && stored!.id == record.id).toString() + ' restoredLesson=' + (stored == null || stored!.lessonNo == null ? 'missing' : stored!.lessonNo!.toString()) + ' records=' + records.length.toString())
}

export function saveRecords(records: TrainingRecord[]) {
  uni.setStorageSync(accountRecordsKey(), JSON.stringify(records))
}

export function markLessonRecordSynced(localSyncId: string) {
  if (localSyncId == '') return
  const records = getRecords()
  const record = records.find((item: TrainingRecord): boolean => item.localSyncId == localSyncId)
  if (record == null) return
  record!.lessonSyncPending = false
  saveRecords(records)
}

export function clearTrainingRecords() {
  uni.removeStorageSync(accountRecordsKey())
  uni.removeStorageSync(localTestKey('focus_planet_difficulty_states'))
}

export function getLocalDayKey(timestamp: number): string {
  const date = new Date(timestamp)
  const month = (date.getMonth() + 1).toString().padStart(2, '0')
  const day = date.getDate().toString().padStart(2, '0')
  return date.getFullYear().toString() + '-' + month + '-' + day
}

export function formatRecordDate(timestamp: number): string {
  const date = new Date(timestamp)
  return (date.getMonth() + 1).toString() + '月' + date.getDate().toString() + '日 ' +
    date.getHours().toString().padStart(2, '0') + ':' + date.getMinutes().toString().padStart(2, '0')
}

export function getWeeklyRecords(records: TrainingRecord[]): TrainingRecord[] {
  const now = new Date()
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
  const firstDay = today - 6 * 24 * 60 * 60 * 1000
  return records.filter((item: TrainingRecord): boolean => item.completedAt >= firstDay)
}

export function calculateStreak(records: TrainingRecord[]): number {
  if (records.length == 0) return 0
  const uniqueDays = [] as number[]
  for (let i = 0; i < records.length; i++) {
    const date = new Date(records[i].completedAt)
    const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime()
    if (uniqueDays.indexOf(dayStart) < 0) uniqueDays.push(dayStart)
  }
  uniqueDays.sort((a: number, b: number): number => b - a)
  const now = new Date()
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
  const oneDay = 24 * 60 * 60 * 1000
  if (uniqueDays[0] < today - oneDay) return 0
  let streak = 1
  for (let i = 1; i < uniqueDays.length; i++) {
    if (Math.round((uniqueDays[i - 1] - uniqueDays[i]) / oneDay) == 1) streak += 1
    else break
  }
  return streak
}
