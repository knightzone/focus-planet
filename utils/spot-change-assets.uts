export function spotChangePool(level: number, round: number, seed: number): string[] {
  // Every three rounds includes one planet round; other rounds rotate illustration sets.
  if ((round + seed) % 3 == 2) {
    if (level <= 6) return [0, 9, 10, 12, 14, 15].map((i: number): string => skyPlanetSources[i])
    return skyPlanetSources.slice()
  }
  const groups = level <= 3 ? CHANGE_LOW_GROUPS : level <= 6 ? CHANGE_LOW_GROUPS.concat(CHANGE_MID_GROUPS) : CHANGE_LOW_GROUPS.concat(CHANGE_MID_GROUPS).concat(CHANGE_HIGH_GROUPS)
  return groups[(round + seed) % groups.length].slice()
}
export function spotChangeBoard(pool: string[], cells: number): string[] {
  const deck = pool.slice()
  for (let i = deck.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const item = deck[i]; deck[i] = deck[j]; deck[j] = item }
  const board: string[] = []
  for (let i = 0; i < cells; i++) board.push(deck[i % deck.length])
  for (let i = board.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const item = board[i]; board[i] = board[j]; board[j] = item }
  return board
}
