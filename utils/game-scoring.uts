export const SCORE_VERSION = 'goal-v2'
// 明确衡量速度或尝试效率的任务可获得超额分；声音辨识、呼吸、固定流程不奖励抢快。
export function gameScoreMax(gameId: string): number {
  // dual-track（上天入海）起始分 150、最高就是 150，必须走 200 档，否则 0—150 的口径会被夹成 100。
  return ['star-catcher','number-tap','shape-match','forest-search','spot-change','symbol-detective','memory-search','memory-link','order-guess','spot-difference','puzzle','color-command','magic-rule','number-track','sorting-station','dual-track'].indexOf(gameId) >= 0 ? 200 : 100
}
export function timedRoundScore(success: boolean, elapsedMs: number, targetMs: number, mistakes: number = 0): number {
  if (!success || !Number.isFinite(elapsedMs) || !Number.isFinite(targetMs) || elapsedMs <= 0 || targetMs <= 0) return 0
  return Math.max(0, Math.min(200, 100 * targetMs / elapsedMs / (1 + Math.max(0, mistakes))))
}
export function averageRoundScore(scores: number[], maximum: number = 200): number {
  if (scores.length == 0) return 0
  let total = 0
  scores.forEach((score: number) => { if (Number.isFinite(score)) total += Math.max(0, Math.min(maximum, score)) })
  // 不把99.9四舍五入为过关；每轮先封顶，再等权平均。
  return Math.floor(total / scores.length + 0.000001)
}
export function scoreQuery(scores: number[]): string {
  return '&scoreVersion=' + SCORE_VERSION + '&roundScores=' + scores.map((s: number): string => (Math.round(s * 10000) / 10000).toString()).join(',')
}
export function parseRoundScores(raw: string): number[] {
  if (raw == '') return [] as number[]
  const values = raw.split(','); if (values.length > 300) return [] as number[]
  return values.map((value: string): number => { const parsed = parseFloat(value); return Number.isFinite(parsed) ? Math.max(0, Math.min(200, parsed)) : 0 })
}
// 以下是首版产品目标值，单位毫秒，须结合实机反馈校准。
export function searchTargetMs(gameId: string, level: number): number {
  const i = Math.max(0, Math.min(9, level - 1))
  if (gameId == 'forest-search') return [5000,4800,4600,4400,4200,4000,3800,3600,3400,3200][i]
  if (gameId == 'symbol-detective' || gameId == 'memory-search') return [6500,6200,6000,5700,5400,5100,4800,4500,4200,4000][i]
  return [4000,3800,3600,3400,3200,3000,2800,2600,2400,2200][i]
}
