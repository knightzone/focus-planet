// 双轨任务（重做：上天入海）：纯逻辑层。
//
// 画面被中线分成上下两半：
//   - 上半（天空）：蓝兔跃跃开火箭，躲避迎面而来的小星球；
//   - 下半（大海）：黄猫暖暖开潜艇，躲避游过来的各种鱼。
// 两个载具都**只能上下移动，且不能越过中线**：每一半纵向切成 3 个停靠位，点哪一格就飞到哪一格。
// 难度只体现在**障碍物密度**（生成间隔越来越短），障碍物速度全档一致；
// 一局时长 1—2 分钟（随难度变长）；起始分数 150 → 100（越难起步越低），每次碰撞扣 10 分，最低 0 分。
//
// 逻辑与渲染分离：这里负责出题（障碍物、生成节奏）、位移、碰撞与计分；页面负责画背景、载具与障碍物。

export type DualTrackConfig = {
  level: number,
  durationMs: number,
  spawnGapMs: number,
  speedPxPerSec: number,
  startScore: number,
  collisionPenalty: number,
  slots: number,
  demo: boolean
}

export type DualTrackObstacle = {
  id: string,
  half: string,
  path: string,
  x: number,
  y: number,
  size: number,
  hit: boolean
}

export type DualTrackState = {
  config: DualTrackConfig,
  width: number,
  height: number,
  elapsedMs: number,
  sinceSpawnMs: number,
  nextHalf: string,
  skySlot: number,
  seaSlot: number,
  skyY: number,
  seaY: number,
  obstacles: DualTrackObstacle[],
  nextId: number,
  collisions: number,
  hitsSky: number,
  hitsSea: number,
  phase: string
}

export type DualTrackEvent = { kind: string, half: string, obstacleId: string, detail: string }

export const SKY_HALF = 'sky'
export const SEA_HALF = 'sea'
export const DUAL_TRACK_SLOTS = 3
// 障碍物速度全档一致（难度只靠密度），横向像素/秒。
export const OBSTACLE_SPEED = 128

const PLANETS = [
  'amber-ring', 'blue-ring', 'earth', 'gold-bands', 'gold-crater', 'gold-purple-ring', 'gold-ring', 'green-dots',
  'ice-blue', 'indigo-moons', 'lavender-ring', 'lemon-ring', 'mint-cloud', 'orange-crater', 'peach-ring',
  'pink-ring', 'red-lava', 'silver-crater', 'teal-crater', 'violet-bands'
]
const SEA_CREATURES = ['angelfish', 'clownfish-smile', 'manta-ray', 'pufferfish', 'seahorse', 'shark', 'swordfish', 'tuna']

// 时长 60s → 120s；密度（生成间隔）1100ms → 380ms；起始分 150 → 100。
const LEVEL_DURATION_MS = [60000, 60000, 70000, 70000, 80000, 90000, 100000, 110000, 120000, 120000]
// 密度（生成间隔）整体降一档：每档用原来上一档的间隔，最松一档再加长到 1200ms。
const LEVEL_SPAWN_GAP_MS = [1200, 1100, 1000, 900, 800, 720, 640, 560, 490, 430]
const LEVEL_START_SCORE = [150, 144, 139, 133, 128, 122, 117, 111, 106, 100]

// 背景与载具素材（2026-09-18 换成正式素材）：整屏背景上下两半 = 天空 / 大海；
// 跃跃开火箭、暖暖开潜艇都是 4:3 的整张插画，朝右（迎面来的障碍物从右侧进入）。
export const SCENE_PATH = '/static/images/runtime/backgrounds/dual-track-sky-sea-v1.webp'
export const ROCKET_PATH = '/static/images/runtime/dual-track/yueyue-rocket-4x3.webp'
export const SUBMARINE_PATH = '/static/images/runtime/dual-track/nuannuan-submarine-4x3.webp'

export function dualTrackConfig(level: number): DualTrackConfig {
  const index = Math.max(0, Math.min(9, Math.round(level) - 1))
  return {
    level: index + 1,
    durationMs: LEVEL_DURATION_MS[index],
    spawnGapMs: LEVEL_SPAWN_GAP_MS[index],
    speedPxPerSec: OBSTACLE_SPEED,
    startScore: LEVEL_START_SCORE[index],
    collisionPenalty: 10,
    slots: DUAL_TRACK_SLOTS,
    demo: false
  }
}

// 试玩：15 秒、稀疏障碍、不计分，看懂「上下躲 + 不能过中线」就够了。
export function dualTrackDemoConfig(): DualTrackConfig {
  return {
    level: 1,
    durationMs: 15000,
    spawnGapMs: 1500,
    speedPxPerSec: OBSTACLE_SPEED,
    startScore: 0,
    collisionPenalty: 0,
    slots: DUAL_TRACK_SLOTS,
    demo: true
  }
}

export function obstaclePath(half: string, id: string): string {
  if (half == SKY_HALF) return '/static/images/runtime/sky-planets/' + id + '.webp'
  return '/static/images/runtime/illustrations/shadow-match/hard-sea/' + id + '.webp'
}

export function obstacleIds(half: string): string[] {
  return half == SKY_HALF ? PLANETS : SEA_CREATURES
}

export function vehicleSize(height: number): number {
  return Math.max(40, Math.min(62, Math.round(height * 0.1)))
}

export function obstacleSize(height: number): number {
  return Math.max(26, Math.min(48, Math.round(height * 0.072)))
}

// 每一半的可用纵向范围：上不过中线、下不出画。
export function halfRange(height: number, half: string): { top: number, bottom: number } {
  const size = vehicleSize(height)
  const margin = size / 2 + 6
  if (half == SKY_HALF) return { top: margin, bottom: height / 2 - margin }
  return { top: height / 2 + margin, bottom: height - margin }
}

// 第 slot 个停靠位的中心 y（0 在上、slots-1 在下）。
export function slotCenterY(height: number, half: string, slot: number): number {
  const range = halfRange(height, half)
  const count = DUAL_TRACK_SLOTS
  const index = Math.max(0, Math.min(count - 1, Math.round(slot)))
  const step = (range.bottom - range.top) / Math.max(1, count - 1)
  return range.top + step * index
}

// 载具停靠位对应的格子（用于点击区域反查）：给出 y 属于哪一格。
export function slotOfY(height: number, half: string, y: number): number {
  const range = halfRange(height, half)
  const count = DUAL_TRACK_SLOTS
  const step = (range.bottom - range.top) / Math.max(1, count - 1)
  if (step <= 0) return 0
  return Math.max(0, Math.min(count - 1, Math.round((y - range.top) / step)))
}

// 每一半「相邻两个停靠位之间的距离」，拖动时用它当判据（不需要绝对坐标）。
export function slotStep(height: number, half: string): number {
  const range = halfRange(height, half)
  return Math.abs(range.bottom - range.top) / Math.max(1, DUAL_TRACK_SLOTS - 1)
}

// 拖动位移 → 目标停靠位：向下拖 dy>0 就往下挪，阈值是 0.6 格；返回新的 slot（已夹在本半内）。
export function dualTrackDraggedSlot(height: number, half: string, slot: number, dy: number): number {
  const threshold = slotStep(height, half) * 0.6
  if (threshold <= 0 || Math.abs(dy) < threshold) return slot
  const moved = slot + (dy > 0 ? 1 : -1)
  return Math.max(0, Math.min(DUAL_TRACK_SLOTS - 1, moved))
}

export function halfOfY(height: number, y: number): string {
  return y < height / 2 ? SKY_HALF : SEA_HALF
}

export function vehicleY(state: DualTrackState, half: string): number {
  return half == SKY_HALF ? state.skyY : state.seaY
}

// 点到某一格：载具向该格滑过去（滑行在页面按帧推进，逻辑只记录目标格）。
export function dualTrackMoveTo(state: DualTrackState, half: string, slot: number): boolean {
  if (state.phase != 'running') return false
  const index = Math.max(0, Math.min(state.config.slots - 1, Math.round(slot)))
  if (half == SKY_HALF) {
    if (state.skySlot == index) return false
    state.skySlot = index
    return true
  }
  if (state.seaSlot == index) return false
  state.seaSlot = index
  return true
}

// 载具按帧滑向目标格（每毫秒移动的像素比例），保持「只能上下移动」。
export function dualTrackGlide(state: DualTrackState, dtMs: number) {
  const speed = vehicleSize(state.height) * dtMs / 150
  const skyTarget = slotCenterY(state.height, SKY_HALF, state.skySlot)
  const seaTarget = slotCenterY(state.height, SEA_HALF, state.seaSlot)
  const skyDelta = skyTarget - state.skyY
  const seaDelta = seaTarget - state.seaY
  state.skyY += Math.abs(skyDelta) <= speed ? skyDelta : skyDelta > 0 ? speed : -speed
  state.seaY += Math.abs(seaDelta) <= speed ? seaDelta : seaDelta > 0 ? speed : -speed
}

function pickIndex(length: number, rand: () => number): number {
  if (length <= 0) return 0
  return Math.max(0, Math.min(length - 1, Math.floor(rand() * length)))
}

// 生成一个障碍物：横坐标从右侧进入，纵向落在本半屏的可用范围内。
export function dualTrackSpawn(state: DualTrackState, half: string, rand: () => number): DualTrackEvent {
  const ids = obstacleIds(half)
  const id = ids[pickIndex(ids.length, rand)]
  const size = obstacleSize(state.height)
  const range = halfRange(state.height, half)
  const top = range.top
  const bottom = Math.max(range.top, range.bottom)
  const y = top + rand() * (bottom - top)
  state.nextId += 1
  state.obstacles.push({
    id: 'o' + state.nextId.toString(),
    half: half,
    path: obstaclePath(half, id),
    x: state.width + size / 2,
    y: y,
    size: size,
    hit: false
  })
  return { kind: 'spawn', half: half, obstacleId: state.nextId.toString(), detail: id }
}

// 碰撞判定：横向重叠 + 纵向重叠（纵向稍微放宽，对孩子更友好）。
export function dualTrackOverlaps(state: DualTrackState, obstacle: DualTrackObstacle): boolean {
  const vehicle = vehicleSize(state.height)
  const x = state.width * 0.28
  const dx = Math.abs(obstacle.x - x)
  const dy = Math.abs(obstacle.y - vehicleY(state, obstacle.half))
  return dx < (obstacle.size + vehicle) * 0.42 && dy < (obstacle.size + vehicle) * 0.38
}

export function dualTrackCreate(config: DualTrackConfig, width: number, height: number, rand: () => number): DualTrackState {
  const state: DualTrackState = {
    config: config,
    width: Math.max(80, width),
    height: Math.max(160, height),
    elapsedMs: 0,
    sinceSpawnMs: 0,
    nextHalf: SKY_HALF,
    skySlot: 1,
    seaSlot: 1,
    skyY: 0,
    seaY: 0,
    obstacles: [] as DualTrackObstacle[],
    nextId: 0,
    collisions: 0,
    hitsSky: 0,
    hitsSea: 0,
    phase: 'running'
  }
  state.skyY = slotCenterY(state.height, SKY_HALF, state.skySlot)
  state.seaY = slotCenterY(state.height, SEA_HALF, state.seaSlot)
  // 开局先各放一个，两个任务马上都有事做。
  dualTrackSpawn(state, SKY_HALF, rand)
  dualTrackSpawn(state, SEA_HALF, rand)
  state.sinceSpawnMs = 0
  return state
}

// 推进 dtMs：障碍物匀速左移、按密度补位、判碰撞、计时结束。
export function dualTrackStep(state: DualTrackState, dtMs: number, rand: () => number): DualTrackEvent[] {
  const events = [] as DualTrackEvent[]
  if (state.phase != 'running') return events
  const ms = Math.max(0, dtMs)
  state.elapsedMs += ms
  dualTrackGlide(state, ms)
  const speed = state.config.speedPxPerSec
  for (let i = 0; i < state.obstacles.length; i++) {
    const obstacle = state.obstacles[i]
    obstacle.x -= speed * ms / 1000
    if (!obstacle.hit && dualTrackOverlaps(state, obstacle)) {
      obstacle.hit = true
      state.collisions += 1
      if (obstacle.half == SKY_HALF) state.hitsSky += 1
      else state.hitsSea += 1
      events.push({ kind: 'hit', half: obstacle.half, obstacleId: obstacle.id, detail: obstacle.path })
    }
  }
  state.obstacles = state.obstacles.filter((item: DualTrackObstacle): boolean => item.x + item.size / 2 > 0)
  state.sinceSpawnMs += ms
  if (state.sinceSpawnMs >= state.config.spawnGapMs) {
    state.sinceSpawnMs = 0
    events.push(dualTrackSpawn(state, state.nextHalf, rand))
    state.nextHalf = state.nextHalf == SKY_HALF ? SEA_HALF : SKY_HALF
  }
  if (state.elapsedMs >= state.config.durationMs) {
    state.phase = 'done'
    events.push({ kind: 'finished', half: '', obstacleId: '', detail: '' })
  }
  return events
}

// 一局得分：起始分 − 每次碰撞 10 分，最低 0 分。
export function dualTrackScore(state: DualTrackState): number {
  const raw = state.config.startScore - state.collisions * state.config.collisionPenalty
  return Math.max(0, raw)
}

export function dualTrackProgress(state: DualTrackState): number {
  const total = state.config.durationMs
  return total <= 0 ? 1 : Math.max(0, Math.min(1, state.elapsedMs / total))
}

export function dualTrackFinished(state: DualTrackState): boolean {
  return state.phase == 'done'
}

export function dualTrackRemainingMs(state: DualTrackState): number {
  return Math.max(0, state.config.durationMs - state.elapsedMs)
}
