import { averageRoundScore, gameScoreMax } from './game-scoring.uts'
export type PerformanceInput = {
  gameId: string,
  roundScores?: number[],
  rawScore?: number,
  accuracy: number,
  reaction: number,
  duration: number,
  completed: number,
  total: number,
  omissions: number,
  falseAlarms: number,
  switchErrors: number,
  interferenceErrors: number
}

export type PerformanceEvaluation = {
  score: number,
  accuracyScore: number,
  timeScore: number,
  completionScore: number,
  controlScore: number,
  feedback: string
}


export function evaluatePerformance(input: PerformanceInput): PerformanceEvaluation {
  const accuracy = Math.max(0, Math.min(100, input.accuracy))
  const scores = input.roundScores
  const raw = input.rawScore == null ? accuracy : input.rawScore
  const fallback = Number.isFinite(raw) ? Math.max(0, Math.min(100, raw)) : 0
  const score = scores != null && scores.length > 0 ? averageRoundScore(scores, gameScoreMax(input.gameId)) : Math.floor(fallback)
  const completion = input.total <= 0 ? accuracy : Math.max(0, Math.min(100, input.completed / input.total * 100))
  return { score, accuracyScore: accuracy, timeScore: 0, completionScore: completion, controlScore: accuracy,
    feedback: score >= 100 ? (score > 100 ? '超过本级目标，过关啦！' : '达到本级目标，过关啦！') : '继续练习，平均达到100分就能过关。' }
}
