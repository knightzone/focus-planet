import { TrainingGame, GAMES, getGameName, getGameThumbnail, getGameDimensionId } from './catalog.uts'
import { TrainingRecord, getLocalDayKey } from './storage.uts'
import { getGameDifficulty } from './difficulty.uts'
import { ClientLesson, lessonRole } from './course-plan.uts'

export type DailyPlanItem = {
  role: string,
  gameId: string,
  name: string,
  dimensionId: string,
  thumbnail: string,
  difficultyLevel: number,
  completed: boolean,
  serverGameId?: string,
  planId?: string,
  itemId?: string,
  playToken?: string,
  planRevision?: number,
  lessonNo?: number,
  slotNo?: number
}

export function buildClientLessonPlan(lesson: ClientLesson): DailyPlanItem[] {
  const result = [] as DailyPlanItem[]
  for (let i = 0; i < lesson.items.length; i++) {
    const item = lesson.items[i]
    result.push({
      role: lessonRole(item.slotNo),
      gameId: item.gameId,
      name: item.name,
      dimensionId: item.dimensionId,
      thumbnail: item.thumbnail,
      difficultyLevel: item.difficultyLevel,
      completed: item.completed,
      lessonNo: item.lessonNo,
      slotNo: item.slotNo
    })
  }
  return result
}

const PLAN_DIMENSIONS = ['selective', 'focused', 'sustained', 'alternating', 'divided']
const PLAN_ROLES = ['观察', '记忆', '反应', '逻辑', '兼顾']

function findDimensionGame(dimensionId: string, start: number): TrainingGame {
  const pool = GAMES.filter((item: TrainingGame): boolean => item.dimensionId == dimensionId && item.status == 'ready')
  if (pool.length > 0) {
    return pool[start % pool.length]
  }
  return GAMES[0]
}

export function buildDailyPlan(_age: number, records: TrainingRecord[], timestamp: number): DailyPlanItem[] {
  const dayKey = getLocalDayKey(timestamp)
  const date = new Date(timestamp)
  const seed = date.getFullYear() * 400 + (date.getMonth() + 1) * 32 + date.getDate()
  const selected = [] as TrainingGame[]
  for (let i = 0; i < PLAN_DIMENSIONS.length; i++) {
    selected.push(findDimensionGame(PLAN_DIMENSIONS[i], seed + i * 3))
  }
  const todayGameIds = records
    .filter((record: TrainingRecord): boolean => getLocalDayKey(record.completedAt) == dayKey)
    .map((record: TrainingRecord): string => record.gameId)
  const result = [] as DailyPlanItem[]
  for (let i = 0; i < selected.length; i++) {
    result.push({
      role: PLAN_ROLES[i],
      gameId: selected[i].id,
      name: getGameName(selected[i].id),
      dimensionId: selected[i].dimensionId,
      thumbnail: getGameThumbnail(selected[i].id),
      difficultyLevel: getGameDifficulty(selected[i].id),
      completed: todayGameIds.indexOf(selected[i].id) >= 0
    })
  }
  return result
}

export function nextPendingPlanItem(plan: DailyPlanItem[]): DailyPlanItem | null {
  const item = plan.find((entry: DailyPlanItem): boolean => !entry.completed)
  return item == null ? null : item
}

function clientGameId(serverGameId: string): string {
  const aliases: UTSJSONObject = {
    'shadow-match': 'shape-match', 'light-tracker': 'light-tracking', 'star-watch': 'sky-watcher',
    'change-detection': 'spot-change', 'forest-treasure': 'forest-search', 'character-detective': 'symbol-detective',
    'red-green-command': 'red-green', 'odd-even-track': 'number-track', 'dual-track-task': 'dual-track',
    'dual-task-driver': 'little-driver', 'sound-picture-match': 'listen-find'
  }
  const value = aliases[serverGameId]
  return value == null ? serverGameId : value as string
}

function roleName(role: string): string {
  if (role == 'warmup') return '热身'
  if (role == 'core') return '核心'
  if (role == 'reinforce') return '巩固'
  if (role == 'challenge') return '挑战'
  return '轻松结束'
}

export function buildServerPlan(plan: UTSJSONObject): DailyPlanItem[] {
  const planId = plan['planId'] as string
  const revision = plan['revision'] as number
  const rawItems = plan['items']
  if (rawItems == null) return [] as DailyPlanItem[]
  const items = JSON.parse<UTSJSONObject[]>(JSON.stringify(rawItems))!
  const result = [] as DailyPlanItem[]
  for (let i = 0; i < items.length; i++) {
    const item = items[i]
    const serverId = item['gameId'] as string
    const gameId = clientGameId(serverId)
    result.push({
      role: roleName(item['role'] as string),
      gameId: gameId,
      serverGameId: serverId,
      name: getGameName(gameId),
      dimensionId: getGameDimensionId(gameId),
      thumbnail: getGameThumbnail(gameId),
      difficultyLevel: item['difficultyLevel'] as number,
      completed: item['status'] as string == 'COMPLETED',
      planId: planId,
      itemId: item['itemId'] as string,
      playToken: item['playToken'] as string,
      planRevision: revision
    })
  }
  if (result.length >= 5) return result.slice(0, 5)
  const fallback = buildDailyPlan(8, [] as TrainingRecord[], Date.now())
  for (let i = 0; i < fallback.length && result.length < 5; i++) {
    const exists = result.find((entry: DailyPlanItem): boolean => entry.dimensionId == fallback[i].dimensionId)
    if (exists == null) result.push(fallback[i])
  }
  return result
}
