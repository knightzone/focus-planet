export type BreathingConfig = { cycles: number, toleranceMs: number, guidedCycles: number }
// 一轮 3 秒扩张 + 4 秒收缩 + 1 秒反馈，页面时间轴与判定共用这三个常量。
export const BREATHING_INHALE_MS = 3000
export const BREATHING_EXHALE_MS = 4000
export const BREATHING_FEEDBACK_MS = 1000
// 松手容错挂在「呼气提示音」上，而不是挂在 3 秒这个瞬间上：
// 提示音就是指令，孩子听到「呼气」才松手。旧口径把 ±容差 套在 3 秒瞬间上，
// 结果指令开始前就给了 1–1.5s，指令读完后只剩 0.15–0.9s，前后明显不一致，
// 孩子自然提前松手（而按下侧的窗口 [0, 容差] 在指令前根本没有容错）。
// 现在改成：以提示音片段为中心，总宽度仍等于该档容差，两边等量——
//   窗口 = [3s − slack, 3s + 提示音时长 + slack]，slack = (容差 − 提示音时长) / 2。
export const BREATHING_RELEASE_CUE_MS = 600
export type BreathingReleaseWindow = { min: number, max: number, target: number }
export function breathingReleaseWindow(tolerance: number): BreathingReleaseWindow {
  const cue = BREATHING_RELEASE_CUE_MS
  const safe = Number.isFinite(tolerance) ? Math.max(0, tolerance) : 0
  const slack = Math.max(0, (safe - cue) / 2)
  return {
    min: BREATHING_INHALE_MS - slack,
    max: BREATHING_INHALE_MS + cue + slack,
    // 理想松手点从「3 秒瞬间」改成提示音中点：人听到指令到动手本来就有反应时间。
    target: BREATHING_INHALE_MS + cue / 2
  }
}
export function getBreathingConfig(level: number): BreathingConfig {
  const i = Math.max(0, Math.min(9, Math.round(level) - 1))
  return { cycles: [8,9,10,12,14,15,15,15,18,20][i], toleranceMs: [1500,1400,1300,1200,1100,1000,1000,950,850,750][i], guidedCycles: [8,9,10,12,14,15,5,3,3,2][i] }
}
// 只评价触屏节奏；各档统一3秒扩张、4秒收缩、1秒反馈，不设置憋气阶段。
export function breathingCycleQuality(pressedAt: number, releasedAt: number, tolerance: number): number {
  if (pressedAt < 0 || releasedAt < 0 || releasedAt - pressedAt < 300) return 0
  const release = breathingReleaseWindow(tolerance)
  if (pressedAt <= tolerance && releasedAt - pressedAt >= 1200 && releasedAt >= release.min && releasedAt <= release.max) return 2
  return 1
}
