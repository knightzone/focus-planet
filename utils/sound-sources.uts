] as SoundObject[]

export function soundChoiceCount(level: number): number { return [2,2,3,3,4,4,4,5,5,6][Math.max(0,Math.min(9,level-1))] }
export function shuffledSounds(items: SoundObject[]): SoundObject[] {
  const result = items.slice()
  for (let i = result.length-1; i > 0; i--) { const j = Math.floor(Math.random()*(i+1)); const value = result[i]; result[i]=result[j]; result[j]=value }
  return result
}
export function soundPool(level: number): SoundObject[] {
  if (level >= 4) return soundObjects.slice()
  return soundObjects.filter((o: SoundObject): boolean => ['cat','dog','cow','duck','bird','car','drum','piano'].includes(o.id))
}
export function soundChoices(target: SoundObject, level: number): SoundObject[] {
  const pool = shuffledSounds(soundPool(level).filter((o: SoundObject): boolean => o.id != target.id))
  const count = soundChoiceCount(level)
  const similar = [0,0,0,1,1,2,3,3,4,5][Math.max(0,Math.min(9,level-1))]
  const chosen = [target] as SoundObject[]
  const same = pool.filter((o: SoundObject): boolean => o.group == target.group)
  for (let i=0;i<Math.min(similar,same.length);i++) chosen.push(same[i])
  const rest = pool.filter((o: SoundObject): boolean => !chosen.some((c: SoundObject): boolean => c.id==o.id))
  // At entry levels prioritize very different sound sources.
  const ordered = level<=3 ? rest.filter((o: SoundObject): boolean => o.group!=target.group).concat(rest.filter((o: SoundObject): boolean => o.group==target.group)) : rest
  for (let i=0;chosen.length<count && i<ordered.length;i++) chosen.push(ordered[i])
  return shuffledSounds(chosen)
}

