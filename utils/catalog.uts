export type AgeBand = {
  id: string,
  label: string,
  min: number,
  max: number,
  sessionMinutes: number
}

export type TrainingGame = {
  id: string,
  dimensionId: string,
  name: string,
  summary: string,
  status: string
}

export type FocusDimension = {
  id: string,
  name: string,
  shortName: string,
  color: string,
  description: string,
  thumbnail: string
}

