  { id: 'starter', label: '启蒙模式', min: 3, max: 6, sessionMinutes: 5 },
  { id: 'growth', label: '成长模式', min: 7, max: 9, sessionMinutes: 10 },
  { id: 'advanced', label: '进阶模式', min: 10, max: 12, sessionMinutes: 15 },
  { id: 'teen', label: '青少年模式', min: 13, max: 16, sessionMinutes: 25 }
]

