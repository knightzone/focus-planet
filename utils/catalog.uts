export function getAgeBand(age: number): AgeBand {
  for (let i = 0; i < AGE_BANDS.length; i++) {
    if (age >= AGE_BANDS[i].min && age <= AGE_BANDS[i].max) return AGE_BANDS[i]
  }
  return AGE_BANDS[0]
}

export function gamesForDimension(dimensionId: string): TrainingGame[] {
  return GAMES.filter((game: TrainingGame): boolean => game.dimensionId == dimensionId)
}

export function getGameName(gameId: string): string {
  const game = GAMES.find((item: TrainingGame): boolean => item.id == gameId)
  return game == null ? '专注训练' : game.name
}

export function getGameThumbnail(gameId: string): string {
  return '/static/images/runtime/level-thumbnails/' + gameId + '.webp'
}

export function getGameRoute(gameId: string): string {
  if (gameId == 'spot-change' || gameId == 'symbol-detective' || gameId == 'memory-search') {
    return '/pages/game/grid-challenge?gameId=' + gameId
  }
  if (gameId == 'light-tracking' || gameId == 'little-driver') {
    return '/pages/game/motion-challenge?gameId=' + gameId
  }
  return '/pages/game/' + gameId
}
