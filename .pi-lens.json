{
  "$schema": "https://raw.githubusercontent.com/apmantza/pi-lens/master/docs/schema/pi-lens-config-v1.json",
  "format": {
    "enabled": false
  },
  "autofix": {
    "enabled": false
  },
  "ignore": [
    "unpackage/**",
    "ios/SDK/**",
    "ios/.derived/**",
    "ios/CustomFrameworks/**",
    "ios/Plugins/**",
    "uni_modules/*/utssdk/app-ios/*.swift",
    "uni_modules/*/utssdk/app-ios/**/*.swift",
    "ios/FocusPlanet/FocusPlanet/uni-app-x/apps/**",
    "outputs/**",
    "content/ai-assets/archive/**",
    "backend/**/node_modules/**"
  ],
  "rules": {
    "project-policy": {
      "disable": [
        "no-reserved-identifiers"
      ]
    }
  }
}
